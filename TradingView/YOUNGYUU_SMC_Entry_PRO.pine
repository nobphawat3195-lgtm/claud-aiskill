showFvg    = input.bool(true, "Show FVG", inline = "fvg", group = G_ST)
fvgMinAtr  = input.float(0.15, "min ATR×", step = 0.05, inline = "fvg", group = G_ST)
fvgMax     = input.int(8, "Max FVG Boxes", minval = 1, group = G_ST)

G_Z        = "🧱 SUPPLY / DEMAND ZONES"

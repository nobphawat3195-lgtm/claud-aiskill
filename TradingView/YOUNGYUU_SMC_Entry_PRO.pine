//@version=6
// ══════════════════════════════════════════════════════════════════
//  YOUNGYUU SMC ENTRY PRO  v1.0
//  Liquidity Sweep → CHoCH/BOS → Limit @ Order Block → TP1..TP5
//  • MTF SMC Matrix (BOS / CHoCH / Sweep / FVG / Bias)
//  • Full order lifecycle: PENDING → FILLED → TP ladder → CLOSED
//    (MISSED / EXPIRED / INVALID / REPLACED are NOT counted as trades)
//  • Spread-aware fills (chart = Bid, Buy fills on Ask)
//  • Honest R accounting: Partial / Max TP / All-at-final
//  • Confluence grade A+..C · Stats by period · Max DD · Streak · PF
//  NON-REPAINT : all logic commits on bar close
// ══════════════════════════════════════════════════════════════════
indicator("YOUNGYUU SMC Entry PRO", shorttitle = "YY_SMC_PRO", overlay = true,
     max_labels_count = 500, max_lines_count = 500, max_boxes_count = 500, max_bars_back = 500)

// ══════════════════════════════════════
// 🎨 THEME  (Obsidian Gold · Neon Cyber · Light Pro)
// ══════════════════════════════════════
G_TH    = "🎨 THEME"
themeIn = input.string("Obsidian Gold", "HUD Theme", options = ["Obsidian Gold", "Neon Cyber", "Light Pro"], group = G_TH)
lang    = input.string("ไทย", "ภาษา / Language", options = ["ไทย", "English"], group = G_TH, tooltip = "ภาษาของคำแนะนำ 👉 ทำอะไรตอนนี้, ป้าย TP และ Alert แบบข้อความ")
f_tx(string th, string en) => lang == "ไทย" ? th : en
isNeon  = themeIn == "Neon Cyber"
isLight = themeIn == "Light Pro"

C_UP   = isLight ? #08795a : isNeon ? #00f0b5 : #19d3a2
C_DN   = isLight ? #c4213f : isNeon ? #ff3d81 : #ff5c7a
C_ACC  = isLight ? #f0b90b : isNeon ? #a48bff : #f5c542      // fills / header
C_GOLD = isLight ? #8a6400 : isNeon ? #ffd66b : #f5c542      // highlighted text
C_INK  = isLight ? #1a1405 : isNeon ? #0b0820 : #1a1405      // text on accent
C_ONUP = isLight ? #ffffff : isNeon ? #00140f : #04130e      // text on up fill
C_TXT  = isLight ? #111827 : isNeon ? #eef1ff : #e8ecf4
C_MUTE = isLight ? #566072 : isNeon ? #9aa0d0 : #8a94ab
C_WARN = isLight ? #b45309 : #ffb020
C_BLUE = isLight ? #1f5fd1 : isNeon ? #2ee6ff : #5b9cff
C_NAVY = isNeon ? #1d2350 : #1b2a4a
C_BG   = isLight ? #f6f7fb : isNeon ? #05060d : #0a0e17
C_SEC  = isLight ? #ffffff : isNeon ? #0c0f1f : #111726
C_GRID = isLight ? #e2e6ef : isNeon ? #262d5c : #1f2a40
C_OFF  = isLight ? #e3e7ef : isNeon ? #1d2350 : #273149
C_NONE = color.new(color.black, 100)


// ══════════════════════════════════════
// 🧱 TYPES & STATE
// ══════════════════════════════════════
type Setup
    int          dir
    int          state   = 1      // 1 pending · 2 running · 3 closed · 4 cancelled
    int          born
    int          fillBar = na
    float        limitPx
    float        earlyPx
    float        entry
    float        slInit
    float        sl
    float        risk
    int          nTp
    array<float> tps
    int          tpHit   = 0
    float        rReal   = 0.0
    float        remW    = 1.0
    float        rFinal  = na
    int          score
    string       grade
    string       flags
    string       result  = "PENDING"
    string       capNote = ""
    string       capName = ""
    float        capPx   = na
    bool         warned  = false
    int          fillT   = na
    int          bornT   = na
    array<float> cutTps
    line         wallL
    label        wallLb
    box          bxRisk
    box          bxProf
    line         earlyL
    label        earLb
    label        limLb
    label        slLb
    label        tagLb
    label        rLb
    array<line>  tpL
    array<label> tpLb

var Setup         cur         = na
var array<Setup>  hist        = array.new<Setup>()
var array<int>    stT         = array.new<int>()
var array<float>  stR         = array.new<float>()
var array<int>    stW         = array.new<int>()
var array<int>    stG         = array.new<int>()      // confluence score per closed trade
var array<int>    stE         = array.new<int>()      // fill time
var array<int>    stD         = array.new<int>()      // direction
var array<string> stRes       = array.new<string>()   // short result text
var array<label>  marks       = array.new<label>()
var int           tradesToday = 0

float        atr   = ta.atr(14)
float        rngHi = ta.highest(high, 100)
float        rngLo = ta.lowest(low, 100)
float        eqLvl = (rngHi + rngLo) / 2
array<float> rArr  = array.from(r1, r2, r3, r4, r5)
bool         inKz  = not na(time(timeframe.period, kzLon, "UTC")) or not na(time(timeframe.period, kzNy, "UTC"))
int          tD    = time("D")
int          tW    = time("W")
int          tM    = time("M")

// ══════════════════════════════════════
// 🔧 HELPERS
// ══════════════════════════════════════
f_px(float x)   => na(x) ? "—" : str.tostring(x, format.mintick)
f_r(float x)    => na(x) ? "—" : (x >= 0 ? "+" : "") + str.tostring(x, "#.##") + "R"
f_grade(int s)  => s >= 6 ? "A+" : s == 5 ? "A" : s == 4 ? "B" : "C"      // score out of 7
f_gv(string g)  => g == "A+" ? 3 : g == "A" ? 2 : g == "B" ? 1 : 0
f_dirTxt(int d) => d > 0 ? "▲" : d < 0 ? "▼" : "·"
f_dirCol(int d) => d > 0 ? C_UP : d < 0 ? C_DN : C_MUTE
f_tfName(string tf) =>
    int sec = timeframe.in_seconds(tf)
    sec < 3600 ? "M" + str.tostring(math.round(sec / 60)) : sec < 86400 ? "H" + str.tostring(math.round(sec / 3600)) : "D" + str.tostring(math.round(sec / 86400))

// spread-aware hit tests (chart = Bid)
f_fill(Setup s)            => s.dir == 1 ? low + spread <= s.entry : high >= s.entry
f_slHit(Setup s)           => s.dir == 1 ? low <= s.sl : high + spread >= s.sl
f_tpHit(Setup s, float tp) => s.dir == 1 ? high >= tp : low + spread <= tp
f_rAt(Setup s, int k)      => (s.tps.get(k - 1) - s.entry) * s.dir / s.risk

// ══════════════════════════════════════
// 🧠 SMC CORE (used for MTF matrix)
// returns last-event direction: BOS, CHoCH, Sweep, FVG, Structure
// ══════════════════════════════════════
f_smc(int len, float fm) =>
    var float sh  = na
    var float sl  = na
    var bool  shB = true
    var bool  slB = true
    var int   sd  = 0
    var int   bos = 0
    var int   ch  = 0
    var int   swp = 0
    var int   fvg = 0
    float a  = ta.atr(14)
    float ph = ta.pivothigh(high, len, len)
    float pl = ta.pivotlow(low, len, len)
    if not na(ph)
        sh  := ph
        shB := false
    if not na(pl)
        sl  := pl
        slB := false
    if not shB and close > sh
        if sd == -1
            ch := 1
        else
            bos := 1
        sd  := 1
        shB := true
    else if not shB and high > sh and close < sh
        swp := -1
    if not slB and close < sl
        if sd == 1
            ch := -1
        else
            bos := -1
        sd  := -1
        slB := true
    else if not slB and low < sl and close > sl
        swp := 1
    if low > high[2] and low - high[2] >= fm * a
        fvg := 1
    if high < low[2] and low[2] - high >= fm * a
        fvg := -1
    [bos, ch, swp, fvg, sd]

f_smcPrev(int len, float fm) =>
    [b, c, s, f, d] = f_smc(len, fm)
    [b[1], c[1], s[1], f[1], d[1]]

[aB, aC, aS, aF, aD] = request.security(syminfo.tickerid, tfA, f_smcPrev(swLen, fvgMinAtr), lookahead = barmerge.lookahead_on)
[bB, bC, bS, bF, bD] = request.security(syminfo.tickerid, tfB, f_smcPrev(swLen, fvgMinAtr), lookahead = barmerge.lookahead_on)
[cB, cC, cS, cF, cD] = request.security(syminfo.tickerid, tfC, f_smcPrev(swLen, fvgMinAtr), lookahead = barmerge.lookahead_on)
int htfDir = nz(aD)

// ══════════════════════════════════════
// 🎨 SETUP DRAWING
// ══════════════════════════════════════
f_pct(Setup s) => math.round(100.0 / s.nTp)
f_bePx(Setup s) => s.entry + s.dir * beLockPts * pointSize
f_isBe(Setup s) => s.sl != s.slInit and math.abs(s.sl - f_bePx(s)) < syminfo.mintick * 2

f_extend(Setup s, int x2) =>
    s.bxRisk.set_right(x2)
    s.bxProf.set_right(x2)
    for l in s.tpL
        l.set_x2(x2)
    for lb in s.tpLb
        lb.set_x(x2)
    s.earlyL.set_x2(x2)
    s.earLb.set_x(x2)
    s.limLb.set_x(x2)
    s.slLb.set_x(x2)
    if not na(s.wallL)
        s.wallL.set_x2(x2)

f_refresh(Setup s) =>
    for i = 0 to s.nTp - 1
        bool hit = s.tpHit > i
        label lb = s.tpLb.get(i)
        bool fin = i == s.nTp - 1
        string act = fin ? f_tx("ปิดหมด", "close all") : f_tx("ปิด ", "close ") + str.tostring(f_pct(s)) + "%" + (beAfter == i + 1 ? f_tx(" + 🛡กันทุน", " + 🛡BE") : "")
        lb.set_text((fin ? "🏁 " : "") + "TP" + str.tostring(i + 1) + (hit ? " ✓" : "") + " · " + act + "  " + f_px(s.tps.get(i)))
        lb.set_color(hit ? color.new(C_UP, 20) : fin ? C_ACC : C_NAVY)
        lb.set_textcolor(hit ? #04130e : fin ? C_INK : color.white)
    s.slLb.set_y(s.sl)
    s.slLb.set_text(s.sl == s.slInit ? "SL " + f_px(s.sl) : f_isBe(s) ? f_tx("🛡 กันทุนแล้ว ", "🛡 BE ") + f_px(s.sl) : f_tx("🔒 ล็อกกำไร ", "🔒 Locked ") + f_px(s.sl))
    s.slLb.set_color(s.sl == s.slInit ? color.new(C_DN, 10) : color.new(C_UP, 15))
    s.slLb.set_textcolor(s.sl == s.slInit ? color.white : #04130e)
    string tag = s.state == 1 ? "⏳ PENDING" : s.state == 2 ? (s.tpHit > 0 ? "▶ TP" + str.tostring(s.tpHit) : "▶ LIVE") : s.result
    color  tc  = s.state == 1 or s.state == 4 ? C_MUTE : s.state == 2 ? C_BLUE : s.tpHit > 0 ? C_UP : C_DN
    s.tagLb.set_text(tag)
    s.tagLb.set_color(tc)

f_draw(Setup s) =>
    int   x1    = s.born
    int   x2    = bar_index + extBars
    float tpEnd = s.tps.get(s.nTp - 1)
    s.bxRisk := box.new(x1, math.max(s.limitPx, s.slInit), x2, math.min(s.limitPx, s.slInit), border_color = color.new(C_DN, 10), bgcolor = color.new(C_DN, 72))
    s.bxProf := box.new(x1, math.max(s.limitPx, tpEnd), x2, math.min(s.limitPx, tpEnd), border_color = color.new(C_UP, 40), bgcolor = color.new(C_UP, 88))
    for k = 0 to s.nTp - 1
        float y = s.tps.get(k)
        s.tpL.push(line.new(x1, y, x2, y, color = color.new(C_UP, 35), style = line.style_dashed))
        s.tpLb.push(label.new(x2, y, "", color = C_NAVY, textcolor = color.white, style = label.style_label_left, size = size.small))
    if not na(s.cutTps) and s.cutTps.size() > 0
        for k = 0 to s.cutTps.size() - 1
            float y = s.cutTps.get(k)
            if true
                s.tpL.push(line.new(x1, y, x2, y, color = color.new(C_MUTE, 75), style = line.style_dotted))
                s.tpLb.push(label.new(x2, y, "TP" + str.tostring(s.nTp + k + 1) + " ✂ " + f_tx("ข้าม · ติด ", "skip · blocked by ") + s.capName, color = C_NONE, textcolor = color.new(C_MUTE, 35), style = label.style_label_left, size = size.small))
    if not na(s.capPx)
        s.wallL  := line.new(x1, s.capPx, x2, s.capPx, color = C_WARN, width = 3)
        s.wallLb := label.new(x1, s.capPx, "🧱 " + s.capName + f_tx("  — อย่าถือเกินเส้นนี้", "  — don't hold past this"), color = C_NONE, textcolor = C_WARN, style = label.style_label_lower_left, size = size.small)
    s.earlyL := line.new(x1, s.earlyPx, x2, s.earlyPx, color = C_GOLD, style = line.style_dashed, width = 2)
    s.earLb  := label.new(x2, s.earlyPx, "Early " + f_px(s.earlyPx), color = C_NONE, textcolor = C_GOLD, style = label.style_label_left, size = size.small)
    s.limLb  := label.new(x2, s.limitPx, (s.dir == 1 ? "Buy Limit " : "Sell Limit ") + f_px(s.limitPx), color = color.new(C_MUTE, 20), textcolor = #0b0f19, style = label.style_label_left, size = size.small)
    s.slLb   := label.new(x2, s.slInit, "", color = color.new(C_DN, 10), textcolor = color.white, style = label.style_label_left, size = size.small)
    s.tagLb  := label.new(x1, s.limitPx, "", color = C_MUTE, textcolor = color.white, style = label.style_label_right, size = size.normal)
    s.rLb    := label.new(x1, s.limitPx + 0.5 * (s.tps.get(0) - s.limitPx),s.grade + " · 1R = $" + str.tostring(math.abs(s.limitPx - s.slInit), "#.##") + (s.capNote != "" ? "\n" + s.capNote : ""), color = C_NONE, textcolor = C_TXT, style = label.style_label_left, size = size.small)
    f_refresh(s)

f_delete(Setup s) =>
    s.bxRisk.delete()
    s.bxProf.delete()
    for l in s.tpL
        l.delete()
    for lb in s.tpLb
        lb.delete()
    s.earlyL.delete()
    s.earLb.delete()
    s.limLb.delete()
    s.slLb.delete()
    s.tagLb.delete()
    s.rLb.delete()
    if not na(s.wallL)
        s.wallL.delete()
        s.wallLb.delete()

f_mark(Setup s) =>
    if showMarks and s.state == 3
        bool win = s.tpHit > 0
        string tip = (s.dir == 1 ? "BUY" : "SELL") + " · " + s.grade + "\nEntry " + f_px(s.entry) + "  SL " + f_px(s.slInit) + "\n" + s.result + "\n" + str.format_time(nz(s.fillT, time), "dd MMM yyyy HH:mm", syminfo.timezone)
        marks.push(label.new(nz(s.bornT, time), s.limitPx, (win ? "✅ " : "🛑 ") + str.replace_all(s.result, "  ", " "), color = color.new(win ? C_UP : C_DN, 75), textcolor = win ? C_UP : C_DN,
             xloc = xloc.bar_time, style = s.dir == 1 ? label.style_label_up : label.style_label_down, size = size.tiny, tooltip = tip))
        if marks.size() > 200
            label.delete(marks.shift())

f_archive(Setup s) =>
    hist.push(s)
    if hist.size() > keepHist
        Setup old = hist.shift()
        f_mark(old)
        f_delete(old)

f_tpRaw(int d, float lim, float risk0) =>
    array<float> tps = array.new<float>()
    for k = 1 to tpCount
        float off = tpMode == "R Multiple" ? rArr.get(k - 1) * risk0 : tpMode == "Fixed $ Step" ? k * fixedStep : k * tpPts * pointSize
        tps.push(lim + d * off)
    tps

f_new(int d, float lim, float slPx, int sc, string flags, array<float> tps, string capNote, string capName, float capPx, array<float> cutTps) =>
    float risk0 = math.abs(lim - slPx)
    float early = lim + d * earlyR * risk0
    float ent   = fillMode == "Early" ? early : lim
    Setup s = Setup.new(dir = d, state = 1, born = bar_index, bornT = time, limitPx = lim, earlyPx = early, entry = ent,
         slInit = slPx, sl = slPx, risk = math.abs(ent - slPx), nTp = tps.size(), tps = tps, score = sc,
         grade = f_grade(sc), flags = flags, capNote = capNote, capName = capName, capPx = capPx, cutTps = cutTps, tpL = array.new<line>(), tpLb = array.new<label>())
    f_draw(s)
    s

f_close(Setup s, float px, string res) =>
    float rr = (px - s.entry) * s.dir / s.risk
    s.rReal += s.remW * rr
    s.remW  := 0.0
    float R = rModel == "Partial (equal split)" ? s.rReal : rModel == "Max TP reached" ? (s.tpHit > 0 ? f_rAt(s, s.tpHit) : rr) : rr
    s.rFinal := R
    s.state  := 3
    s.result := res + "  " + f_r(R)
    stT.push(time)
    stR.push(R)
    stW.push(s.tpHit > 0 ? 1 : 0)
    stG.push(s.score)
    stE.push(nz(s.fillT, time))
    stD.push(s.dir)
    stRes.push(res)
    if stT.size() > 5000
        stT.shift()
        stR.shift()
        stW.shift()
        stG.shift()
        stE.shift()
        stD.shift()
        stRes.shift()
    f_extend(s, bar_index)
    f_refresh(s)
    f_archive(s)
    R

f_cancel(Setup s, string why) =>
    s.state  := 4
    s.result := why
    if showCancelled
        f_extend(s, bar_index)
        s.bxRisk.set_bgcolor(color.new(C_MUTE, 90))
        s.bxRisk.set_border_color(color.new(C_MUTE, 60))
        s.bxProf.set_bgcolor(color.new(C_MUTE, 94))
        s.bxProf.set_border_color(color.new(C_MUTE, 70))
        f_refresh(s)
        f_archive(s)
    else
        f_delete(s)

// Order Block finder: extreme of the leg → last opposite candle → FVG inside leg
f_findOB(int dir, int span) =>
    int   n   = math.min(math.max(span, 2), 150)
    int   k   = 0
    float ext = dir == 1 ? low : high
    for i = 0 to n
        float v = dir == 1 ? low[i] : high[i]
        if (dir == 1 and v < ext) or (dir == -1 and v > ext)
            ext := v
            k   := i
    int j = k
    for i = k to k + 5
        bool opp = dir == 1 ? close[i] < open[i] : close[i] > open[i]
        if opp
            j := i
            break
    bool fvgIn = false
    for i = 0 to math.max(k - 1, 0)
        bool g = dir == 1 ? low[i] > high[i + 2] : high[i] < low[i + 2]
        if g
            fvgIn := true
            break
    [j, ext, fvgIn]

// ══════════════════════════════════════
// 📅 DAILY RESET
// ══════════════════════════════════════
bool newDay = timeframe.change("D")
if barstate.isconfirmed and newDay
    tradesToday := 0

// ══════════════════════════════════════
// 🧱 CHART STRUCTURE ENGINE (with drawings)
// ══════════════════════════════════════
float ph = ta.pivothigh(high, swLen, swLen)
float pl = ta.pivotlow(low, swLen, swLen)

var float shP      = na
var int   shBar    = na
var bool  shBroken = true
var bool  shSwept  = false
var line  shLn     = na
var float slP      = na
var int   slBar    = na
var bool  slBroken = true
var bool  slSwept  = false
var line  slLn     = na
var int   sDir     = 0
var int   bullSwBar = na
var int   bearSwBar = na
var array<line>  stLines = array.new<line>()
var array<label> stLbls  = array.new<label>()

f_keepLine(line l) =>
    stLines.push(l)
    if stLines.size() > 80
        line.delete(stLines.shift())

f_keepLbl(label l) =>
    stLbls.push(l)
    if stLbls.size() > 80
        label.delete(stLbls.shift())

bool bullCH  = false
bool bullBOS = false
bool bearCH  = false
bool bearBOS = false

if barstate.isconfirmed
    // new swings → liquidity lines
    if not na(ph)
        shP      := ph
        shBar    := bar_index - swLen
        shBroken := false
        shSwept  := false
        shLn     := na
        if showLiq or showStruct
            shLn := line.new(shBar, shP, bar_index, shP, color = color.new(C_MUTE, showLiq ? 40 : 100), style = line.style_dashed)
            f_keepLine(shLn)
    if not na(pl)
        slP      := pl
        slBar    := bar_index - swLen
        slBroken := false
        slSwept  := false
        slLn     := na
        if showLiq or showStruct
            slLn := line.new(slBar, slP, bar_index, slP, color = color.new(C_MUTE, showLiq ? 40 : 100), style = line.style_dashed)
            f_keepLine(slLn)
    if not shBroken and not na(shLn)
        shLn.set_x2(bar_index)
    if not slBroken and not na(slLn)
        slLn.set_x2(bar_index)

    // bullish break / sweep of highs
    if not shBroken and not na(shP) and close > shP
        bool isCh = sDir == -1
        bullCH   := isCh
        bullBOS  := not isCh
        sDir     := 1
        shBroken := true
        if showStruct and not na(shLn)
            shLn.set_color(C_UP)
            shLn.set_style(isCh ? line.style_solid : line.style_dotted)
            f_keepLbl(label.new(math.max(math.round((shBar + bar_index) / 2), bar_index - 450), shP, isCh ? "CHoCH" : "BOS", color = C_NONE, textcolor = C_UP, style = label.style_label_down, size = size.tiny))
    else if not shBroken and not shSwept and not na(shP) and high > shP and close < shP
        shSwept   := true
        bearSwBar := bar_index
        if showLiq
            f_keepLbl(label.new(bar_index, high, "Sweep", color = C_NONE, textcolor = C_TXT, style = label.style_label_down, size = size.tiny))

    // bearish break / sweep of lows
    if not slBroken and not na(slP) and close < slP
        bool isCh = sDir == 1
        bearCH   := isCh
        bearBOS  := not isCh
        sDir     := -1
        slBroken := true
        if showStruct and not na(slLn)
            slLn.set_color(C_DN)
            slLn.set_style(isCh ? line.style_solid : line.style_dotted)
            f_keepLbl(label.new(math.max(math.round((slBar + bar_index) / 2), bar_index - 450), slP, isCh ? "CHoCH" : "BOS", color = C_NONE, textcolor = C_DN, style = label.style_label_up, size = size.tiny))
    else if not slBroken and not slSwept and not na(slP) and low < slP and close > slP
        slSwept   := true
        bullSwBar := bar_index
        if showLiq
            f_keepLbl(label.new(bar_index, low, "Sweep", color = C_NONE, textcolor = C_TXT, style = label.style_label_up, size = size.tiny))

bool bullTrig = bullCH or (trigMode == "CHoCH + BOS" and bullBOS)
bool bearTrig = bearCH or (trigMode == "CHoCH + BOS" and bearBOS)

// ── FVG boxes
var array<box> fvgBx = array.new<box>()
var array<int> fvgDr = array.new<int>()
if barstate.isconfirmed and showFvg
    if fvgBx.size() > 0
        for i = fvgBx.size() - 1 to 0
            box b = fvgBx.get(i)
            bool filled = fvgDr.get(i) == 1 ? low <= b.get_bottom() : high >= b.get_top()
            if filled
                b.delete()
                fvgBx.remove(i)
                fvgDr.remove(i)
    if low > high[2] and low - high[2] >= fvgMinAtr * atr
        fvgBx.push(box.new(bar_index - 2, low, bar_index, high[2], border_color = C_NONE, bgcolor = color.new(C_UP, 88), extend = extend.right, text = "FVG", text_color = color.new(C_UP, 40), text_size = size.tiny, text_halign = text.align_right))
        fvgDr.push(1)
    if high < low[2] and low[2] - high >= fvgMinAtr * atr
        fvgBx.push(box.new(bar_index - 2, low[2], bar_index, high, border_color = C_NONE, bgcolor = color.new(C_DN, 88), extend = extend.right, text = "FVG", text_color = color.new(C_DN, 40), text_size = size.tiny, text_halign = text.align_right))
        fvgDr.push(-1)
    if fvgBx.size() > fvgMax
        box.delete(fvgBx.shift())
        fvgDr.shift()

// ══════════════════════════════════════
// 🧱 SUPPLY / DEMAND ZONES  · strength ★1-5
// ★ base · ★ strong departure · ★ FVG in departure · ★ fresh · ★ HTF aligned
// ══════════════════════════════════════
type Zone
    box   bx
    float top
    float bot
    int   dir              // -1 supply · 1 demand
    int   tests  = 0
    bool  fvg    = false
    bool  strong = false

var array<Zone> zones = array.new<Zone>()

f_zStars(Zone z)  => 1 + (z.strong ? 1 : 0) + (z.fvg ? 1 : 0) + (z.tests == 0 ? 1 : 0) + (htfDir == z.dir ? 1 : 0)
f_starTxt(int n)  => str.repeat("★", n) + str.repeat("☆", 5 - n)

f_zPaint(Zone z) =>
    int   st   = f_zStars(z)
    bool  vis  = showZones and st >= (chartDetail == "Clean" ? math.max(zMinStars, 3) : zMinStars)
    color base = z.dir == 1 ? C_UP : C_DN
    z.bx.set_bgcolor(vis ? color.new(base, 94 - st * 5) : C_NONE)
    z.bx.set_border_color(vis ? color.new(base, 70 - st * 8) : C_NONE)
    bool  busy = not na(cur) and z.top >= math.min(cur.sl, cur.limitPx) and z.bot <= math.max(cur.sl, cur.limitPx)
    z.bx.set_text(vis and not busy ? (z.dir == 1 ? "DEMAND  " : "SUPPLY  ") + f_starTxt(st) + (z.tests > 0 ? "  · T" + str.tostring(z.tests) : "  · FRESH") : "")
    z.bx.set_text_color(vis ? color.new(base, 5) : C_NONE)

f_zOverlap(float top, float bot, int dir) =>
    bool hit = false
    for z in zones
        if z.dir == dir and top >= z.bot and bot <= z.top
            hit := true
            break
    hit

f_zTrim(int dir) =>
    int cnt = 0
    for z in zones
        if z.dir == dir
            cnt += 1
    if cnt > zMax
        for i = 0 to zones.size() - 1
            Zone z = zones.get(i)
            if z.dir == dir
                z.bx.delete()
                zones.remove(i)
                break

f_zNear(int dir) =>
    Zone best = na
    for z in zones
        if z.dir == dir and (dir == -1 ? z.top >= close : z.bot <= close)
            if na(best) or (dir == -1 ? z.bot < best.bot : z.top > best.top)
                best := z
    best

float zLowAfter  = ta.lowest(low, swLen)
float zHighAfter = ta.highest(high, swLen)
float zAtrPiv    = atr[swLen]

// 1) update: invalidate / count tests / repaint stars
if barstate.isconfirmed and zones.size() > 0
    for i = zones.size() - 1 to 0
        Zone z = zones.get(i)
        bool broken = z.dir == -1 ? (zBreak == "Close" ? close : high) > z.top : (zBreak == "Close" ? close : low) < z.bot
        if broken
            z.bx.delete()
            zones.remove(i)
        else
            bool touch = z.dir == -1 ? high >= z.bot and high[1] < z.bot : low <= z.top and low[1] > z.top
            if touch
                z.tests += 1
            if zMaxTest > 0 and z.tests > zMaxTest
                z.bx.delete()
                zones.remove(i)
            else
                f_zPaint(z)

// 2) create: supply from pivot high, demand from pivot low
if barstate.isconfirmed and not na(ph) and not na(zAtrPiv)
    float top = ph
    float bot = math.max(open[swLen], close[swLen])
    if top - bot > zMaxAtr * zAtrPiv
        bot := top - zMaxAtr * zAtrPiv
    if top - bot < 0.15 * zAtrPiv
        bot := top - 0.15 * zAtrPiv
    float dep = ph - zLowAfter
    if dep >= zMinDep * zAtrPiv and not f_zOverlap(top, bot, -1)
        bool fv = false
        for i = 0 to swLen - 1
            if high[i] < low[i + 2]
                fv := true
                break
        Zone z = Zone.new(box.new(bar_index - swLen, top, bar_index, bot, extend = extend.right, text_size = size.small, text_halign = text.align_left, text_valign = text.align_center), top, bot, -1, 0, fv, dep >= zStrongDep * zAtrPiv)
        zones.push(z)
        f_zPaint(z)
        f_zTrim(-1)

if barstate.isconfirmed and not na(pl) and not na(zAtrPiv)
    float bot = pl
    float top = math.min(open[swLen], close[swLen])
    if top - bot > zMaxAtr * zAtrPiv
        top := bot + zMaxAtr * zAtrPiv
    if top - bot < 0.15 * zAtrPiv
        top := bot + 0.15 * zAtrPiv
    float dep = zHighAfter - pl
    if dep >= zMinDep * zAtrPiv and not f_zOverlap(top, bot, 1)
        bool fv = false
        for i = 0 to swLen - 1
            if low[i] > high[i + 2]
                fv := true
                break
        Zone z = Zone.new(box.new(bar_index - swLen, top, bar_index, bot, extend = extend.right, text_size = size.small, text_halign = text.align_left, text_valign = text.align_center), top, bot, 1, 0, fv, dep >= zStrongDep * zAtrPiv)
        zones.push(z)
        f_zPaint(z)
        f_zTrim(1)

// ══════════════════════════════════════
// 📍 KEY LEVELS  (PDH/PDL · PWH/PWL · Asia range · Round numbers · HTF POI FVG)
// all values are from CLOSED periods → non-repaint
// ══════════════════════════════════════
[pdh, pdl] = request.security(syminfo.tickerid, "D", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[pwh, pwl] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)

// Asia range — last COMPLETED session
bool inAsia = not na(time(timeframe.period, asiaSess, "UTC"))
var float asRunHi = na
var float asRunLo = na
var float asHi    = na
var float asLo    = na
if inAsia and not inAsia[1]
    asRunHi := high
    asRunLo := low
else if inAsia
    asRunHi := math.max(nz(asRunHi, high), high)
    asRunLo := math.min(nz(asRunLo, low), low)
if not inAsia and inAsia[1]
    asHi := asRunHi
    asLo := asRunLo

// HTF POI: latest un-mitigated bullish / bearish FVG on poiTf
f_poi() =>
    var float bT = na
    var float bB = na
    var float sT = na
    var float sB = na
    if low > high[2]
        bT := low
        bB := high[2]
    if high < low[2]
        sT := low[2]
        sB := high
    if not na(bB) and low < bB
        bT := na
        bB := na
    if not na(sT) and high > sT
        sT := na
        sB := na
    [bT[1], bB[1], sT[1], sB[1]]

[poiBT, poiBB, poiST, poiSB] = request.security(syminfo.tickerid, poiTf, f_poi(), lookahead = barmerge.lookahead_on)

float rnNear = math.round(close / rnStep) * rnStep

// sweep of a key level: extreme pierced the level by ≤ 1 ATR
f_keySwept(float ext, int d) =>
    array<float> ks = array.new<float>()
    if klPD
        ks.push(d == 1 ? pdl : pdh)
    if klPW
        ks.push(d == 1 ? pwl : pwh)
    if klAsia
        ks.push(d == 1 ? asLo : asHi)
    if klRound
        ks.push(math.round(ext / rnStep) * rnStep)
    bool hit = false
    for k in ks
        if not na(k)
            if d == 1 ? (ext <= k + 0.1 * atr and ext >= k - atr) : (ext >= k - 0.1 * atr and ext <= k + atr)
                hit := true
                break
    hit

f_inPoi(float px, int d) =>
    d == 1 ? (not na(poiBB) and px >= poiBB - 0.2 * atr and px <= poiBT + 0.2 * atr) : (not na(poiSB) and px >= poiSB - 0.2 * atr and px <= poiST + 0.2 * atr)

// merged, sorted level list (price · name · color · priority) for drawing + HUD
type KLv
    float  p
    string n
    color  c
    int    pr

f_klList() =>
    array<KLv> raw = array.new<KLv>()
    if klPD
        raw.push(KLv.new(pdh, "PDH", C_BLUE, 1))
        raw.push(KLv.new(pdl, "PDL", C_BLUE, 1))
    if klPW
        raw.push(KLv.new(pwh, "PWH", C_ACC, 0))
        raw.push(KLv.new(pwl, "PWL", C_ACC, 0))
    if klAsia
        raw.push(KLv.new(asHi, "Asia H", C_GOLD, 2))
        raw.push(KLv.new(asLo, "Asia L", C_GOLD, 2))
    if klRound
        float base = math.floor(close / rnStep) * rnStep
        for k = -2 to 3
            float rp = base + k * rnStep
            raw.push(KLv.new(rp, "R" + str.tostring(rp, "#"), C_MUTE, 3))
    array<float> ps = array.new<float>()
    array<KLv>   ok = array.new<KLv>()
    for v in raw
        if not na(v.p) and math.abs(v.p - close) <= klRange * atr
            ok.push(v)
            ps.push(v.p)
    array<KLv> out = array.new<KLv>()
    if ok.size() > 0
        array<int> idx = array.sort_indices(ps, order.ascending)
        for i in idx
            KLv v = ok.get(i)
            if out.size() > 0 and math.abs(v.p - out.last().p) <= klMerge * atr
                KLv m = out.last()
                m.n := m.n + " · " + v.n
                if v.pr < m.pr
                    m.c  := v.c
                    m.pr := v.pr
                    m.p  := v.p
            else
                out.push(KLv.new(v.p, v.n, v.c, v.pr))
    out

var array<line>  klLines = array.new<line>()
var array<label> klLbls  = array.new<label>()
var array<box>   poiBxs  = array.new<box>()

if barstate.islast
    for l in klLines
        l.delete()
    for lb in klLbls
        lb.delete()
    for b in poiBxs
        b.delete()
    klLines.clear()
    klLbls.clear()
    poiBxs.clear()
    int xL = bar_index - 60
    int xR = bar_index + extBars + klOffset
    if showKL
        for v in f_klList()
            bool isRn = v.pr == 3 and not str.contains(v.n, "·")
            klLines.push(line.new(xL, v.p, xR, v.p, color = color.new(v.c, isRn ? 70 : 35), style = isRn ? line.style_dotted : line.style_dashed, width = 1))
            bool lft = klLblPos == "Left"
            klLbls.push(label.new(lft ? xL : xR, v.p, v.n + "  " + f_px(v.p), color = C_NONE, textcolor = color.new(v.c, isRn ? 30 : 0), style = lft ? label.style_label_lower_left : label.style_label_left, size = size.small))
    if klPoi and showKL
        if not na(poiBT) and math.abs(poiBT - close) <= klRange * atr
            poiBxs.push(box.new(bar_index - 60, poiBT, xR, poiBB, border_color = color.new(C_UP, 55), border_style = line.style_dashed, bgcolor = color.new(C_UP, 93),
                 text = f_tfName(poiTf) + " FVG", text_color = color.new(C_UP, 30), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_top))
        if not na(poiST) and math.abs(poiSB - close) <= klRange * atr
            poiBxs.push(box.new(bar_index - 60, poiST, xR, poiSB, border_color = color.new(C_DN, 55), border_style = line.style_dashed, bgcolor = color.new(C_DN, 93),
                 text = f_tfName(poiTf) + " FVG", text_color = color.new(C_DN, 30), text_size = size.tiny, text_halign = text.align_left, text_valign = text.align_bottom))

// ══════════════════════════════════════
// 📒 ORDER LIFECYCLE
// ══════════════════════════════════════
// 1) PENDING → FILLED / MISSED / EXPIRED / INVALID
if barstate.isconfirmed and not na(cur) and cur.state == 1 and bar_index > cur.born
    if f_fill(cur)
        cur.state   := 2
        cur.fillBar := bar_index
        cur.fillT   := time
        tradesToday += 1
        alert(alertJson ? "YOUNGYUU " + syminfo.ticker + (cur.dir == 1 ? " BUY" : " SELL") + " FILLED @ " + f_px(cur.entry) : "✅ " + syminfo.ticker + f_tx(" เข้าไม้แล้ว ", " filled ") + (cur.dir == 1 ? "BUY" : "SELL") + " @ " + f_px(cur.entry) + f_tx(" · ถือไว้ เป้าแรก ", " · hold, first target ") + f_px(cur.tps.get(0)), alert.freq_once_per_bar_close)
        if f_slHit(cur)
            f_close(cur, cur.sl, "SL")
            alert("🛑 " + syminfo.ticker + f_tx(" โดน SL ", " stopped ") + f_px(cur.sl) + f_tx(" · รอสัญญาณใหม่", " · wait for next setup"), alert.freq_once_per_bar_close)
            cur := na
        else
            f_refresh(cur)
    else if f_tpHit(cur, cur.tps.get(0))
        f_cancel(cur, "MISSED")
        cur := na
    else if bar_index - cur.born >= expiryBars
        f_cancel(cur, "EXPIRED")
        cur := na
    else if (cur.dir == 1 and bearCH) or (cur.dir == -1 and bullCH)
        f_cancel(cur, "INVALID")
        cur := na

// 2) RUNNING → TP ladder / BE / trail / SL  (SL checked first = conservative)
if barstate.isconfirmed and not na(cur) and cur.state == 2 and bar_index > cur.fillBar
    if f_slHit(cur)
        bool   atBe = f_isBe(cur)
        string res  = cur.tpHit > 0 ? "TP" + str.tostring(cur.tpHit) + (atBe ? " → BE" : " → SL") : "SL"
        f_close(cur, cur.sl, res)
        alert((res == "SL" ? "🛑 " : "✅ ") + syminfo.ticker + " " + res + " @ " + f_px(cur.sl) + f_tx(" · ไม้นี้จบแล้ว รอสัญญาณใหม่", " · trade closed, wait for next"), alert.freq_once_per_bar_close)
        cur := na
    else
        float w = 1.0 / cur.nTp
        for k = cur.tpHit to cur.nTp - 1
            if f_tpHit(cur, cur.tps.get(k))
                cur.tpHit := k + 1
                cur.rReal += w * f_rAt(cur, k + 1)
                cur.remW  -= w
                bool finK = k + 1 >= cur.nTp
                string nxtTxt = finK ? f_tx("ปิดทั้งหมด ไม้นี้จบ", "close ALL, trade done") : f_tx("ปิด ", "close ") + str.tostring(f_pct(cur)) + "%" + (beAfter > 0 and k + 1 >= beAfter ? f_tx(" + 🛡 กันทุน (SL → ", " + 🛡 BE (SL → ") + f_px(f_bePx(cur)) + ")" : "") + f_tx(" · เป้าถัดไป ", " · next ") + f_px(cur.tps.get(k + 1))
                alert((finK ? "🏁 " : "💰 ") + syminfo.ticker + " TP" + str.tostring(k + 1) + f_tx(" ถึงแล้ว: ", " hit: ") + nxtTxt, alert.freq_once_per_bar_close)
            else
                break
        if cur.tpHit > 0 and cur.tpHit < cur.nTp
            float newSl = na
            if beAfter > 0 and cur.tpHit >= beAfter
                newSl := f_bePx(cur)
            if trailTp and cur.tpHit >= 2
                newSl := cur.tps.get(cur.tpHit - 2)
            if not na(newSl) and (newSl - cur.sl) * cur.dir > 0
                bool firstBe = cur.sl == cur.slInit
                cur.sl := newSl
                if firstBe
                    alert("🛡 " + syminfo.ticker + f_tx(" กันทุนแล้ว: เลื่อน SL ไป ", " BE: move SL to ") + f_px(newSl) + f_tx(" · ไม้นี้ไม่ขาดทุนแล้ว", " · this trade can no longer lose"), alert.freq_once_per_bar_close)
        if cur.tpHit < cur.nTp and cur.capName != "" and not cur.warned and (cur.tps.get(cur.nTp - 1) - close) * cur.dir <= 0.5 * atr
            cur.warned := true
            alert("⚠ " + syminfo.ticker + f_tx(" ใกล้เป้าสุดท้าย 🏁 ", " near final target 🏁 ") + f_px(cur.tps.get(cur.nTp - 1)) + f_tx(" (ข้างบนติด ", " (blocked by ") + cur.capName + f_tx(") เตรียมปิด", ") — get ready to close"), alert.freq_once_per_bar_close)
        if cur.tpHit >= cur.nTp
            f_close(cur, cur.tps.get(cur.nTp - 1), "TP" + str.tostring(cur.nTp))
            cur := na
        else if exitOnCh and ((cur.dir == 1 and bearCH) or (cur.dir == -1 and bullCH))
            f_close(cur, cur.dir == 1 ? close : close + spread, "EXIT CHoCH")
            cur := na
        else
            f_refresh(cur)

// ── Smart TP Cap: nearest obstacle in trade direction ──
f_obstacle(int d, float lim) =>
    float  best   = na
    string nm     = ""
    float  minGap = 0.2 * atr
    if capZone
        for z in zones
            if z.dir == -d and f_zStars(z) >= capStars
                float edge = d == 1 ? z.bot : z.top
                if (edge - lim) * d > minGap and (na(best) or (edge - best) * d < 0)
                    best := edge
                    nm   := (d == 1 ? "Supply " : "Demand ") + f_starTxt(f_zStars(z))
    array<float>  kp = array.new<float>()
    array<string> kn = array.new<string>()
    if capKey
        kp.push(d == 1 ? pdh : pdl)
        kn.push(d == 1 ? "PDH" : "PDL")
        if klPW
            kp.push(d == 1 ? pwh : pwl)
            kn.push(d == 1 ? "PWH" : "PWL")
        if klAsia
            kp.push(d == 1 ? asHi : asLo)
            kn.push(d == 1 ? "Asia H" : "Asia L")
    if capRound
        kp.push(d == 1 ? math.ceil((lim + minGap) / rnStep) * rnStep : math.floor((lim - minGap) / rnStep) * rnStep)
        kn.push("Round")
    if capPoi
        kp.push(d == 1 ? poiSB : poiST)
        kn.push(f_tfName(poiTf) + " FVG")
    if kp.size() > 0
        for i = 0 to kp.size() - 1
            float lv = kp.get(i)
            if not na(lv) and (lv - lim) * d > minGap and (na(best) or (lv - best) * d < 0)
                best := lv
                nm   := kn.get(i)
    [best, nm]

f_capTps(array<float> raw, int d, float obs, float lim) =>
    array<float> out = array.new<float>()
    bool capped = false
    if na(obs)
        for t in raw
            out.push(t)
    else
        float stopAt = obs - d * capBuf * atr
        for t in raw
            if (stopAt - t) * d >= 0
                out.push(t)
        capped := out.size() < raw.size()
        if capped and capMode == "Last TP = Obstacle"
            float prev = out.size() > 0 ? out.last() : lim
            if (stopAt - prev) * d >= 0.25 * math.abs(raw.get(0) - lim)
                out.push(stopAt)
    [out, capped]

// 3) NEW SETUP (only when flat or replacing a pending order)
if barstate.isconfirmed and (bullTrig or bearTrig) and (na(cur) or cur.state == 1)
    int d    = bullTrig ? 1 : -1
    int span = d == 1 ? bar_index - nz(shBar, bar_index - 20) : bar_index - nz(slBar, bar_index - 20)
    [j, ext, fvgIn] = f_findOB(d, span)
    float obHi  = high[j]
    float obLo  = low[j]
    float bodHi = math.max(open[j], close[j])
    float bodLo = math.min(open[j], close[j])
    float lim   = d == 1 ? (entryLvl == "OB Wick" ? obHi : entryLvl == "OB 50%" ? (obHi + obLo) / 2 : bodHi) : (entryLvl == "OB Wick" ? obLo : entryLvl == "OB 50%" ? (obHi + obLo) / 2 : bodLo)
    float slPx  = slMode == "Fixed $" ? lim - d * slFixed : (d == 1 ? math.min(obLo, ext) - slBufAtr * atr : math.max(obHi, ext) + slBufAtr * atr)
    if slMode == "Structure" and math.abs(lim - slPx) < minRiskAtr * atr
        slPx := lim - d * minRiskAtr * atr
    float rk     = math.abs(lim - slPx)
    bool  okRisk = slMode == "Fixed $" or rk <= maxRiskAtr * atr
    bool  okSide = d == 1 ? close > lim : close < lim
    int   swB    = d == 1 ? bullSwBar : bearSwBar
    bool  hasSw  = not na(swB) and bar_index - swB <= sweepLook
    bool  htfOk  = htfDir == d
    bool  disc   = d == 1 ? lim < eqLvl : lim > eqLvl
    bool  keyOk  = f_keySwept(ext, d)
    bool  poiOk  = f_inPoi(lim, d)
    int   sc     = (hasSw ? 1 : 0) + (htfOk ? 1 : 0) + (fvgIn ? 1 : 0) + (inKz ? 1 : 0) + (disc ? 1 : 0) + (keyOk ? 1 : 0) + (poiOk ? 1 : 0)
    string flags = (hasSw ? "✓" : "✗") + "Swp " + (keyOk ? "✓" : "✗") + "Key " + (htfOk ? "✓" : "✗") + "HTF " + (poiOk ? "✓" : "✗") + "POI " + (fvgIn ? "✓" : "✗") + "FVG " + (inKz ? "✓" : "✗") + "KZ " + (disc ? "✓" : "✗") + (d == 1 ? "Disc" : "Prem")
    array<float> rawTp = f_tpRaw(d, lim, rk)
    [obP, obN] = f_obstacle(d, lim)
    array<float> tpUse = rawTp
    bool capped = false
    if capMode != "Off"
        [cutTp, cut] = f_capTps(rawTp, d, obP, lim)
        tpUse  := cutTp
        capped := cut
    bool  noRoom = tpUse.size() == 0
    if noRoom and not skipNoRoom
        tpUse.push(rawTp.get(0))
    float finRR  = tpUse.size() > 0 ? (tpUse.last() - lim) * d / rk : 0.0
    bool  rrOk   = minRR == 0 or finRR >= minRR
    string capNote = capped ? "✂ " + obN + " @ " + f_px(obP) : ""
    array<float> cutList = array.new<float>()
    if capped
        for t in rawTp
            if (t - (obP - d * capBuf * atr)) * d > 0
                cutList.push(t)
    bool  pass   = okRisk and okSide and (not reqSweep or hasSw) and (not useHtf or htfOk) and (not useKz or inKz) and f_gv(f_grade(sc)) >= f_gv(minGrade) and (maxTradesDay == 0 or tradesToday < maxTradesDay) and not (noRoom and skipNoRoom) and rrOk
    if pass
        if not na(cur)
            f_cancel(cur, "REPLACED")
        cur := f_new(d, lim, slPx, sc, flags, tpUse, capNote, capped ? obN : "", capped ? obP : na, cutList)
        string tpList = ""
        for k = 0 to cur.nTp - 1
            tpList += (k > 0 ? "," : "") + f_px(cur.tps.get(k))
        string msg = alertJson ?
             '{"action":"' + (d == 1 ? "BUY_LIMIT" : "SELL_LIMIT") + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period +
             '","price":' + f_px(cur.entry) + ',"limit":' + f_px(lim) + ',"early":' + f_px(cur.earlyPx) + ',"sl":' + f_px(slPx) +
             ',"tp":[' + tpList + '],"expiry_bars":' + str.tostring(expiryBars) + ',"grade":"' + cur.grade + '","score":' + str.tostring(sc) + '}' :
             (d == 1 ? "🟢 BUY LIMIT " : "🔴 SELL LIMIT ") + syminfo.ticker + " " + f_px(cur.entry) + " · SL " + f_px(slPx) + " · " + f_tx("เป้า ", "targets ") + tpList + " 🏁" + (capped ? f_tx(" (ติด ", " (blocked by ") + obN + f_tx(" ไม่ถือเกินนี้)", " — don't hold past)") : "") + " · " + f_tx("เกรด ", "grade ") + cur.grade
        alert(msg, alert.freq_once_per_bar_close)

// keep live setup levels extended
if barstate.isconfirmed and not na(cur)
    f_extend(cur, bar_index + extBars)


// ══════════════════════════════════════════════════════════════════
// 📊 OBSIDIAN HUD
// Layout: Full · Compact · Mobile · Custom (per-section toggles)
// rows depend only on inputs → table never "jumps" between ticks
// ══════════════════════════════════════════════════════════════════
tblPos = switch dashPos
    "Top Left"      => position.top_left
    "Top Center"    => position.top_center
    "Bottom Right"  => position.bottom_right
    "Bottom Left"   => position.bottom_left
    "Bottom Center" => position.bottom_center
    "Middle Right"  => position.middle_right
    => position.top_right
bool isMobile = dashLayout == "Mobile"
szBase = switch dashSzIn
    "Tiny"   => size.tiny
    "Normal" => size.normal
    => size.small
szBig = switch dashSzIn
    "Tiny"   => size.small
    "Normal" => size.large
    => size.normal
szS = isMobile ? size.tiny : szBase
szL = isMobile ? size.small : szBig
szT = size.tiny

bool lCus    = dashLayout == "Custom"
bool lFull   = dashLayout == "Full"
bool secBias = lCus ? secBiasIn : true
bool secMtx  = lCus ? secMtxIn : lFull
bool secZone = lCus ? secZoneIn : true
bool secKL   = lCus ? secKLIn : true
bool secTrd  = lCus ? secTrdIn : true
bool secTp   = lCus ? secTpIn : true
bool secPnl  = lCus ? secPnlIn : true
bool secPerf = lCus ? secPerfIn : lFull
bool secClk  = lCus ? secClkIn : true
bool secHist = lCus ? secHistIn : lFull

var table tb = table.new(tblPos, 6, 56, bgcolor = C_BG, frame_color = C_GRID, frame_width = 1, border_color = C_BG, border_width = 2)

AL = text.align_left
AC = text.align_center
AR = text.align_right

f_put(int c0, int c1, int r, string t, color tc, color bg, string sz, string ha, bool mono) =>
    table.cell(tb, c0, r, t, text_color = tc, bgcolor = bg, text_size = sz, text_halign = ha,
         text_font_family = mono ? font.family_monospace : font.family_default)
    if c1 > c0
        table.merge_cells(tb, c0, r, c1, r)

f_soft(color c)  => color.new(c, isLight ? 88 : 82)
f_dirBg(int d)   => d > 0 ? f_soft(C_UP) : d < 0 ? f_soft(C_DN) : C_OFF
f_bar(int on, int n, string a, string b) => str.repeat(a, math.max(0, math.min(on, n))) + str.repeat(b, math.max(0, n - math.min(on, n)))
f_hms(int ms) =>
    int s0 = math.max(0, math.floor(ms / 1000))
    str.format("{0,number,00}:{1,number,00}:{2,number,00}", math.floor(s0 / 3600), math.floor((s0 % 3600) / 60), s0 % 60)

f_kz(string sess) =>
    int sH = int(str.tonumber(str.substring(sess, 0, 2)))
    int sM = int(str.tonumber(str.substring(sess, 2, 4)))
    int eH = int(str.tonumber(str.substring(sess, 5, 7)))
    int eM = int(str.tonumber(str.substring(sess, 7, 9)))
    int y  = year(timenow, "UTC")
    int mo = month(timenow, "UTC")
    int d  = dayofmonth(timenow, "UTC")
    int st = timestamp("UTC", y, mo, d, sH, sM)
    int en = timestamp("UTC", y, mo, d, eH, eM)
    if timenow >= en
        st += 86400000
        en += 86400000
    [st, en]

f_tfRow(int r, string tf, int b, int c, int s, int f, int d) =>
    int sum = b + c + s + f + d
    bool strong = math.abs(sum) >= 3
    string bias = sum >= 3 ? "▲▲" : sum > 0 ? "▲" : sum <= -3 ? "▼▼" : sum < 0 ? "▼" : "•"
    f_put(0, 0, r, f_tfName(tf), C_TXT, na, szS, AL, true)
    f_put(1, 1, r, f_dirTxt(b), f_dirCol(b), f_dirBg(b), szS, AC, false)
    f_put(2, 2, r, f_dirTxt(c), f_dirCol(c), f_dirBg(c), szS, AC, false)
    f_put(3, 3, r, f_dirTxt(s), f_dirCol(s), f_dirBg(s), szS, AC, false)
    f_put(4, 4, r, f_dirTxt(f), f_dirCol(f), f_dirBg(f), szS, AC, false)
    color bBg = sum > 0 ? (strong ? C_UP : f_soft(C_UP)) : sum < 0 ? (strong ? C_DN : f_soft(C_DN)) : C_OFF
    color bFg = sum > 0 ? (strong ? C_ONUP : C_UP) : sum < 0 ? (strong ? color.white : C_DN) : C_MUTE
    f_put(5, 5, r, bias, bFg, bBg, szS, AC, false)
    sum

var array<string> SPK = array.from("▁", "▂", "▃", "▄", "▅", "▆", "▇", "█")

if barstate.islast
    // ── shared values ────────────────────────────────
    int sA = nz(aB) + nz(aC) + nz(aS) + nz(aF) + nz(aD)
    int sB = nz(bB) + nz(bC) + nz(bS) + nz(bF) + nz(bD)
    int sC = nz(cB) + nz(cC) + nz(cS) + nz(cF) + nz(cD)
    int sumAll = sA + sB + sC
    int conf   = math.round(math.abs(sumAll) / 15.0 * 100)
    string biasTxt = sumAll >= 3 ? "BULLISH" : sumAll <= -3 ? "BEARISH" : "NEUTRAL"
    color  biasCol = sumAll >= 3 ? C_UP : sumAll <= -3 ? C_DN : C_WARN
    int upN = (nz(aD) == 1 ? 1 : 0) + (nz(bD) == 1 ? 1 : 0) + (nz(cD) == 1 ? 1 : 0)
    int dnN = (nz(aD) == -1 ? 1 : 0) + (nz(bD) == -1 ? 1 : 0) + (nz(cD) == -1 ? 1 : 0)

    Zone zs = f_zNear(-1)
    Zone zd = f_zNear(1)
    bool inS = not na(zs) and close >= zs.bot
    bool inD = not na(zd) and close <= zd.top

    float  kUpP = na
    string kUpN = ""
    float  kDnP = na
    string kDnN = ""
    for v in f_klList()
        if v.p > close and (na(kUpP) or v.p < kUpP)
            kUpP := v.p
            kUpN := v.n
        if v.p < close and (na(kDnP) or v.p > kDnP)
            kDnP := v.p
            kDnN := v.n

    Setup s = na
    if not na(cur)
        s := cur
    else if hist.size() > 0
        s := hist.last()
    bool  has  = not na(s)
    bool  run  = has and s.state == 2
    color dCol = has ? (s.dir == 1 ? C_UP : C_DN) : C_MUTE
    float liveR = run ? ((s.dir == 1 ? close : close + spread) - s.entry) * s.dir / s.risk : na

    // 👉 WHAT TO DO NOW — one plain-language instruction for beginners
    float finTp   = has ? s.tps.get(s.nTp - 1) : na
    bool  nearFin = run and s.capName != "" and (finTp - close) * s.dir <= 0.5 * atr
    float prog    = run ? math.max(0.0, math.min(1.0, (close - s.entry) / (finTp - s.entry))) : na
    string nowTxt = ""
    color  nowCol = C_MUTE
    if not has
        nowTxt := f_tx("⏳ รอสัญญาณ · ยังไม่ต้องทำอะไร", "⏳ Waiting for setup · no action needed")
    else if s.state == 1
        nowTxt := f_tx("🎯 ตั้ง ", "🎯 Place ") + (s.dir == 1 ? "BUY" : "SELL") + " LIMIT " + f_px(s.entry) + " · SL " + f_px(s.sl)
        nowCol := C_BLUE
    else if s.state == 2
        if nearFin
            nowTxt := f_tx("⚠ ใกล้เป้าสุดท้าย 🏁 เตรียมปิดทั้งหมด", "⚠ Near final target 🏁 get ready to close")
            nowCol := C_WARN
        else if s.tpHit == 0
            nowTxt := f_tx("✋ ถือไว้ · เป้าแรก ", "✋ Hold · first target ") + f_px(s.tps.get(0)) + f_tx(" (อีก $", " ($") + str.tostring(math.max(0, (s.tps.get(0) - close) * s.dir), "#.##") + f_tx(")", " to go)") + (beAfter > 0 ? f_tx(" · 🛡 กันทุนเมื่อถึง TP", " · 🛡 BE at TP") + str.tostring(beAfter) : "")
            nowCol := C_TXT
        else
            nowTxt := "💰 " + f_tx("เก็บแล้ว ", "Banked ") + str.tostring(math.min(100, f_pct(s) * s.tpHit)) + "%" + (s.sl == s.slInit ? "" : f_isBe(s) ? f_tx(" · 🛡 กันทุนแล้ว", " · 🛡 at BE") : f_tx(" · 🔒 ล็อกกำไรแล้ว", " · 🔒 profit locked")) + f_tx(" · ถือต่อ TP", " · hold for TP") + str.tostring(s.tpHit + 1)
            nowCol := C_UP
    else if s.state == 3
        nowTxt := s.tpHit >= s.nTp ? "🏁 " + f_tx("ครบเป้า ", "Target done ") + f_r(s.rFinal) + f_tx(" · รอสัญญาณใหม่", " · wait for next") : s.tpHit > 0 ? "✅ " + f_tx("ออกพร้อมกำไร ", "Exited in profit ") + f_r(s.rFinal) + f_tx(" · รอสัญญาณใหม่", " · wait for next") : "🛑 " + f_tx("โดน SL ", "Stopped ") + f_r(s.rFinal) + f_tx(" · อย่ารีบเอาคืน รอสัญญาณใหม่", " · no revenge, wait for next")
        nowCol := s.rFinal >= 0 ? C_UP : C_DN
    else
        nowTxt := "❌ " + f_tx("ยกเลิก (", "Cancelled (") + s.result + f_tx(") · รอสัญญาณใหม่", ") · wait for next")
    string planTxt = has ? f_tx("แผน: ", "Plan: ") + str.tostring(s.nTp) + f_tx(" เป้า · ปิดเป้าละ ", " targets · close ") + str.tostring(f_pct(s)) + "%" + (beAfter > 0 ? f_tx(" · 🛡 กันทุนหลัง TP", " · 🛡 BE after TP") + str.tostring(beAfter) : "") + (s.capName != "" ? f_tx(" · 🏁 สุดที่ TP", " · 🏁 final TP") + str.tostring(s.nTp) + f_tx(" (ติด ", " (") + s.capName + ")" : "") : ""

    // performance (selected period)
    int pStart = statPeriod == "Today" ? tD : statPeriod == "This Week" ? tW : statPeriod == "This Month" ? tM : 0
    int   n    = 0
    int   wN   = 0
    int   lN   = 0
    float sumR = 0.0
    float gW   = 0.0
    float gL   = 0.0
    float cum  = 0.0
    float peak = 0.0
    float mdd  = 0.0
    array<int>   form  = array.new<int>()
    array<float> curve = array.new<float>()
    array<int>   gN    = array.new<int>(4, 0)
    array<int>   gWn   = array.new<int>(4, 0)
    if stT.size() > 0
        for i = 0 to stT.size() - 1
            if stT.get(i) >= pStart
                float R  = stR.get(i)
                int   sc = stG.get(i)
                int   gi = sc >= 6 ? 0 : sc == 5 ? 1 : sc == 4 ? 2 : 3
                n    += 1
                sumR += R
                gN.set(gi, gN.get(gi) + 1)
                if stW.get(i) == 1
                    wN += 1
                    gWn.set(gi, gWn.get(gi) + 1)
                else
                    lN += 1
                if R > 0
                    gW += R
                else
                    gL -= R
                cum  += R
                peak := math.max(peak, cum)
                mdd  := math.max(mdd, peak - cum)
                form.push(stW.get(i))
                if form.size() > 10
                    form.shift()
                curve.push(cum)
                if curve.size() > 24
                    curve.shift()
    float wr = n > 0 ? 100.0 * wN / n : 0.0

    [lSt, lEn] = f_kz(kzLon)
    [nSt, nEn] = f_kz(kzNy)
    bool lOn = timenow >= lSt and timenow < lEn
    bool nOn = timenow >= nSt and timenow < nEn
    string kzTxt = lOn ? "◷ LONDON KZ · ends " + f_hms(lEn - timenow) : nOn ? "◷ NEW YORK KZ · ends " + f_hms(nEn - timenow) : lSt - timenow < nSt - timenow ? "◷ LONDON KZ in " + f_hms(lSt - timenow) : "◷ NEW YORK KZ in " + f_hms(nSt - timenow)
    string barTxt = "bar " + f_hms(math.max(0, nz(time_close - timenow)))
    string liveDot = second(timenow) % 2 == 0 ? "● LIVE" : "○ LIVE"

    int r = 0
    if isMobile
        // ═══ MOBILE: 7 rows, tiny text ══════════════════
        f_put(0, 3, r, "⬡ YOUNGYUU SMC", C_INK, C_ACC, szT, AL, false)
        f_put(4, 5, r, liveDot, C_UP, f_soft(C_UP), szT, AC, false)
        r += 1
        f_put(0, 5, r, "👉 " + nowTxt, nowCol, f_soft(nowCol), szT, AL, false)
        r += 1
        f_put(0, 1, r, biasTxt, biasCol, f_soft(biasCol), szT, AC, false)
        f_put(2, 5, r, f_tfName(tfA) + f_dirTxt(nz(aD)) + " " + f_tfName(tfB) + f_dirTxt(nz(bD)) + " " + f_tfName(tfC) + f_dirTxt(nz(cD)) + "  " + str.tostring(conf) + "%", C_TXT, C_SEC, szT, AC, true)
        r += 1
        f_put(0, 2, r, na(zs) ? "S —" : "S " + f_starTxt(f_zStars(zs)) + (inS ? " IN" : " ↑" + str.tostring(zs.bot - close, "#.#")), C_DN, C_SEC, szT, AL, false)
        f_put(3, 5, r, na(zd) ? "D —" : "D " + f_starTxt(f_zStars(zd)) + (inD ? " IN" : " ↓" + str.tostring(close - zd.top, "#.#")), C_UP, C_SEC, szT, AL, false)
        r += 1
        f_put(0, 1, r, not has ? "WAIT" : (s.dir == 1 ? "BUY " : "SELL ") + s.grade, has ? (s.dir == 1 ? C_ONUP : color.white) : C_MUTE, has ? dCol : C_OFF, szT, AC, false)
        f_put(2, 3, r, has ? "E " + f_px(s.entry) : "—", C_BLUE, f_soft(C_BLUE), szT, AC, true)
        f_put(4, 5, r, has ? "SL " + f_px(s.sl) : "—", C_DN, f_soft(C_DN), szT, AC, true)
        r += 1
        string dots = ""
        if has
            for k = 0 to s.nTp - 1
                dots += s.tpHit > k ? "●" : (s.state == 2 and s.tpHit == k) ? "◉" : "○"
        string nxt = has and s.tpHit < s.nTp ? "  next " + f_px(s.tps.get(s.tpHit)) : ""
        f_put(0, 5, r, has ? "TP " + dots + " 🏁" + nxt : "TP —", C_UP, na, szT, AL, true)
        r += 1
        f_put(0, 2, r, run ? f_r(liveR) : has and s.state == 3 ? f_r(s.rFinal) : "—", run ? (liveR >= 0 ? C_UP : C_DN) : C_MUTE, C_SEC, szS, AL, true)
        f_put(3, 5, r, "WR " + str.tostring(wr, "#.#") + "% · " + f_r(sumR), C_GOLD, C_SEC, szT, AR, true)
        r += 1
        f_put(0, 5, r, kzTxt + " · " + barTxt, lOn or nOn ? C_GOLD : C_MUTE, na, szT, AL, false)
    else
        // ═══ FULL / COMPACT / CUSTOM ════════════════════
        f_put(0, 3, r, "⬡ YOUNGYUU  SMC ENTRY PRO", C_INK, C_ACC, szS, AL, false)
        f_put(4, 5, r, liveDot, C_UP, f_soft(C_UP), szS, AC, false)
        r += 1
        f_put(0, 2, r, syminfo.ticker + " · " + f_tfName(timeframe.period), C_MUTE, na, szT, AL, true)
        f_put(3, 5, r, "NON-REPAINT · BAR CLOSE", C_MUTE, na, szT, AR, false)
        r += 1
        f_put(0, 0, r, f_tx("👉 ตอนนี้", "👉 NOW"), C_INK, nowCol == C_MUTE ? C_OFF : nowCol, szT, AC, false)
        f_put(1, 5, r, nowTxt, nowCol == C_MUTE ? C_TXT : nowCol, f_soft(nowCol), szS, AL, false)
        r += 1

        if secBias
            f_put(0, 1, r, "MARKET\nBIAS", C_MUTE, C_SEC, szT, AL, false)
            f_put(2, 3, r, biasTxt, biasCol, C_SEC, szL, AC, false)
            f_put(4, 5, r, str.tostring(conf) + "%\n" + f_bar(math.round(conf / 10), 10, "▰", "▱"), biasCol, C_SEC, szS, AR, true)
            r += 1

        if secMtx
            f_put(0, 0, r, "TF", C_MUTE, na, szT, AL, false)
            f_put(1, 1, r, "BOS", C_MUTE, na, szT, AC, false)
            f_put(2, 2, r, "CHOCH", C_MUTE, na, szT, AC, false)
            f_put(3, 3, r, "SWEEP", C_MUTE, na, szT, AC, false)
            f_put(4, 4, r, "FVG", C_MUTE, na, szT, AC, false)
            f_put(5, 5, r, "BIAS", C_MUTE, na, szT, AC, false)
            r += 1
            f_tfRow(r, tfA, nz(aB), nz(aC), nz(aS), nz(aF), nz(aD))
            r += 1
            f_tfRow(r, tfB, nz(bB), nz(bC), nz(bS), nz(bF), nz(bD))
            r += 1
            f_tfRow(r, tfC, nz(cB), nz(cC), nz(cS), nz(cF), nz(cD))
            r += 1
        if secBias or secMtx
            string alTxt = upN == 3 ? "✓ STRUCTURE ALIGNED · BULL 3/3" : dnN == 3 ? "✓ STRUCTURE ALIGNED · BEAR 3/3" : upN == 2 ? "BULL 2/3 · " + f_tfName(tfA) + " " + (nz(aD) == 1 ? "✓" : "✕") : dnN == 2 ? "BEAR 2/3 · " + f_tfName(tfA) + " " + (nz(aD) == -1 ? "✓" : "✕") : "MIXED · STAND ASIDE"
            color  alCol = upN >= 2 ? C_UP : dnN >= 2 ? C_DN : C_WARN
            f_put(0, 5, r, alTxt, alCol, f_soft(alCol), szT, AC, false)
            r += 1

        if secZone
            f_put(0, 0, r, "SUPPLY", C_DN, f_soft(C_DN), szT, AC, false)
            f_put(1, 3, r, na(zs) ? "—" : f_px(zs.bot) + "–" + f_px(zs.top) + (inS ? "  ⚠ IN" : "  ↑" + str.tostring(zs.bot - close, "#.##")), inS ? C_WARN : C_TXT, na, szT, AL, true)
            f_put(4, 5, r, na(zs) ? "" : f_starTxt(f_zStars(zs)), C_GOLD, na, szS, AC, false)
            r += 1
            f_put(0, 0, r, "DEMAND", C_UP, f_soft(C_UP), szT, AC, false)
            f_put(1, 3, r, na(zd) ? "—" : f_px(zd.bot) + "–" + f_px(zd.top) + (inD ? "  ⚠ IN" : "  ↓" + str.tostring(close - zd.top, "#.##")), inD ? C_WARN : C_TXT, na, szT, AL, true)
            f_put(4, 5, r, na(zd) ? "" : f_starTxt(f_zStars(zd)), C_GOLD, na, szS, AC, false)
            r += 1

        if secKL
            f_put(0, 0, r, "▲ KEY", C_BLUE, f_soft(C_BLUE), szT, AC, false)
            f_put(1, 3, r, na(kUpP) ? "—" : kUpN, C_TXT, na, szT, AL, false)
            f_put(4, 5, r, na(kUpP) ? "" : f_px(kUpP) + "  +" + str.tostring(kUpP - close, "#.#"), C_MUTE, na, szT, AR, true)
            r += 1
            f_put(0, 0, r, "▼ KEY", C_BLUE, f_soft(C_BLUE), szT, AC, false)
            f_put(1, 3, r, na(kDnP) ? "—" : kDnN, C_TXT, na, szT, AL, false)
            f_put(4, 5, r, na(kDnP) ? "" : f_px(kDnP) + "  −" + str.tostring(close - kDnP, "#.#"), C_MUTE, na, szT, AR, true)
            r += 1

        if secTrd
            string pill = not has ? "WAITING" : (s.dir == 1 ? "BUY" : "SELL") + (s.state == 1 ? " LIMIT" : s.state == 2 ? " · LIVE" : " · LAST")
            f_put(0, 1, r, pill, has ? (s.dir == 1 ? C_ONUP : color.white) : C_MUTE, has ? dCol : C_OFF, szS, AC, false)
            f_put(2, 3, r, has ? s.grade + "  " + f_bar(s.score, 7, "▰", "▱") : "—", has ? C_GOLD : C_MUTE, C_SEC, szS, AC, false)
            f_put(4, 5, r, has ? "R:R 1 : " + str.tostring(f_rAt(s, s.nTp), "#.#") : "R:R —", C_BLUE, C_SEC, szS, AC, true)
            r += 1
            string flg = has ? str.replace_all(str.replace_all(s.flags, "✓", " ✓"), "✗", " ✕") : "waiting for Sweep → CHoCH → OB"
            f_put(0, 5, r, flg, C_TXT, na, szT, AC, false)
            r += 1
            f_put(0, 5, r, planTxt == "" ? "—" : planTxt, has and s.capName != "" ? C_WARN : C_MUTE, na, szT, AC, false)
            r += 1
            f_put(0, 1, r, f_tx("ถึงเป้า 🏁", "TO 🏁"), C_MUTE, na, szT, AL, false)
            f_put(2, 5, r, run ? f_bar(math.round(prog * 10), 10, "▰", "▱") + "  " + str.tostring(math.round(prog * 100)) + "%" : "—", C_UP, na, szT, AL, true)
            r += 1
            f_put(0, 1, r, "ENTRY", C_MUTE, f_soft(C_BLUE), szT, AC, false)
            f_put(2, 3, r, "EARLY", C_MUTE, f_soft(C_GOLD), szT, AC, false)
            f_put(4, 5, r, not has or s.sl == s.slInit ? "STOP" : f_isBe(s) ? f_tx("🛡 กันทุนแล้ว", "🛡 BREAKEVEN") : f_tx("🔒 ล็อกกำไร", "🔒 LOCKED"), C_MUTE, has and s.sl != s.slInit ? f_soft(C_UP) : f_soft(C_DN), szT, AC, false)
            r += 1
            f_put(0, 1, r, has ? f_px(s.entry) : "—", C_BLUE, f_soft(C_BLUE), szS, AC, true)
            f_put(2, 3, r, has ? f_px(s.earlyPx) : "—", C_GOLD, f_soft(C_GOLD), szS, AC, true)
            f_put(4, 5, r, has ? f_px(s.sl) : "—", C_DN, f_soft(C_DN), szS, AC, true)
            r += 1

        if secTp
            for k = 0 to 4
                bool ex  = has and k < s.nTp
                bool hit = ex and s.tpHit > k
                bool nx  = ex and not hit and s.state <= 2 and s.tpHit == k
                f_put(0, 0, r, hit ? "●" : nx ? "◉" : "○", hit ? C_UP : nx ? C_BLUE : C_OFF, na, szS, AC, false)
                f_put(1, 1, r, "TP" + str.tostring(k + 1), hit ? C_UP : nx ? C_BLUE : C_MUTE, na, szS, AL, false)
                bool capRow = has and not ex and k == s.nTp and s.capNote != ""
                f_put(2, 3, r, ex ? f_px(s.tps.get(k)) : capRow ? s.capNote : "—", hit ? C_TXT : capRow ? C_WARN : C_MUTE, na, capRow ? szT : szS, AL, not capRow)
                f_put(4, 4, r, ex ? "+" + str.tostring(f_rAt(s, k + 1), "#.#") + "R" : "", C_MUTE, na, szT, AR, true)
                f_put(5, 5, r, hit ? "HIT" : nx ? "NEXT" : "", hit ? C_UP : C_BLUE, hit ? f_soft(C_UP) : nx ? f_soft(C_BLUE) : na, szT, AC, false)
                r += 1

        if secPnl
            string stTxt = not has ? "NO ACTIVE SETUP" : s.state == 1 ? "⏳ PENDING · " + str.tostring(expiryBars - (bar_index - s.born)) + " bars left" : s.state == 2 ? "LIVE P/L · RUNNING TP" + str.tostring(math.min(s.tpHit + 1, s.nTp)) : s.state == 3 ? "CLOSED · " + s.result : "CANCELLED · " + s.result
            color  stCol = not has ? C_MUTE : s.state == 1 or s.state == 4 ? C_WARN : s.state == 2 ? C_MUTE : s.tpHit > 0 ? C_UP : C_DN
            f_put(0, 2, r, stTxt, stCol, C_SEC, szT, AL, false)
            f_put(3, 5, r, run ? f_r(liveR) : has and s.state == 3 ? f_r(s.rFinal) : "—", run ? (liveR >= 0 ? C_UP : C_DN) : has and s.state == 3 ? (s.rFinal >= 0 ? C_UP : C_DN) : C_MUTE, C_SEC, szL, AR, true)
            r += 1
            f_put(0, 2, r, run ? "$" + str.tostring(liveR * s.risk, "#.##") + " / oz" : "", C_TXT, C_SEC, szT, AL, true)
            f_put(3, 5, r, run ? "Banked " + f_r(s.rReal) + " · " + str.tostring(bar_index - s.fillBar) + " bars" : "", C_MUTE, C_SEC, szT, AR, true)
            r += 1

        if secPerf
            string pName = statPeriod == "This Month" ? str.upper(str.format_time(time, "MMM yyyy", syminfo.timezone)) : str.upper(statPeriod)
            string formTxt = ""
            for v in form
                formTxt += v == 1 ? "🟩" : "🟥"
            string spark = ""
            if curve.size() > 1
                float mn = curve.min()
                float mx = curve.max()
                for v in curve
                    int idx = mx > mn ? math.round((v - mn) / (mx - mn) * 7) : 3
                    spark += SPK.get(idx)
            string gTxt = ""
            array<string> gName = array.from("A+", "A", "B", "C")
            for g = 0 to 3
                if gN.get(g) > 0
                    gTxt += (gTxt == "" ? "" : "  ·  ") + gName.get(g) + " " + str.tostring(100.0 * gWn.get(g) / gN.get(g), "#") + "% (" + str.tostring(gN.get(g)) + ")"
            f_put(0, 3, r, "PERFORMANCE · " + pName, C_MUTE, na, szT, AL, false)
            f_put(4, 5, r, statPeriod == "Today" ? "D" : statPeriod == "This Week" ? "W" : statPeriod == "This Month" ? "M" : "ALL", C_INK, C_ACC, szT, AC, false)
            r += 1
            f_put(0, 1, r, "TRADES", C_MUTE, C_SEC, szT, AL, false)
            f_put(2, 3, r, "WIN RATE", C_MUTE, C_SEC, szT, AL, false)
            f_put(4, 5, r, "NET", C_MUTE, C_SEC, szT, AL, false)
            r += 1
            f_put(0, 1, r, str.tostring(n), C_TXT, C_SEC, szL, AL, true)
            f_put(2, 3, r, str.tostring(wr, "#.#") + "%", C_GOLD, C_SEC, szL, AL, true)
            f_put(4, 5, r, f_r(sumR), sumR >= 0 ? C_UP : C_DN, C_SEC, szL, AL, true)
            r += 1
            f_put(0, 1, r, "PROFIT F.", C_MUTE, C_SEC, szT, AL, false)
            f_put(2, 3, r, "MAX DD", C_MUTE, C_SEC, szT, AL, false)
            f_put(4, 5, r, "AVG / TRADE", C_MUTE, C_SEC, szT, AL, false)
            r += 1
            f_put(0, 1, r, gL > 0 ? str.tostring(gW / gL, "#.##") : "—", C_TXT, C_SEC, szL, AL, true)
            f_put(2, 3, r, "-" + str.tostring(mdd, "#.#") + "R", C_DN, C_SEC, szL, AL, true)
            f_put(4, 5, r, n > 0 ? f_r(sumR / n) : "—", sumR >= 0 ? C_UP : C_DN, C_SEC, szL, AL, true)
            r += 1
            f_put(0, 1, r, str.tostring(wN) + "W / " + str.tostring(lN) + "L", C_MUTE, na, szT, AL, true)
            f_put(2, 5, r, f_bar(math.round(wr / 5), 20, "█", "░"), C_GOLD, na, szT, AL, false)
            r += 1
            f_put(0, 1, r, "WR BY GRADE", C_MUTE, na, szT, AL, false)
            f_put(2, 5, r, gTxt == "" ? "—" : gTxt, C_GOLD, f_soft(C_GOLD), szT, AL, true)
            r += 1
            f_put(0, 1, r, "LAST 10", C_MUTE, na, szT, AL, false)
            f_put(2, 5, r, formTxt == "" ? "—" : formTxt, C_TXT, na, szT, AL, false)
            r += 1
            f_put(0, 1, r, "EQUITY (R)", C_MUTE, na, szT, AL, false)
            f_put(2, 5, r, spark == "" ? "—" : spark, C_UP, f_soft(C_UP), szS, AL, false)
            r += 1

        if secHist
            f_put(0, 5, r, f_tx("📜 ประวัติสัญญาณล่าสุด", "📜 RECENT TRADES"), C_MUTE, C_SEC, szT, AL, false)
            r += 1
            int nH = stT.size()
            for h = 0 to histRows - 1
                int ix = nH - 1 - h
                if ix >= 0
                    float hr = stR.get(ix)
                    f_put(0, 1, r, str.format_time(stE.get(ix), "dd MMM HH:mm", syminfo.timezone), C_MUTE, na, szT, AL, true)
                    f_put(2, 2, r, stD.get(ix) == 1 ? "BUY" : "SELL", stD.get(ix) == 1 ? C_UP : C_DN, f_soft(stD.get(ix) == 1 ? C_UP : C_DN), szT, AC, false)
                    f_put(3, 3, r, f_grade(stG.get(ix)), C_GOLD, na, szT, AC, false)
                    f_put(4, 4, r, stRes.get(ix), stW.get(ix) == 1 ? C_UP : C_DN, na, szT, AL, false)
                    f_put(5, 5, r, f_r(hr), hr >= 0 ? C_UP : C_DN, na, szT, AR, true)
                else
                    f_put(0, 5, r, h == 0 ? f_tx("ยังไม่มีไม้ที่ปิด", "no closed trades yet") : "", C_MUTE, na, szT, AC, false)
                r += 1

        if secClk
            f_put(0, 3, r, kzTxt, lOn or nOn ? C_GOLD : C_MUTE, C_SEC, szT, AL, false)
            f_put(4, 5, r, barTxt, C_TXT, C_SEC, szT, AR, true)
            r += 1
        string mdl = rModel == "Partial (equal split)" ? "Partial-R" : rModel == "Max TP reached" ? "Max-TP-R" : "Final-R"
        f_put(0, 5, r, "spread $" + str.tostring(spread, "#.##") + " · " + mdl + " · today " + str.tostring(tradesToday) + (maxTradesDay > 0 ? "/" + str.tostring(maxTradesDay) : "") + " filled", C_MUTE, na, szT, AC, false)

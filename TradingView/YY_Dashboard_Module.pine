// ════════════════════════════════════════════════════════════════
// YY ทดลองเงิน · Dashboard Module v1.2  (Pine Script v6)
// ────────────────────────────────────────────────────────────────
// วิธีใช้:
//   1) copy ทั้งไฟล์นี้ไปวาง "ต่อท้ายสุด" ของ indicator ที่ต้องการ (ต้องเป็น //@version=6)
//   2) แก้ 2 บรรทัด yyBuy / yySell ด้านล่าง ให้ชี้ไปที่ตัวแปรสัญญาณของ indicator นั้น
//        ตัวอย่าง MCE:   bool yyBuy = evBull     bool yySell = evBear
//   3) ใน indicator(...) ของตัวหลัก เพิ่ม  max_boxes_count = 500, max_labels_count = 500
//   4) Save → Add to chart → ตั้งค่าในกลุ่ม "💰 YY ทดลองเงิน"
// ระบบจะจำลองเทรดทุกสัญญาณบนประวัติกราฟ ด้วยเงินทุน / SL / TP / lot ที่ตั้งเอง
// ⚠ เป็นการจำลองจากกราฟ ไม่ใช่ผลเทรดจริง (ไม่มี slippage / requote)
// ════════════════════════════════════════════════════════════════

// ▼▼▼ แก้ 2 บรรทัดนี้ ▼▼▼
bool yyBuy  = false    // ← สัญญาณซื้อของ indicator (true เฉพาะแท่งที่เกิดสัญญาณ)
bool yySell = false    // ← สัญญาณขายของ indicator
// ▲▲▲ แก้ 2 บรรทัดนี้ ▲▲▲

const string YYG1 = "💰 YY ทดลองเงิน"
const string YYG2 = "📊 YY แผง"
const string YYG3 = "📐 YY SL / TP แบบ ATR หรือ R"
yyCapital  = input.float(300.0, "เงินทุน ($)", minval = 1.0, step = 50.0, group = YYG1, display = display.none)
yyLotMode  = input.string("Lot คงที่", "ขนาดไม้", options = ["Lot คงที่", "Risk %"], group = YYG1, display = display.none, tooltip = "Lot คงที่: ใช้ lot ที่เลือกทุกไม้\nRisk %: คำนวณ lot ให้เสียไม่เกิน x% ถ้าโดน SL")
yyLot      = input.float(0.01, "Lot", options = [0.01, 0.02, 0.03, 0.05, 0.1, 0.2, 0.3, 0.5, 1.0, 2.0], group = YYG1, display = display.none)
yyRisk     = input.float(1.0, "Risk %", options = [0.25, 0.5, 1.0, 1.5, 2.0, 3.0, 5.0], group = YYG1, display = display.none)
yyMode     = input.string("คงที่ ($/Points)", "รูปแบบ SL / TP", options = ["คงที่ ($/Points)", "ATR", "SL ATR · TP เป็น R"], group = YYG1, display = display.none, tooltip = "คงที่: ระยะเท่ากันทุกไม้ (ตั้งด้านล่าง)\nATR: ระยะยืด/หดตามความผันผวน (ตั้งในกลุ่ม 📐)\nSL ATR · TP เป็น R: SL ตาม ATR · TP = กี่เท่าของ SL")
yyUnit     = input.string("$ ราคา", "หน่วยของ SL / TP", options = ["$ ราคา", "Points"], group = YYG1, display = display.none, tooltip = "$ ราคา: ใส่ 5 = ราคาห่าง $5 (ทอง 0.01 lot = เสีย/ได้ $5)\nPoints: ใช้ point ของโบรก เช่น ทองทศนิยม 3 ตำแหน่ง 500 points = $0.50")
yySL       = input.float(5.0, "SL", minval = 0.001, step = 0.5, group = YYG1, display = display.none)
yyTP1      = input.float(5.0, "TP1", minval = 0.001, step = 0.5, group = YYG1, display = display.none)
yyTP2      = input.float(10.0, "TP2", minval = 0.001, step = 0.5, group = YYG1, display = display.none)
yyTP3      = input.float(15.0, "TP3", minval = 0.001, step = 0.5, group = YYG1, display = display.none)
yyAtrLen   = input.int(14, "ATR ยาว", minval = 1, group = YYG3, display = display.none)
yySLatr    = input.float(1.0, "SL × ATR", minval = 0.1, step = 0.1, group = YYG3, display = display.none)
yyTP1atr   = input.float(1.0, "TP1 × ATR", minval = 0.1, step = 0.1, group = YYG3, display = display.none, inline = "ya")
yyTP2atr   = input.float(2.0, "TP2", minval = 0.1, step = 0.1, group = YYG3, display = display.none, inline = "ya")
yyTP3atr   = input.float(3.0, "TP3", minval = 0.1, step = 0.1, group = YYG3, display = display.none, inline = "ya")
yyTP1r     = input.float(1.0, "TP1 (R)", minval = 0.1, step = 0.1, group = YYG3, display = display.none, inline = "yr")
yyTP2r     = input.float(2.0, "TP2", minval = 0.1, step = 0.1, group = YYG3, display = display.none, inline = "yr")
yyTP3r     = input.float(3.0, "TP3", minval = 0.1, step = 0.1, group = YYG3, display = display.none, inline = "yr")
yyExit     = input.string("ปิดหมดที่ TP1", "ปิดไม้แบบ", options = ["ปิดหมดที่ TP1", "ปิดหมดที่ TP2", "ปิดหมดที่ TP3", "แบ่งปิด 1/3"], group = YYG1, display = display.none)
yyBE       = input.bool(true, "ถึง TP1 แล้วเลื่อน SL มาที่ทุน", group = YYG1, display = display.none)
yyNewSig   = input.string("ถือไม้เดิม", "มีสัญญาณใหม่ระหว่างถือไม้", options = ["ถือไม้เดิม", "ปิดแล้วเข้าใหม่"], group = YYG1, display = display.none)
yyContract = input.float(100.0, "1 lot = กี่ ounce", minval = 1.0, group = YYG1, display = display.none, tooltip = "ทองคำ XAUUSD มาตรฐาน = 100")
yyComm     = input.float(7.0, "ค่าคอม ($ ต่อ 1 lot ไป-กลับ)", minval = 0.0, step = 0.5, group = YYG1, display = display.none)
yySpread   = input.float(0.20, "Spread ($ ราคา)", minval = 0.0, step = 0.05, group = YYG1, display = display.none)
yyShow     = input.bool(true, "แสดงแผง", group = YYG2, display = display.none)
yySizeTx   = input.string("เล็กมาก", "ขนาดตัวอักษร", options = ["เล็กมาก", "เล็ก", "กลาง"], group = YYG2, display = display.none)
yyPosTx    = input.string("ขวาบน", "ตำแหน่งแผง", options = ["ขวาบน", "ซ้ายบน", "ขวาล่าง", "ซ้ายล่าง"], group = YYG2, display = display.none)
yyDays     = input.bool(false, "แสดงผล 3 วันล่าสุด", group = YYG2, display = display.none)
yyLayout   = input.string("กว้าง (2 ฝั่ง)", "รูปแบบแผง", options = ["กว้าง (2 ฝั่ง)", "แคบ (มือถือ)"], group = YYG2, display = display.none)
yySigLbl   = input.bool(true, "ป้าย ซื้อ / ขาย เล็ก", group = YYG2, display = display.none)
yyBoxShow  = input.bool(true, "กล่อง TP / SL", group = YYG2, display = display.none)
yyBoxN     = input.int(20, "เก็บกล่องย้อนหลัง (ไม้)", minval = 1, maxval = 200, group = YYG2, display = display.none, tooltip = "จำนวนไม้ล่าสุดที่แสดงกล่อง + ป้ายบนกราฟ")

// ── state
type YYTrade
    int   dir    = 0
    float entry  = na
    float sl     = na
    float tp1    = na
    float tp2    = na
    float tp3    = na
    float risk   = na
    float lot    = 0.0
    float rem    = 1.0
    float pnl    = 0.0
    float rAcc   = 0.0
    int   bar    = na
    int   tp1Bar = na
    bool  hit1   = false
    bool  hit2   = false
    bool  be     = false
    box   bT1    = na
    box   bT2    = na
    box   bT3    = na
    box   bSL    = na

type YYStat
    float eq    = 0.0
    float peak  = 0.0
    float dd    = 0.0
    int   n     = 0
    int   win   = 0
    int   loss  = 0
    float rSum  = 0.0
    float gw    = 0.0
    float gl    = 0.0
    int   start = na

var YYTrade yt = YYTrade.new()
var YYStat  ys = YYStat.new(eq = yyCapital, peak = yyCapital)
var int[]   yyDayK = array.new_int()
var float[] yyDayP = array.new_float()
var int[]   yyDayN = array.new_int()
var box[]   yyBoxes = array.new_box()
var label[] yyLbls  = array.new_label()

yyDist(float v) =>
    yyUnit == "$ ราคา" ? v : v * syminfo.mintick

yyCost(float lot) =>
    (yyComm + yySpread * yyContract) * lot

yyMoney(float v) =>
    (v < 0 ? "-$" : "$") + str.tostring(math.abs(v), "0.00")

yyMoneyS(float v) =>
    (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), "0.00")

yyPct(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"

yyCol(float v) =>
    v > 0 ? #00E58F : v < 0 ? #FF4D6D : #E6E9F2

yyDayKey(int t) =>
    year(t, syminfo.timezone) * 10000 + month(t, syminfo.timezone) * 100 + dayofmonth(t, syminfo.timezone)

yyTake(YYTrade t, float frac, float px) =>
    float f = math.min(frac, t.rem)
    if f > 0 and t.risk > 0
        t.pnl  := t.pnl + f * (px - t.entry) * t.dir * yyContract * t.lot
        t.rAcc := t.rAcc + f * (px - t.entry) * t.dir / t.risk
        t.rem  := t.rem - f
    f

yyClose(YYTrade t, YYStat s) =>
    float y_net = t.pnl - yyCost(t.lot)
    s.n    := s.n + 1
    s.rSum := s.rSum + t.rAcc
    if y_net > 0
        s.win := s.win + 1
        s.gw  := s.gw + y_net
    else
        s.loss := s.loss + 1
        s.gl   := s.gl - y_net
    s.eq   := s.eq + y_net
    s.peak := math.max(s.peak, s.eq)
    s.dd   := math.max(s.dd, s.peak > 0 ? (s.peak - s.eq) / s.peak * 100.0 : 0.0)
    int y_dk = yyDayKey(time)
    if array.size(yyDayK) == 0 or array.get(yyDayK, array.size(yyDayK) - 1) != y_dk
        array.push(yyDayK, y_dk)
        array.push(yyDayP, 0.0)
        array.push(yyDayN, 0)
        if array.size(yyDayK) > 7
            array.shift(yyDayK)
            array.shift(yyDayP)
            array.shift(yyDayN)
    int y_di = array.size(yyDayK) - 1
    array.set(yyDayP, y_di, array.get(yyDayP, y_di) + y_net)
    array.set(yyDayN, y_di, array.get(yyDayN, y_di) + 1)
    if not na(t.bT1)
        for y_b in array.from(t.bT1, t.bT2, t.bT3, t.bSL)
            box.set_right(y_b, bar_index)
            box.set_text(y_b, "")
        box.set_bgcolor(t.bT1, color.new(#26A69A, 88))
        box.set_bgcolor(t.bT2, color.new(#26A69A, 91))
        box.set_bgcolor(t.bT3, color.new(#26A69A, 94))
        box.set_bgcolor(t.bSL, color.new(#EF5350, 90))
        float y_xp = t.lot > 0 ? t.entry + t.dir * t.pnl / (yyContract * t.lot) : close
        array.push(yyLbls, label.new(bar_index, y_xp, yyMoneyS(y_net), style = label.style_label_left, color = y_net >= 0 ? #0F6E56 : #A32D2D, textcolor = #FFFFFF, size = size.tiny, force_overlay = true))
    t.dir := 0
    y_net

// ── engine (confirmed bars only · SL checked before TP = worst case)
bool  yyFix = yyMode == "คงที่ ($/Points)"
float yyATR = ta.atr(yyAtrLen)

// ข้อความในกล่อง TP: ✓ = ถึงแล้ว · 🎯 = จุดปิดไม้
yyTPtx(int k, float px, float entry, float lot, bool hit, int lvl) =>
    (hit ? "✓ " : "") + "TP" + str.tostring(k) + " " + str.tostring(px, format.mintick) + " · +" + yyMoney(math.abs(px - entry) * yyContract * lot) + (k == lvl ? " 🎯" : "")

int  yyLvl   = yyExit == "ปิดหมดที่ TP1" ? 1 : yyExit == "ปิดหมดที่ TP2" ? 2 : 3
bool yyScale = yyExit == "แบ่งปิด 1/3"
int  yySig   = barstate.isconfirmed ? (yyBuy ? 1 : yySell ? -1 : 0) : 0
if yySig != 0 and na(ys.start)
    ys.start := time

if yt.dir != 0 and bar_index > yt.bar
    if yyBE and yt.hit1 and not yt.be and bar_index > yt.tp1Bar
        yt.sl := yt.entry
        yt.be := true
        if not na(yt.bSL)
            box.set_top(yt.bSL, yt.entry)
            box.set_bottom(yt.bSL, yt.entry)
            box.set_text(yt.bSL, "")
            box.set_border_color(yt.bSL, #FFA726)
    bool y_slHit = yt.dir == 1 ? low <= yt.sl : high >= yt.sl
    if y_slHit
        yyTake(yt, yt.rem, yt.sl)
        yyClose(yt, ys)
    else
        bool y_h1 = yt.dir == 1 ? high >= yt.tp1 : low <= yt.tp1
        bool y_h2 = yt.dir == 1 ? high >= yt.tp2 : low <= yt.tp2
        bool y_h3 = yt.dir == 1 ? high >= yt.tp3 : low <= yt.tp3
        if y_h1 and not yt.hit1
            yt.hit1   := true
            yt.tp1Bar := bar_index
            if yyLvl == 1
                yyTake(yt, yt.rem, yt.tp1)
                yyClose(yt, ys)
            else if yyScale
                yyTake(yt, 1.0 / 3.0, yt.tp1)
        if yt.dir != 0 and y_h2 and not yt.hit2
            yt.hit2 := true
            if yyLvl == 2
                yyTake(yt, yt.rem, yt.tp2)
                yyClose(yt, ys)
            else if yyScale
                yyTake(yt, 1.0 / 3.0, yt.tp2)
        if yt.dir != 0 and y_h3 and yyLvl == 3
            yyTake(yt, yt.rem, yt.tp3)
            yyClose(yt, ys)

if yySig != 0 and (yt.dir == 0 or yyNewSig == "ปิดแล้วเข้าใหม่") and (yyFix or not na(yyATR))
    if yt.dir != 0
        yyTake(yt, yt.rem, close)
        yyClose(yt, ys)
    float y_rd = math.max(yyFix ? yyDist(yySL) : yySLatr * yyATR, syminfo.mintick)
    float y_d1 = math.max(yyFix ? yyDist(yyTP1) : yyMode == "ATR" ? yyTP1atr * yyATR : yyTP1r * y_rd, syminfo.mintick)
    float y_d2 = math.max(yyFix ? yyDist(yyTP2) : yyMode == "ATR" ? yyTP2atr * yyATR : yyTP2r * y_rd, y_d1 + syminfo.mintick)
    float y_d3 = math.max(yyFix ? yyDist(yyTP3) : yyMode == "ATR" ? yyTP3atr * yyATR : yyTP3r * y_rd, y_d2 + syminfo.mintick)
    float y_lt = yyLotMode == "Lot คงที่" ? yyLot : math.max(0.01, math.floor((ys.eq * yyRisk / 100.0) / (y_rd * yyContract) / 0.01) * 0.01)
    yt.dir    := yySig
    yt.entry  := close
    yt.sl     := close - yySig * y_rd
    yt.tp1    := close + yySig * y_d1
    yt.tp2    := close + yySig * y_d2
    yt.tp3    := close + yySig * y_d3
    yt.risk   := y_rd
    yt.lot    := ys.eq > 0 ? y_lt : 0.0
    yt.rem    := 1.0
    yt.pnl    := 0.0
    yt.rAcc   := 0.0
    yt.bar    := bar_index
    yt.tp1Bar := na
    yt.hit1   := false
    yt.hit2   := false
    yt.be     := false
    yt.bT1    := na
    yt.bT2    := na
    yt.bT3    := na
    yt.bSL    := na
    float y_tpX = yyLvl == 1 ? yt.tp1 : yyLvl == 2 ? yt.tp2 : yt.tp3
    float y_vpp = yyContract * yt.lot
    if yyBoxShow
        // กล่อง TP 3 ชั้น (เข้ม → จาง) + กล่อง SL · ขนาดตามระยะจริงของไม้นั้น
        yt.bT1 := box.new(bar_index, math.max(close, yt.tp1), bar_index + 1, math.min(close, yt.tp1), border_color = color.new(#26A69A, 40), bgcolor = color.new(#26A69A, 76), text = yyTPtx(1, yt.tp1, close, yt.lot, false, yyLvl), text_size = size.tiny, text_color = #B9F6CA, text_halign = text.align_right, text_valign = text.align_center, force_overlay = true)
        yt.bT2 := box.new(bar_index, math.max(yt.tp1, yt.tp2), bar_index + 1, math.min(yt.tp1, yt.tp2), border_color = color.new(#26A69A, 55), bgcolor = color.new(#26A69A, 84), text = yyTPtx(2, yt.tp2, close, yt.lot, false, yyLvl), text_size = size.tiny, text_color = #B9F6CA, text_halign = text.align_right, text_valign = text.align_center, force_overlay = true)
        yt.bT3 := box.new(bar_index, math.max(yt.tp2, yt.tp3), bar_index + 1, math.min(yt.tp2, yt.tp3), border_color = color.new(#26A69A, 70), bgcolor = color.new(#26A69A, 90), text = yyTPtx(3, yt.tp3, close, yt.lot, false, yyLvl), text_size = size.tiny, text_color = #B9F6CA, text_halign = text.align_right, text_valign = text.align_center, force_overlay = true)
        yt.bSL := box.new(bar_index, math.max(close, yt.sl), bar_index + 1, math.min(close, yt.sl), border_color = color.new(#EF5350, 40), bgcolor = color.new(#EF5350, 78), text = "SL " + str.tostring(yt.sl, format.mintick) + " · -" + yyMoney(y_rd * y_vpp), text_size = size.tiny, text_color = #FFCDD2, text_halign = text.align_right, text_valign = text.align_center, force_overlay = true)
        array.push(yyBoxes, yt.bT1)
        array.push(yyBoxes, yt.bT2)
        array.push(yyBoxes, yt.bT3)
        array.push(yyBoxes, yt.bSL)
        while array.size(yyBoxes) > yyBoxN * 4
            box.delete(array.shift(yyBoxes))
    if yySigLbl
        array.push(yyLbls, label.new(bar_index, yySig == 1 ? low : high, yySig == 1 ? "ซื้อ ▲" : "ขาย ▼", yloc = yySig == 1 ? yloc.belowbar : yloc.abovebar, style = yySig == 1 ? label.style_label_up : label.style_label_down, color = yySig == 1 ? #0F6E56 : #A32D2D, textcolor = #FFFFFF, size = size.tiny, force_overlay = true, tooltip = (yySig == 1 ? "ซื้อ " : "ขาย ") + str.tostring(close, format.mintick) + " · " + str.tostring(yt.lot, "0.00") + " lot\nSL " + str.tostring(yt.sl, format.mintick) + " · TP " + str.tostring(y_tpX, format.mintick)))
while array.size(yyLbls) > yyBoxN * 2
    label.delete(array.shift(yyLbls))

// ── ยืดกล่องของไม้ที่ยังถืออยู่
if yt.dir != 0 and not na(yt.bT1)
    int y_rt = barstate.islast ? bar_index + 6 : bar_index
    for y_b in array.from(yt.bT1, yt.bT2, yt.bT3, yt.bSL)
        box.set_right(y_b, y_rt)
    box.set_text(yt.bT1, yyTPtx(1, yt.tp1, yt.entry, yt.lot, yt.hit1, yyLvl))
    box.set_text(yt.bT2, yyTPtx(2, yt.tp2, yt.entry, yt.lot, yt.hit2, yyLvl))

// ── dashboard (Thai · 2 ฝั่ง)
var table yyTbl = na
if barstate.islast and yyShow
    y_sz  = yySizeTx == "กลาง" ? size.normal : yySizeTx == "เล็ก" ? size.small : size.tiny
    y_pos = yyPosTx == "ซ้ายบน" ? position.top_left : yyPosTx == "ขวาล่าง" ? position.bottom_right : yyPosTx == "ซ้ายล่าง" ? position.bottom_left : position.top_right
    color y_BG  = #0B0F1C
    color y_SEC = #16203D
    color y_SXT = #7FA8FF
    color y_MUT = #8A93B2
    color y_TXT = #E6E9F2
    float y_net    = ys.eq - yyCapital
    float y_netPct = yyCapital > 0 ? y_net / yyCapital * 100.0 : 0.0
    float y_days   = na(ys.start) ? 1.0 : math.max(1.0, (time - ys.start) / 86400000.0 * 5.0 / 7.0)
    float y_perDay = y_net / y_days
    float y_perMon = y_perDay * 21.0
    float y_wr     = ys.n > 0 ? 100.0 * ys.win / ys.n : 0.0
    float y_avgR   = ys.n > 0 ? ys.rSum / ys.n : 0.0
    float y_pf     = ys.gl > 0 ? ys.gw / ys.gl : ys.gw > 0 ? 99.0 : 0.0
    int   y_todayK = yyDayKey(time)
    int   y_nD     = array.size(yyDayK)
    bool  y_hasT   = y_nD > 0 and array.get(yyDayK, y_nD - 1) == y_todayK
    float y_todayP = y_hasT ? array.get(yyDayP, y_nD - 1) : 0.0
    int   y_todayN = y_hasT ? array.get(yyDayN, y_nD - 1) : 0
    float y_floatP = yt.dir != 0 ? yt.pnl + yt.rem * (close - yt.entry) * yt.dir * yyContract * yt.lot - yyCost(yt.lot) : 0.0
    float y_tpX    = yyLvl == 1 ? yt.tp1 : yyLvl == 2 ? yt.tp2 : yt.tp3
    float y_vpp    = yyContract * yt.lot

    string y_verdict = ys.n < 20 ? "⏳ ไม้ยังน้อย (" + str.tostring(ys.n) + " ไม้) ยังสรุปไม่ได้" : ys.eq <= 0 ? "💥 พอร์ตแตก" : y_avgR <= 0 ? "❌ ไม่คุ้ม · สัญญาณยังไม่ได้เปรียบ" : y_net <= 0 ? "❌ ไม่คุ้ม · ค่าคอม/spread กินกำไร" : y_pf < 1.1 ? "⚠️ พอใช้ · กำไรบาง" : ys.dd >= 20 ? "⚠️ พอใช้ · ขาดทุนสะสมลึก" : "✅ คุ้ม · ใช้ได้"
    color  y_vCol = ys.n < 20 ? y_MUT : str.startswith(y_verdict, "✅") ? #00E58F : str.startswith(y_verdict, "⚠") ? #FFC107 : #FF4D6D
    string y_lotTx  = yyLotMode == "Lot คงที่" ? str.tostring(yyLot, "0.00") + " lot" : str.tostring(yyRisk, "0.0#") + "% ต่อไม้"
    string y_unitTx = yyUnit == "$ ราคา" ? "$" : " pt"
    string y_setTx  = yyFix ? str.tostring(yySL, "0.###") + " / " + str.tostring(yyTP1, "0.###") + "·" + str.tostring(yyTP2, "0.###") + "·" + str.tostring(yyTP3, "0.###") + y_unitTx : yyMode == "ATR" ? str.tostring(yySLatr, "0.0#") + " / " + str.tostring(yyTP1atr, "0.0#") + "·" + str.tostring(yyTP2atr, "0.0#") + "·" + str.tostring(yyTP3atr, "0.0#") + " ATR" : str.tostring(yySLatr, "0.0#") + " ATR / " + str.tostring(yyTP1r, "0.0#") + "·" + str.tostring(yyTP2r, "0.0#") + "·" + str.tostring(yyTP3r, "0.0#") + "R"
    float  y_avgT   = ys.n > 0 ? y_net / ys.n : 0.0

    // ซ้าย = เงิน + สถิติ · ขวา = ไม้ปัจจุบัน + ตั้งค่า   ("§" = หัวข้อ)
    string[] y_lk = array.from("§💰 ผลเงิน", "ยอดเงิน", "วันนี้", "เฉลี่ย/วัน", "ต่อเดือน", "§📊 สถิติ", "ชนะ", "ลดลงสูงสุด", "Profit Factor", "เฉลี่ยต่อไม้")
    string[] y_lv = array.from("", yyMoney(ys.eq) + " (" + yyPct(y_netPct) + ")", yyMoneyS(y_todayP) + " · " + str.tostring(y_todayN) + " ไม้", yyMoneyS(y_perDay), yyMoneyS(y_perMon) + " (" + yyPct(yyCapital > 0 ? y_perMon / yyCapital * 100.0 : 0.0) + ")", "", str.tostring(math.round(y_wr)) + "% · " + str.tostring(ys.win) + "/" + str.tostring(ys.n) + " ไม้", "-" + str.tostring(ys.dd, "0.0") + "%", str.tostring(y_pf, "0.00"), yyMoneyS(y_avgT))
    color[]  y_lc = array.from(y_SXT, yyCol(y_net), yyCol(y_todayP), yyCol(y_perDay), yyCol(y_perMon), y_SXT, y_TXT, ys.dd >= 20 ? #FF4D6D : y_TXT, y_pf >= 1.1 ? #00E58F : y_pf >= 1.0 ? #FFC107 : #FF4D6D, yyCol(y_avgT))
    if yyDays and y_nD > 0
        for y_k = math.max(0, y_nD - 3) to y_nD - 1
            int y_key = array.get(yyDayK, y_k)
            int y_yy  = int(y_key / 10000)
            int y_mm  = int((y_key - y_yy * 10000) / 100)
            int y_dd  = y_key - y_yy * 10000 - y_mm * 100
            array.push(y_lk, str.format_time(timestamp(syminfo.timezone, y_yy, y_mm, y_dd, 12, 0), "EEE dd MMM", syminfo.timezone))
            array.push(y_lv, yyMoneyS(array.get(yyDayP, y_k)) + " · " + str.tostring(array.get(yyDayN, y_k)) + " ไม้")
            array.push(y_lc, yyCol(array.get(yyDayP, y_k)))
    bool y_open = yt.dir != 0
    string[] y_rk = array.from("§📍 ไม้ปัจจุบัน", "สถานะ", "เข้า", "SL", "TP1", "TP2", "TP3", "§⚙️ ตั้งค่า", "SL / TP", "ปิดไม้")
    string[] y_rv = array.from("", y_open ? (yt.dir == 1 ? "🟢 ซื้อ · " : "🔴 ขาย · ") + "ลอย " + yyMoneyS(y_floatP) : "⏳ รอสัญญาณ", y_open ? str.tostring(yt.entry, format.mintick) : "—", y_open ? str.tostring(yt.sl, format.mintick) + (yt.be ? " · ที่ทุน" : " · -" + yyMoney(math.abs(yt.entry - yt.sl) * y_vpp)) : "—", y_open ? yyTPtx(1, yt.tp1, yt.entry, yt.lot, yt.hit1, yyLvl) : "—", y_open ? yyTPtx(2, yt.tp2, yt.entry, yt.lot, yt.hit2, yyLvl) : "—", y_open ? yyTPtx(3, yt.tp3, yt.entry, yt.lot, false, yyLvl) : "—", "", y_setTx, yyExit)
    color[]  y_rc = array.from(y_SXT, y_open ? yyCol(y_floatP) : y_MUT, y_TXT, yt.be ? #FFA726 : #FF8A9B, #6FF0B5, #6FF0B5, #6FF0B5, y_SXT, y_TXT, y_TXT)

    bool y_wide = yyLayout == "กว้าง (2 ฝั่ง)"
    int  y_nL   = array.size(y_lk)
    int  y_nR   = array.size(y_rk)
    int  y_cols = y_wide ? 4 : 2
    int  y_rows = y_wide ? 2 + math.max(y_nL, y_nR) : 2 + y_nL + y_nR
    if not na(yyTbl)
        table.delete(yyTbl)
    yyTbl := table.new(y_pos, y_cols, y_rows, bgcolor = y_BG, border_color = #232B45, border_width = 1, frame_color = #232B45, frame_width = 1, force_overlay = true)
    table.cell(yyTbl, 0, 0, "YY ทดลองเงิน · ทุน " + yyMoney(yyCapital) + " · " + y_lotTx, text_color = #FFFFFF, bgcolor = #2F3654, text_size = y_sz)
    table.merge_cells(yyTbl, 0, 0, y_cols - 1, 0)
    for y_side = 0 to 1
        int y_n  = y_side == 0 ? y_nL : y_nR
        int y_c0 = y_wide ? y_side * 2 : 0
        int y_r0 = y_wide ? 1 : (y_side == 0 ? 1 : 1 + y_nL)
        for y_i = 0 to y_n - 1
            string y_k = y_side == 0 ? array.get(y_lk, y_i) : array.get(y_rk, y_i)
            string y_v = y_side == 0 ? array.get(y_lv, y_i) : array.get(y_rv, y_i)
            color  y_c = y_side == 0 ? array.get(y_lc, y_i) : array.get(y_rc, y_i)
            int    y_r = y_r0 + y_i
            if str.startswith(y_k, "§")
                table.cell(yyTbl, y_c0, y_r, str.substring(y_k, 1), text_color = y_c, bgcolor = y_SEC, text_size = y_sz, text_halign = text.align_left)
                table.cell(yyTbl, y_c0 + 1, y_r, "", bgcolor = y_SEC, text_size = y_sz)
                table.merge_cells(yyTbl, y_c0, y_r, y_c0 + 1, y_r)
            else
                table.cell(yyTbl, y_c0, y_r, y_k, text_color = y_MUT, bgcolor = y_BG, text_size = y_sz, text_halign = text.align_left)
                table.cell(yyTbl, y_c0 + 1, y_r, y_v, text_color = y_c, bgcolor = y_BG, text_size = y_sz, text_halign = text.align_right)
        if y_wide and y_n < math.max(y_nL, y_nR)
            for y_i = y_n to math.max(y_nL, y_nR) - 1
                table.cell(yyTbl, y_c0, 1 + y_i, "", bgcolor = y_BG, text_size = y_sz)
                table.cell(yyTbl, y_c0 + 1, 1 + y_i, "", bgcolor = y_BG, text_size = y_sz)
    table.cell(yyTbl, 0, y_rows - 1, y_verdict + " · จำลองจากกราฟ", text_color = y_vCol, bgcolor = #121829, text_size = y_sz, text_halign = text.align_left)
    table.merge_cells(yyTbl, 0, y_rows - 1, y_cols - 1, y_rows - 1)
else if barstate.islast and not yyShow and not na(yyTbl)
    table.delete(yyTbl)
    yyTbl := na

atrLenInput   = input.int(13, "ATR Length", minval = 2, maxval = 50, group = GRP_FILT)
useRSIInput   = input.bool(true, "RSI OB/OS", group = GRP_FILT)
rsiLenInput   = input.int(14, "RSI Length", minval = 2, maxval = 50, group = GRP_FILT)
rsiOBInput    = input.int(70, "RSI Overbought", minval = 50, maxval = 95, group = GRP_FILT)

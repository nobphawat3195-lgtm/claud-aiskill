baseMaxInput    = input.int(3, "Max Base Candles", minval = 1, maxval = 6, group = GRP_ZONE)
maxZonesInput   = input.int(4, "Max Zones per Side", minval = 1, maxval = 10, group = GRP_ZONE)
showStarsInput  = input.bool(true, "Show Star Rating", group = GRP_ZONE, tooltip = "★ base · ★ strong departure (≥2 ATR) · ★ tight base (≤2 candles) · ★ with EMA trend · ★ volume spike (or thin zone when no volume).\nA touched zone loses one star.")

// ── MTF
mtfTF1Input = input.timeframe("15", "TF 1", group = GRP_MTF)
mtfTF2Input = input.timeframe("60", "TF 2", group = GRP_MTF)
mtfTF3Input = input.timeframe("240", "TF 3", group = GRP_MTF)

// ── Dashboard
showDashInput   = input.bool(true, "Show Dashboard", group = GRP_DASH)
deviceInput     = input.string("PC", "Layout", options = ["PC", "iPad", "Mobile"], group = GRP_DASH, tooltip = "YY_SMC_PRO panel.\nPC: + ADX / Block / money detail rows · iPad: small font · Mobile: tiny font, core rows.")
dashPosStr      = input.string("Top Right", "Position", options = ["Top Left", "Top Right", "Bottom Left", "Bottom Right", "Middle Right"], group = GRP_DASH)
dashFontInput   = input.string("Small", "PC Font Size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_DASH)
showKzInput     = input.bool(true, "Kill Zone Countdown", group = GRP_DASH)
kzTzInput       = input.string("America/New_York", "Kill Zone Timezone", group = GRP_DASH, tooltip = "IANA timezone, DST handled automatically.")
asiaKzInput     = input.session("2000-0000", "Asia KZ", group = GRP_DASH)
londonKzInput   = input.session("0200-0500", "London KZ", group = GRP_DASH)

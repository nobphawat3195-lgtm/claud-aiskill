scalpTPInput    = input.float(1.0, "Scalp TP1 (x ATR)", minval = 0.3, maxval = 5.0, step = 0.1, group = GRP_SCALP, tooltip = "TP2 = 1.5x, TP3 = 2x of this.")

// ── Signals
ignoreActiveInput = input.bool(true, "Ignore Signals While Trade Active", group = GRP_SIG)

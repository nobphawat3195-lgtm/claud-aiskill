// ── Money Simulator
moneyOnInput    = input.bool(false, "เปิดโหมดจำลองเงินทุน", group = GRP_MONEY, tooltip = "Simulates trading every signal on the loaded chart history.\nShown on the dashboard and on TP/SL labels.\n⚠ Simulation only — not a broker backtest, no slippage modelling.")
capitalInput    = input.float(300.0, "เงินทุน (USD)", minval = 1.0, step = 10.0, group = GRP_MONEY)
sizeModeInput   = input.string("Risk %", "ขนาดไม้", options = ["Risk %", "Fixed Lot"], group = GRP_MONEY)
riskPctInput    = input.float(1.0, "Risk % ต่อไม้", minval = 0.1, maxval = 20.0, step = 0.1, group = GRP_MONEY)
fixLotInput     = input.float(0.01, "Fixed Lot", minval = 0.01, step = 0.01, group = GRP_MONEY)
compoundInput   = input.bool(true, "ทบต้น (Risk % คิดจากยอดเงินล่าสุด)", group = GRP_MONEY)
contractInput   = input.float(100.0, "Contract Size (oz / lot)", minval = 1.0, group = GRP_MONEY, tooltip = "XAUUSD standard: 1 lot = 100 oz → $1 move = $100 per lot.")
minLotInput     = input.float(0.01, "Min Lot", minval = 0.001, step = 0.01, group = GRP_MONEY)
lotStepInput    = input.float(0.01, "Lot Step", minval = 0.001, step = 0.01, group = GRP_MONEY)
commLotInput    = input.float(7.0, "ค่าคอม $/lot (ไป-กลับ)", minval = 0.0, step = 0.5, group = GRP_MONEY)
spreadPxInput   = input.float(0.20, "Spread (ราคา $)", minval = 0.0, step = 0.05, group = GRP_MONEY)

// ── Colors
bullColorInput   = input.color(#00E676, "Bull", inline = "c1", group = GRP_COL)
bearColorInput   = input.color(#FF5252, "Bear", inline = "c1", group = GRP_COL)
emaFastColor     = input.color(#FFC940, "EMA Fast", inline = "c2", group = GRP_COL)
emaSlowColor     = input.color(#5C8AFF, "EMA Slow", inline = "c2", group = GRP_COL)
demandColorInput = input.color(#26A69A, "Demand", inline = "c3", group = GRP_COL)
supplyColorInput = input.color(#EF5350, "Supply", inline = "c3", group = GRP_COL)

// ── Alerts
webhookInput = input.bool(false, "Webhook JSON Format", group = GRP_ALERT)

// ══════════════════════════════════════
// THEME
// ══════════════════════════════════════
isDark = switch themeInput
    "Dark"  => true
    "Light" => false
    => color.r(chart.bg_color) < 128

TEXT_COLOR   = isDark ? #E6E9F2 : #1A1A1A
TEXT_MUTED   = isDark ? #8A93B2 : #6B7280
TABLE_BG     = isDark ? #0B0F1C : #FFFFFF
ROW_ALT      = isDark ? #121829 : #F2F5FA
TABLE_BORDER = isDark ? #232B45 : #D5DAE3
HEADER_BULL  = #0F6E56
HEADER_BEAR  = #A32D2D
HEADER_NEU   = #2F3654
HEADER_TEXT  = #FFFFFF
BULL_TEXT    = isDark ? #00E58F : #00A152
BEAR_TEXT    = isDark ? #FF4D6D : #D32F2F
NEU_TEXT     = isDark ? #FFC107 : #B26A00
SL_COLOR     = isDark ? #E57373 : #B71C1C
TP1_COLOR    = isDark ? color.new(#66BB6A, 30) : color.new(#388E3C, 30)
TP2_COLOR    = isDark ? color.new(#66BB6A, 40) : color.new(#388E3C, 40)
TP3_COLOR    = isDark ? #66BB6A : #388E3C
ENTRY_COLOR  = isDark ? #5C8AAE : #34495E
TP_LBL_COLOR = isDark ? #66BB6A : #388E3C
TP_HIT_COLOR = isDark ? #4DB6AC : #00695C
BE_COLOR     = isDark ? #FFA726 : #E65100
RISK_TEXT    = isDark ? #1A1A1A : #FFFFFF
FORM_COLOR   = isDark ? #5C8AAE : #34495E
LABEL_TEXT   = #FFFFFF
BLOCK_COLOR  = isDark ? #5A6280 : #9AA0B0

// ══════════════════════════════════════
// FUNCTIONS
// ══════════════════════════════════════
safeDiv(float num, float den, float fallback = 0.0) =>
    den != 0 and not na(num) and not na(den) ? num / den : fallback

buildGauge(float value, float maxVal, int width) =>
    string result = ""
    int filled = maxVal <= 0 ? 0 : math.round(math.min(width, math.max(0.0, value / maxVal * width)))
    for i = 0 to width - 1
        result += i < filled ? "▰" : "▱"
    result

fmtPrice(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

fmtR(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.00") + "R"

fmtUsdS(float v) =>
    (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), "0.00")

fmtUsd(float v) =>
    (v < 0 ? "-$" : "$") + str.tostring(math.abs(v), "0.00")

fmtPctS(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"

pctFromEntry(float level, float entry) =>
    string res = ""
    if showPctInput and not na(level) and not na(entry) and entry != 0
        float pct = (level - entry) / entry * 100.0
        res := " (" + (pct >= 0 ? "+" : "") + str.tostring(pct, "0.00") + "%)"
    res

sizeFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

sizeDown(string s) =>
    s == "Large" ? size.normal : s == "Normal" ? size.small : size.tiny

tfName(string s) =>
    float n = str.tonumber(s)
    na(n) ? s : n >= 60 and n % 60 == 0 ? "H" + str.tostring(math.round(n / 60)) : "M" + s

stateArrow(int st, bool valid) =>
    not valid ? "⚠" : st == 1 ? "▲" : st == -1 ? "▼" : "•"

stateColor(int st, bool valid) =>
    not valid ? NEU_TEXT : st == 1 ? BULL_TEXT : st == -1 ? BEAR_TEXT : TEXT_MUTED

zoneText(int d, int stars, bool tested) =>
    string base = d == 1 ? "DEMAND" : "SUPPLY"
    string st = showStarsInput ? " " + str.repeat("★", stars) + str.repeat("☆", 5 - stars) : ""
    base + st + (tested ? " · tested" : "")

signalSize = sizeFromString(signalSizeInput)
labelSize  = sizeFromString(labelSizeInput)


// ══════════════════════════════════════
// TYPES — trade, stats, money, drawing record
// ══════════════════════════════════════
type Trade
    int    dir      = 0
    float  entry    = na
    float  sl       = na
    float  tp1      = na
    float  tp2      = na
    float  tp3      = na
    float  risk     = na
    int    entryBar = na
    int    closeBar = na
    bool   tp1Hit   = false
    bool   tp2Hit   = false
    bool   tp3Hit   = false
    bool   be       = false
    string src      = ""
    float  lot      = 0.0
    float  realized = 0.0
    float  rAcc     = 0.0
    float  rem      = 1.0

type Stats
    int    closed   = 0
    int    replaced = 0
    int    tp1Cnt   = 0
    int    tp2Cnt   = 0
    int    tp3Cnt   = 0
    int    slCnt    = 0
    float  rSum     = 0.0
    string form     = ""
    string lastExit = ""
    float  lastR    = 0.0

type Money
    float equity  = 0.0
    float peak    = 0.0
    float maxDD   = 0.0
    int   wins    = 0
    int   losses  = 0
    float lastPnl = 0.0
    float best    = 0.0
    float worst   = 0.0
    bool  bust    = false

type Rec
    line  eL
    line  sL
    line  t1L
    line  t2L
    line  t3L
    label eLb
    label sLb
    label t1Lb
    label t2Lb
    label t3Lb
    int   sOff  = 0
    int   t1Off = 0

var Trade T = Trade.new()
var Stats S = Stats.new()
var Money M = Money.new(equity = capitalInput, peak = capitalInput)
var Rec   R = Rec.new()

// Close a fraction of the position at a price (R model + money model)
realize(Trade t, float frac, float px) =>
    float f = math.min(frac, t.rem)
    if f > 0 and not na(t.risk) and t.risk > 0
        t.rAcc     := t.rAcc + f * (px - t.entry) * t.dir / t.risk
        t.realized := t.realized + f * (px - t.entry) * t.dir * contractInput * t.lot
        t.rem      := t.rem - f
    f

tradeCost(float lot) =>
    (commLotInput + spreadPxInput * contractInput) * lot

pushForm(Stats s, bool ok) =>
    s.form := s.form + (ok ? "▰" : "▱")
    if str.length(s.form) > FORM_LEN
        s.form := str.substring(s.form, str.length(s.form) - FORM_LEN)

// Book a fully closed trade into Stats + Money, returns net $
finalizeTrade(Trade t, Stats s, Money m, string how) =>
    s.closed := s.closed + 1
    s.tp1Cnt := s.tp1Cnt + (t.tp1Hit ? 1 : 0)
    s.tp2Cnt := s.tp2Cnt + (t.tp2Hit ? 1 : 0)
    if how == "TP3"
        s.tp3Cnt := s.tp3Cnt + 1
    if how == "SL" or how == "BE"
        s.slCnt := s.slCnt + 1
    if how == "REPL"
        s.replaced := s.replaced + 1
    s.rSum     := s.rSum + t.rAcc
    s.lastR    := t.rAcc
    s.lastExit := how
    pushForm(s, t.tp1Hit)
    float net = t.realized - tradeCost(t.lot)
    if not m.bust
        m.equity  := m.equity + net
        m.lastPnl := net
        if net >= 0
            m.wins := m.wins + 1
        else
            m.losses := m.losses + 1
        m.best  := math.max(m.best, net)
        m.worst := math.min(m.worst, net)
        m.peak  := math.max(m.peak, m.equity)
        float dd = m.peak > 0 ? (m.peak - m.equity) / m.peak * 100.0 : 0.0
        m.maxDD := math.max(m.maxDD, dd)
        if m.equity <= 0
            m.bust := true
    t.dir      := 0
    t.closeBar := bar_index
    net

calcLot(float riskPx, float eq) =>
    float raw = sizeModeInput == "Fixed Lot" ? fixLotInput : (eq * riskPctInput / 100.0) / math.max(riskPx * contractInput, 1e-10)
    float stepped = math.floor(raw / lotStepInput) * lotStepInput
    math.max(minLotInput, stepped)

openTrade(Trade t, int d, float px, float sl, float rd, float tp1, float tp2, float tp3, float lot, string src) =>
    t.dir      := d
    t.entry    := px
    t.sl       := sl
    t.risk     := rd
    t.tp1      := tp1
    t.tp2      := tp2
    t.tp3      := tp3
    t.entryBar := bar_index
    t.closeBar := na
    t.tp1Hit   := false
    t.tp2Hit   := false
    t.tp3Hit   := false
    t.be       := false
    t.src      := src
    t.lot      := lot
    t.realized := 0.0
    t.rAcc     := 0.0
    t.rem      := 1.0

deleteRec(Rec r) =>
    line.delete(r.eL)
    line.delete(r.sL)
    line.delete(r.t1L)
    line.delete(r.t2L)
    line.delete(r.t3L)
    label.delete(r.eLb)
    label.delete(r.sLb)
    label.delete(r.t1Lb)
    label.delete(r.t2Lb)
    label.delete(r.t3Lb)
    r.eL   := na
    r.sL   := na
    r.t1L  := na
    r.t2L  := na
    r.t3L  := na
    r.eLb  := na
    r.sLb  := na
    r.t1Lb := na
    r.t2Lb := na
    r.t3Lb := na


// ══════════════════════════════════════
// CORE CALCULATIONS
// ══════════════════════════════════════
bool isWarmedUp = bar_index >= WARMUP

float emaFast = ta.ema(close, emaFastInput)
float emaSlow = ta.ema(close, emaSlowInput)
bool  crossUp   = ta.crossover(emaFast, emaSlow)
bool  crossDown = ta.crossunder(emaFast, emaSlow)

float atrBase = nz(ta.atr(atrLenInput), 0.0)
[diPlus, diMinus, adxRaw] = ta.dmi(adxLenInput, adxLenInput)
float adx    = nz(adxRaw, 0.0)
float adxAvg = nz(ta.sma(adx, tsfLookInput), adx)
float tsf    = adxAvg > 0 ? adx / adxAvg : 1.0

[stLine, stDirPine] = ta.supertrend(stFactorInput, atrLenInput)
int stDir = stDirPine < 0 ? 1 : -1      // 1 = up (Pine returns -1 for uptrend)

[bbMid, bbUp, bbLo] = ta.bb(close, 20, 2.0)
float bbw = bbMid != 0 ? (bbUp - bbLo) / bbMid : 0.0
float rsi = ta.rsi(close, rsiLenInput)

float swingLo = ta.lowest(low, swingLenInput)
float swingHi = ta.highest(high, swingLenInput)
float rangeHi = ta.highest(high, scalpRangeInput)
float rangeLo = ta.lowest(low, scalpRangeInput)

bool  hasVolume = nz(volume, 0) > 0
float volSmaRaw = ta.sma(nz(volume, 0), 20)
float volSma    = hasVolume ? nz(volSmaRaw, 0.0) : 0.0

// ── Auto sensitivity (YOUNGYUU v4 table)
float tfMin = timeframe.in_seconds() / 60.0
float adxThr = not autoSensInput ? adxManualInput : tfMin <= 1 ? 13.0 : tfMin <= 3 ? 14.0 : tfMin <= 5 ? 15.0 : tfMin <= 15 ? 17.0 : tfMin <= 30 ? 19.0 : tfMin <= 60 ? 21.0 : tfMin <= 240 ? 23.0 : 25.0
float bbwThr = not autoSensInput ? bbwManualInput : tfMin <= 1 ? 0.002 : tfMin <= 3 ? 0.003 : tfMin <= 5 ? 0.004 : tfMin <= 15 ? 0.006 : tfMin <= 30 ? 0.007 : tfMin <= 60 ? 0.008 : tfMin <= 240 ? 0.010 : 0.012

// ── Regime (YOUNGYUU v4)
bool adxOk   = adx >= adxThr
bool bbwOk   = bbw >= bbwThr
bool tsfPass = not useTSFInput or tsf >= tsfMinInput
bool strongTrend = adxOk and bbwOk and tsfPass
bool weakTrend   = (adxOk or tsfPass) and not strongTrend
bool sideways    = not adxOk and not tsfPass
string regimeStr = strongTrend ? "STRONG" : weakTrend ? "WEAK" : "SIDEWAYS"
color  regimeCol = strongTrend ? BULL_TEXT : weakTrend ? NEU_TEXT : BEAR_TEXT

// ── Trend state (for dashboard / zones)
bool trendBull = emaFast > emaSlow and stDir == 1
bool trendBear = emaFast < emaSlow and stDir == -1
string trendState = trendBull ? "Bullish" : trendBear ? "Bearish" : "Neutral"

// ══════════════════════════════════════
// MTF — EMA state on higher timeframes (closed HTF bars)
// ══════════════════════════════════════
mtfCalcState() =>
    float f = ta.ema(close, emaFastInput)
    float s = ta.ema(close, emaSlowInput)
    int st = f > s and close > s ? 1 : f < s and close < s ? -1 : 0
    st

bool mtf1Valid = timeframe.in_seconds(mtfTF1Input) >= timeframe.in_seconds()
bool mtf2Valid = timeframe.in_seconds(mtfTF2Input) >= timeframe.in_seconds()
bool mtf3Valid = timeframe.in_seconds(mtfTF3Input) >= timeframe.in_seconds()

int mtf1Raw = nz(request.security(syminfo.tickerid, mtfTF1Input, mtfCalcState()[1], barmerge.gaps_off, barmerge.lookahead_on), 0)
int mtf2Raw = nz(request.security(syminfo.tickerid, mtfTF2Input, mtfCalcState()[1], barmerge.gaps_off, barmerge.lookahead_on), 0)
int mtf3Raw = nz(request.security(syminfo.tickerid, mtfTF3Input, mtfCalcState()[1], barmerge.gaps_off, barmerge.lookahead_on), 0)

int mtf1State = mtf1Valid ? mtf1Raw : 0
int mtf2State = mtf2Valid ? mtf2Raw : 0
int mtf3State = mtf3Valid ? mtf3Raw : 0
bool mtfAllValid = mtf1Valid and mtf2Valid and mtf3Valid
int  mtfSum      = mtf1State + mtf2State + mtf3State
bool mtfAllBull  = mtfAllValid and mtfSum == 3
bool mtfAllBear  = mtfAllValid and mtfSum == -3

// ══════════════════════════════════════
// FILTERS & SIGNALS
// ══════════════════════════════════════
inSession(string sess) =>
    not na(time(timeframe.period, sess, "UTC"))

// ── Signal Mode → effective filter switches
bool modeFilt = signalModeInput == "Filtered"
bool modeAdx  = signalModeInput == "ADX Only"
bool modePure = signalModeInput == "Pure EMA Cross"
bool eADX    = modeFilt ? useADXInput : modeAdx
bool eDI     = modeFilt and useDIInput
bool eRising = modeFilt and useRisingInput
bool eStrong = modeFilt and strongOnlyInput
bool eST     = modeFilt and useSTInput
bool eRSI    = modeFilt and useRSIInput
bool eBody   = modeFilt and useBodyInput
bool eMom    = modeFilt and useMomInput
bool eHTF    = modeFilt and useHTFInput
bool eSess   = modeFilt and useSessInput
bool eScalp  = modeFilt and useScalpInput
bool eMaxSL  = not modePure and maxSlAtrInput > 0
string modeTag = modeFilt ? "" : modeAdx ? " · ADX ONLY" : " · PURE"

bool  sessOK   = not eSess or inSession(londonInput) or inSession(nyInput)
float bodyRat  = atrBase > 0 ? math.abs(close - open) / atrBase : 0.0
float bodyMin  = tfMin <= 5 ? 0.05 : tfMin <= 15 ? 0.08 : 0.12
bool  momBuy   = tfMin <= 5 ? close > close[1] : close > close[1] and close[1] > close[2]
bool  momSell  = tfMin <= 5 ? close < close[1] : close < close[1] and close[1] < close[2]
float rangeMid = (rangeHi + rangeLo) / 2.0
float rangeSz  = rangeHi - rangeLo
bool  scalpBuyZone  = close < rangeMid - rangeSz * 0.15
bool  scalpSellZone = close > rangeMid + rangeSz * 0.15

// filter states: 1 = pass, 0 = fail, -1 = off
fstate(bool enabled, bool ok) =>
    enabled ? (ok ? 1 : 0) : -1

int fAdxB  = fstate(eADX, adxOk)
int fDiB   = fstate(eDI, diPlus > diMinus)
int fRisB  = fstate(eRising, adx > nz(adx[1], adx))
int fStrB  = fstate(eStrong, strongTrend)
int fStB   = fstate(eST, stDir == 1)
int fRsiB  = fstate(eRSI, rsi < rsiOBInput)
int fBodyB = fstate(eBody, bodyRat >= bodyMin)
int fMomB  = fstate(eMom, momBuy)
int fHtfB  = fstate(eHTF, mtf1State == 1)
int fSesB  = fstate(eSess, sessOK)

int fAdxS  = fAdxB
int fDiS   = fstate(eDI, diMinus > diPlus)
int fRisS  = fRisB
int fStrS  = fStrB
int fStS   = fstate(eST, stDir == -1)
int fRsiS  = fstate(eRSI, rsi > rsiOSInput)
int fBodyS = fBodyB
int fMomS  = fstate(eMom, momSell)
int fHtfS  = fstate(eHTF, mtf1State == -1)
int fSesS  = fSesB

countPass(int a, int b, int c, int d, int e, int g, int h, int i, int j, int k) =>
    int p = (a == 1 ? 1 : 0) + (b == 1 ? 1 : 0) + (c == 1 ? 1 : 0) + (d == 1 ? 1 : 0) + (e == 1 ? 1 : 0) + (g == 1 ? 1 : 0) + (h == 1 ? 1 : 0) + (i == 1 ? 1 : 0) + (j == 1 ? 1 : 0) + (k == 1 ? 1 : 0)
    p

countOn(int a, int b, int c, int d, int e, int g, int h, int i, int j, int k) =>
    int n = (a >= 0 ? 1 : 0) + (b >= 0 ? 1 : 0) + (c >= 0 ? 1 : 0) + (d >= 0 ? 1 : 0) + (e >= 0 ? 1 : 0) + (g >= 0 ? 1 : 0) + (h >= 0 ? 1 : 0) + (i >= 0 ? 1 : 0) + (j >= 0 ? 1 : 0) + (k >= 0 ? 1 : 0)
    n

int passB  = countPass(fAdxB, fDiB, fRisB, fStrB, fStB, fRsiB, fBodyB, fMomB, fHtfB, fSesB)
int totalB = countOn(fAdxB, fDiB, fRisB, fStrB, fStB, fRsiB, fBodyB, fMomB, fHtfB, fSesB)
int passS  = countPass(fAdxS, fDiS, fRisS, fStrS, fStS, fRsiS, fBodyS, fMomS, fHtfS, fSesS)
int totalS = countOn(fAdxS, fDiS, fRisS, fStrS, fStS, fRsiS, fBodyS, fMomS, fHtfS, fSesS)

float bullScore = totalB > 0 ? 100.0 * passB / totalB : 100.0
float bearScore = totalS > 0 ? 100.0 * passS / totalS : 100.0

// first failing filter → human-readable reason
blockReason(int adxS, int diS, int risS, int strS, int stS, int rsiS, int bodyS, int momS, int htfS, int sesS, bool isBuy) =>
    adxS == 0 ? "ADX " + str.tostring(adx, "0.0") + " < " + str.tostring(adxThr, "0") : diS == 0 ? (isBuy ? "DI+ < DI-" : "DI- < DI+") : risS == 0 ? "ADX falling" : strS == 0 ? "Regime " + regimeStr : stS == 0 ? "Supertrend against" : rsiS == 0 ? (isBuy ? "RSI OB " : "RSI OS ") + str.tostring(rsi, "0.0") : bodyS == 0 ? "Body weak " + str.tostring(bodyRat, "0.00") : momS == 0 ? "Momentum fail" : htfS == 0 ? "HTF against" : sesS == 0 ? "Out of session" : ""

bool allBuy  = passB == totalB
bool allSell = passS == totalS

bool trendBuy  = crossUp and allBuy
bool trendSell = crossDown and allSell
bool scalpBuy  = eScalp and sideways and crossUp and scalpBuyZone and fStB != 0 and fRsiB != 0
bool scalpSell = eScalp and sideways and crossDown and scalpSellZone and fStS != 0 and fRsiS != 0

// SL / TP pre-check (skip signals whose stop is too wide)
calcSL(bool isLong, float entry, bool scalp) =>
    float lvl = scalp ? (isLong ? entry - scalpSLInput * atrBase : entry + scalpSLInput * atrBase) : slModeInput == "Swing" ? (isLong ? swingLo - slBufferInput * atrBase : swingHi + slBufferInput * atrBase) : slModeInput == "ATR" ? (isLong ? entry - slAtrInput * atrBase : entry + slAtrInput * atrBase) : (isLong ? entry - slPointsInput * syminfo.mintick : entry + slPointsInput * syminfo.mintick)
    bool wrongSide = isLong ? lvl >= entry : lvl <= entry
    if wrongSide
        lvl := isLong ? entry - slAtrInput * atrBase : entry + slAtrInput * atrBase
    float minD = atrBase * minSlAtrInput
    if math.abs(entry - lvl) < minD
        lvl := isLong ? entry - minD : entry + minD
    lvl

bool buyRaw  = (trendBuy or scalpBuy) and barstate.isconfirmed and isWarmedUp and atrBase > 0
bool sellRaw = (trendSell or scalpSell) and barstate.isconfirmed and isWarmedUp and atrBase > 0
bool isScalpB = scalpBuy and not trendBuy
bool isScalpS = scalpSell and not trendSell

float slBuyChk  = calcSL(true, close, isScalpB)
float slSellChk = calcSL(false, close, isScalpS)
bool  wideBuy   = eMaxSL and atrBase > 0 and math.abs(close - slBuyChk) / atrBase > maxSlAtrInput
bool  wideSell  = eMaxSL and atrBase > 0 and math.abs(slSellChk - close) / atrBase > maxSlAtrInput

bool confirmedBuy  = buyRaw and not wideBuy
bool confirmedSell = sellRaw and not wideSell and not confirmedBuy

// blocked cross (for ✕ marker / dashboard)
bool crossBlockedUp   = crossUp and barstate.isconfirmed and isWarmedUp and not confirmedBuy
bool crossBlockedDown = crossDown and barstate.isconfirmed and isWarmedUp and not confirmedSell
string reasonUp   = wideBuy and buyRaw ? "SL too wide" : blockReason(fAdxB, fDiB, fRisB, fStrB, fStB, fRsiB, fBodyB, fMomB, fHtfB, fSesB, true)
string reasonDown = wideSell and sellRaw ? "SL too wide" : blockReason(fAdxS, fDiS, fRisS, fStrS, fStS, fRsiS, fBodyS, fMomS, fHtfS, fSesS, false)

var string lastBlock = ""
if crossBlockedUp
    lastBlock := "▲ " + reasonUp
if crossBlockedDown
    lastBlock := "▼ " + reasonDown

string buyGrade  = isScalpB ? "SCALP" : strongTrend ? "STRONG" : "WEAK"
string sellGrade = isScalpS ? "SCALP" : strongTrend ? "STRONG" : "WEAK"

tpDistances(bool scalp, float slDist) =>
    float m1 = scalp ? scalpTPInput : tp1AtrInput
    float m2 = scalp ? scalpTPInput * 1.5 : tp2AtrInput
    float m3 = scalp ? scalpTPInput * 2.0 : tp3AtrInput
    float d1 = math.max(m1 * atrBase, slDist * rrMinInput)
    float d2 = math.max(m2 * atrBase, d1 * 1.5)
    float d3 = math.max(m3 * atrBase, d2 * 1.3)
    [d1, d2, d3]

float labelOffset = atrBase * 0.5

// Grade A / B / C (YY_SMC_PRO style): A = STRONG regime + ≥2 HTF agree · B = one of them · C = neither
gradeFor(int d) =>
    int al = d == 1 ? mtfSum : -mtfSum
    strongTrend and al >= 2 ? "A" : strongTrend or al >= 2 ? "B" : "C"

// ══════════════════════════════════════
// TRADE ENGINE
// ══════════════════════════════════════
var int tp1PrevBar = 0
bool tp1Prev = tp1PrevBar == 1

bool  canOpen     = T.dir == 0 or not ignoreActiveInput
bool  evBuyEntry  = false
bool  evSellEntry = false
bool  evClosed    = false
float evNet       = na
float evR         = na
float evExitPx    = na
bool  evTP1 = false
bool  evTP2 = false
bool  evTP3 = false
bool  evSL  = false
bool  evBE  = false

if (confirmedBuy or confirmedSell) and showTPSLInput and canOpen
    int  nd  = confirmedBuy ? 1 : -1
    bool scl = nd == 1 ? isScalpB : isScalpS
    if T.dir != 0
        realize(T, T.rem, close)
        evNet    := finalizeTrade(T, S, M, "REPL")
        evR      := S.lastR
        evExitPx := close
        evClosed := true
    float sl0 = nd == 1 ? slBuyChk : slSellChk
    float rd  = math.max(math.abs(close - sl0), syminfo.mintick)
    [d1, d2, d3] = tpDistances(scl, rd)
    float eqB  = compoundInput ? M.equity : capitalInput
    float lot0 = M.bust ? 0.0 : calcLot(rd, eqB)
    openTrade(T, nd, close, sl0, rd, close + nd * d1, close + nd * d2, close + nd * d3, lot0, scl ? "S" : gradeFor(nd))
    if nd == 1
        evBuyEntry := true
    else
        evSellEntry := true

// tracking starts on the bar AFTER entry; SL checked before TP (worst case)
bool canTrack = T.dir != 0 and not na(T.entryBar) and bar_index > T.entryBar
if canTrack
    if beInput and tp1Prev and not T.be
        T.sl := T.entry
        T.be := true
        evBE := true
    bool slTouch = T.dir == 1 ? low <= T.sl : high >= T.sl
    if slTouch
        float px = T.sl
        bool wasBE = T.be
        realize(T, T.rem, px)
        evNet    := finalizeTrade(T, S, M, wasBE ? "BE" : "SL")
        evR      := S.lastR
        evExitPx := px
        evClosed := true
        evSL     := true
    else
        bool hit1 = T.dir == 1 ? high >= T.tp1 : low <= T.tp1
        bool hit2 = T.dir == 1 ? high >= T.tp2 : low <= T.tp2
        bool hit3 = T.dir == 1 ? high >= T.tp3 : low <= T.tp3
        if hit1 and not T.tp1Hit
            T.tp1Hit := true
            realize(T, 1.0 / 3.0, T.tp1)
            evTP1 := true
        if hit2 and not T.tp2Hit
            T.tp2Hit := true
            realize(T, 1.0 / 3.0, T.tp2)
            evTP2 := true
        if hit3 and not T.tp3Hit
            T.tp3Hit := true
            float px3 = T.tp3
            realize(T, T.rem, px3)
            evNet    := finalizeTrade(T, S, M, "TP3")
            evR      := S.lastR
            evExitPx := px3
            evClosed := true
            evTP3    := true

tp1PrevBar := T.tp1Hit and T.dir != 0 ? 1 : 0

// ══════════════════════════════════════
// STATE
// ══════════════════════════════════════
var string lastSignal    = "None"
var int    lastSignalBar = 0
if confirmedBuy
    lastSignal := "Long"
    lastSignalBar := bar_index
if confirmedSell
    lastSignal := "Short"
    lastSignalBar := bar_index

// ══════════════════════════════════════
// PLOTS & SIGNAL LABELS
// ══════════════════════════════════════
plot(showEmaInput ? emaFast : na, "EMA Fast", color = emaFastColor, linewidth = 1)
plot(showEmaInput ? emaSlow : na, "EMA Slow", color = emaSlowColor, linewidth = 2)

string moneyTip = moneyOnInput and (evBuyEntry or evSellEntry) ? "\nLot " + str.tostring(T.lot, "0.00") + " · Risk " + fmtUsd(T.risk * contractInput * T.lot) : ""

if confirmedBuy and showSignalsInput
    string txtB = (isScalpB ? "SCALP ▲" : "LONG") + (showScoreInput ? " " + str.tostring(passB) + "/" + str.tostring(totalB) : "")
    label.new(bar_index, low - labelOffset, txtB, color = bullColorInput, textcolor = LABEL_TEXT, style = label.style_label_up, size = signalSize, tooltip = "EMA " + str.tostring(emaFastInput) + "/" + str.tostring(emaSlowInput) + " cross ▲ | " + buyGrade + "\nADX " + str.tostring(adx, "0.0") + " (thr " + str.tostring(adxThr, "0") + ") · DI+ " + str.tostring(diPlus, "0.0") + " / DI- " + str.tostring(diMinus, "0.0") + "\nRSI " + str.tostring(rsi, "0.0") + " · Regime " + regimeStr + (evBuyEntry ? moneyTip : ""))
if confirmedSell and showSignalsInput
    string txtS = (isScalpS ? "SCALP ▼" : "SHORT") + (showScoreInput ? " " + str.tostring(passS) + "/" + str.tostring(totalS) : "")
    label.new(bar_index, high + labelOffset, txtS, color = bearColorInput, textcolor = LABEL_TEXT, style = label.style_label_down, size = signalSize, tooltip = "EMA " + str.tostring(emaFastInput) + "/" + str.tostring(emaSlowInput) + " cross ▼ | " + sellGrade + "\nADX " + str.tostring(adx, "0.0") + " (thr " + str.tostring(adxThr, "0") + ") · DI+ " + str.tostring(diPlus, "0.0") + " / DI- " + str.tostring(diMinus, "0.0") + "\nRSI " + str.tostring(rsi, "0.0") + " · Regime " + regimeStr + (evSellEntry ? moneyTip : ""))

if crossBlockedUp and showBlockedInput
    label.new(bar_index, low - labelOffset, "✕", style = label.style_none, textcolor = BLOCK_COLOR, size = size.small, tooltip = "Blocked BUY cross: " + reasonUp)
if crossBlockedDown and showBlockedInput
    label.new(bar_index, high + labelOffset, "✕", style = label.style_none, textcolor = BLOCK_COLOR, size = size.small, tooltip = "Blocked SELL cross: " + reasonDown)

// ══════════════════════════════════════
// TP / SL RECORD
// ══════════════════════════════════════
bool evEntry = evBuyEntry or evSellEntry
usdTag(float priceMove, float frac) =>
    moneyOnInput ? " · " + fmtUsdS(priceMove * contractInput * T.lot * frac) : ""

if evEntry and showTPSLInput
    deleteRec(R)
    int x1 = bar_index
    int x2 = bar_index + LINE_FWD
    int lx = x2 + LBL_OFF
    float near = atrBase * 0.45
    R.sOff  := math.abs(T.sl - T.entry) < near ? LBL_STAG : 0
    R.t1Off := math.abs(T.tp1 - T.entry) < near ? LBL_STAG : 0
    R.eL  := line.new(x1, T.entry, x2, T.entry, color = ENTRY_COLOR, style = line.style_dotted, width = 1)
    R.sL  := line.new(x1, T.sl,  x2, T.sl,  color = SL_COLOR,  style = line.style_solid,  width = 2)
    R.t1L := line.new(x1, T.tp1, x2, T.tp1, color = TP1_COLOR, style = line.style_dashed, width = 1)
    R.t2L := line.new(x1, T.tp2, x2, T.tp2, color = TP2_COLOR, style = line.style_dashed, width = 1)
    R.t3L := line.new(x1, T.tp3, x2, T.tp3, color = TP3_COLOR, style = line.style_dashed, width = 1)
    string lotTxt = moneyOnInput ? "  " + str.tostring(T.lot, "0.00") + " lot" : ""
    R.eLb  := label.new(lx, T.entry, (T.dir == 1 ? "LONG " : "SHORT ") + fmtPrice(T.entry) + lotTxt, color = ENTRY_COLOR, textcolor = RISK_TEXT, style = label.style_label_left, size = labelSize)
    R.sLb  := label.new(lx + R.sOff, T.sl, "SL " + fmtPrice(T.sl) + pctFromEntry(T.sl, T.entry) + usdTag((T.sl - T.entry) * T.dir, 1.0), color = SL_COLOR, textcolor = RISK_TEXT, style = label.style_label_left, size = labelSize)
    R.t1Lb := label.new(lx + R.t1Off, T.tp1, "TP1 " + fmtPrice(T.tp1) + pctFromEntry(T.tp1, T.entry) + usdTag((T.tp1 - T.entry) * T.dir, 1.0 / 3.0), color = TP_LBL_COLOR, textcolor = RISK_TEXT, style = label.style_label_left, size = labelSize)
    R.t2Lb := label.new(lx, T.tp2, "TP2 " + fmtPrice(T.tp2) + pctFromEntry(T.tp2, T.entry) + usdTag((T.tp2 - T.entry) * T.dir, 1.0 / 3.0), color = TP_LBL_COLOR, textcolor = RISK_TEXT, style = label.style_label_left, size = labelSize)
    R.t3Lb := label.new(lx, T.tp3, "TP3 " + fmtPrice(T.tp3) + pctFromEntry(T.tp3, T.entry) + usdTag((T.tp3 - T.entry) * T.dir, 1.0 / 3.0), color = TP_LBL_COLOR, textcolor = RISK_TEXT, style = label.style_label_left, size = labelSize)

// TP hit → solid teal + ✓
if showTPSLInput and not evEntry and not na(R.t1L) and T.tp1Hit
    line.set_color(R.t1L, TP_HIT_COLOR)
    line.set_style(R.t1L, line.style_solid)
    label.set_text(R.t1Lb, "TP1 ✓ " + fmtPrice(T.tp1) + usdTag((T.tp1 - T.entry) * T.dir, 1.0 / 3.0))
    label.set_color(R.t1Lb, TP_HIT_COLOR)
if showTPSLInput and not evEntry and not na(R.t2L) and T.tp2Hit
    line.set_color(R.t2L, TP_HIT_COLOR)
    line.set_style(R.t2L, line.style_solid)
    label.set_text(R.t2Lb, "TP2 ✓ " + fmtPrice(T.tp2) + usdTag((T.tp2 - T.entry) * T.dir, 1.0 / 3.0))
    label.set_color(R.t2Lb, TP_HIT_COLOR)

// Break-even → dim SL, annotate entry
if showTPSLInput and T.be and T.dir != 0 and not na(R.sL)
    line.set_color(R.sL, color.new(SL_COLOR, BE_DIM))
    label.set_color(R.sLb, color.new(SL_COLOR, BE_DIM))
    label.set_text(R.eLb, (T.dir == 1 ? "LONG " : "SHORT ") + fmtPrice(T.entry) + "  → SL (BE)")
    label.set_color(R.eLb, BE_COLOR)

// Extend the active record
if T.dir != 0 and showTPSLInput and not na(R.sL)
    int nx2 = bar_index + LINE_UPD
    int nlx = nx2 + LBL_OFF
    line.set_x2(R.eL,  nx2)
    line.set_x2(R.sL,  nx2)
    line.set_x2(R.t1L, nx2)
    line.set_x2(R.t2L, nx2)
    line.set_x2(R.t3L, nx2)
    label.set_x(R.eLb,  nlx)
    label.set_x(R.sLb,  nlx + R.sOff)
    label.set_x(R.t1Lb, nlx + R.t1Off)
    label.set_x(R.t2Lb, nlx)
    label.set_x(R.t3Lb, nlx)

// Closed trade → delete the whole record (after optional keep-bars)
if T.dir == 0 and not na(T.closeBar) and (bar_index - T.closeBar) >= keepClosedInput and not na(R.sL)
    deleteRec(R)

// Compact result mark
if evClosed and showResultInput and showTPSLInput and not na(evExitPx)
    string rTxt = fmtR(nz(evR)) + (moneyOnInput ? " · " + fmtUsdS(nz(evNet)) : "")
    label.new(bar_index, evExitPx, rTxt, style = label.style_label_left, color = color.new(nz(evR) >= 0 ? BULL_TEXT : BEAR_TEXT, 80), textcolor = nz(evR) >= 0 ? BULL_TEXT : BEAR_TEXT, size = size.tiny, tooltip = "Closed: " + S.lastExit)

// ══════════════════════════════════════
// SUPPLY / DEMAND ZONES (SMC + stars)
// ══════════════════════════════════════
var box[]   zBox  = array.new_box()
var float[] zTop  = array.new_float()
var float[] zBot  = array.new_float()
var int[]   zDir  = array.new_int()
var int[]   zStar = array.new_int()
var bool[]  zTest = array.new_bool()
var int[]   zBar  = array.new_int()

float body0   = math.abs(close - open)
bool  bullImp = close > open and body0 >= impMultInput * atrBase
bool  bearImp = close < open and body0 >= impMultInput * atrBase

if showZonesInput and barstate.isconfirmed and isWarmedUp and atrBase > 0 and (bullImp or bearImp)
    int d = bullImp ? 1 : -1
    int nBase = 0
    float zt = na
    float zb = na
    for k = 1 to baseMaxInput
        float bd = math.abs(close[k] - open[k])
        if bd <= baseBodyInput * atrBase
            nBase += 1
            float bodyTop = math.max(open[k], close[k])
            float bodyBot = math.min(open[k], close[k])
            if d == 1
                zt := na(zt) ? bodyTop : math.max(zt, bodyTop)
                zb := na(zb) ? low[k] : math.min(zb, low[k])
            else
                zt := na(zt) ? high[k] : math.max(zt, high[k])
                zb := na(zb) ? bodyBot : math.min(zb, bodyBot)
        else
            break
    if nBase > 0 and not na(zt) and not na(zb) and zt > zb
        // skip if overlapping an existing zone of the same side
        bool overlap = false
        int n = array.size(zBox)
        if n > 0
            for i = 0 to n - 1
                if array.get(zDir, i) == d and zb <= array.get(zTop, i) and zt >= array.get(zBot, i)
                    overlap := true
        if not overlap
            int stars = 1
            stars += body0 >= 2.0 * atrBase ? 1 : 0
            stars += nBase <= 2 ? 1 : 0
            stars += d == 1 ? (trendBull ? 1 : 0) : (trendBear ? 1 : 0)
            stars += hasVolume ? (volume > volSma * 1.5 ? 1 : 0) : (zt - zb <= atrBase ? 1 : 0)
            color zc = d == 1 ? demandColorInput : supplyColorInput
            box b = box.new(bar_index - nBase, zt, bar_index + 10, zb, border_color = color.new(zc, 50), bgcolor = color.new(zc, 85), border_width = 1, text = zoneText(d, stars, false), text_color = zc, text_size = size.tiny, text_halign = text.align_right, text_valign = text.align_center)
            array.push(zBox, b)
            array.push(zTop, zt)
            array.push(zBot, zb)
            array.push(zDir, d)
            array.push(zStar, stars)
            array.push(zTest, false)
            array.push(zBar, bar_index)
            // cap zones per side — drop the oldest of that side
            int cnt = 0
            for i = 0 to array.size(zBox) - 1
                cnt += array.get(zDir, i) == d ? 1 : 0
            if cnt > maxZonesInput
                int idx = -1
                for i = 0 to array.size(zBox) - 1
                    if idx == -1 and array.get(zDir, i) == d
                        idx := i
                if idx >= 0
                    box.delete(array.get(zBox, idx))
                    array.remove(zBox, idx)
                    array.remove(zTop, idx)
                    array.remove(zBot, idx)
                    array.remove(zDir, idx)
                    array.remove(zStar, idx)
                    array.remove(zTest, idx)
                    array.remove(zBar, idx)

// maintain zones: extend, mark tested, remove when closed through
if array.size(zBox) > 0
    for i = array.size(zBox) - 1 to 0
        box   b  = array.get(zBox, i)
        float zt = array.get(zTop, i)
        float zb = array.get(zBot, i)
        int   d  = array.get(zDir, i)
        bool broken = d == 1 ? close < zb : close > zt
        if broken and barstate.isconfirmed
            box.delete(b)
            array.remove(zBox, i)
            array.remove(zTop, i)
            array.remove(zBot, i)
            array.remove(zDir, i)
            array.remove(zStar, i)
            array.remove(zTest, i)
            array.remove(zBar, i)
        else
            box.set_right(b, bar_index + 10)
            bool touched = d == 1 ? low <= zt : high >= zb
            if touched and not array.get(zTest, i) and bar_index > array.get(zBar, i) + 1 and barstate.isconfirmed
                int ns = math.max(1, array.get(zStar, i) - 1)
                array.set(zStar, i, ns)
                array.set(zTest, i, true)
                box.set_text(b, zoneText(d, ns, true))

// Cleanup old signal labels
if array.size(label.all) > 450
    label.delete(array.shift(label.all))


// ══════════════════════════════════════
// DASHBOARD — YY_SMC_PRO panel (PC / iPad / Mobile)
// ══════════════════════════════════════
// Panel palette (always dark, like the original YY_SMC_PRO panel)
P_BG       = #12141C
P_CELL     = #1A1D29
P_BORDER   = #2A2E3D
P_GOLD_BG  = #E8C25A
P_GOLD_TX  = #1A1A1A
P_LIVE_BG  = #0E3B2E
P_LIVE_TX  = #2EE59D
P_HIST_BG  = #2A2E3D
P_HIST_TX  = #8A93B2
P_TEXT     = #E6E9F2
P_MUTED    = #8A93B2
P_BULL     = #2EE59D
P_BEAR     = #FF6B81
P_BULL_BG  = #1FBF7A
P_BEAR_BG  = #F2546B
P_BULL_DK  = #0F2E24
P_BEAR_DK  = #3A1A24
P_INFO_DK  = #16223A
P_E_TX     = #7FB2FF
P_YELLOW   = #FFC940

fmtDur(float ms) =>
    int tot = math.max(0, int(math.floor(ms / 1000.0)))
    int h = int(math.floor(tot / 3600.0))
    int m = int(math.floor((tot - h * 3600) / 60.0))
    int s = tot - h * 3600 - m * 60
    str.tostring(h, "00") + ":" + str.tostring(m, "00") + ":" + str.tostring(s, "00")

hhmm(string sess, int pos) =>
    int h = int(nz(str.tonumber(str.substring(sess, pos, pos + 2)), 0))
    int m = int(nz(str.tonumber(str.substring(sess, pos + 2, pos + 4)), 0))
    [h, m]

// returns [state, ms]: state 1 = inside kill zone (ms to end), 0 = upcoming (ms to start)
kzInfo(string sess) =>
    [sh, sm] = hhmm(sess, 0)
    [eh, em] = hhmm(sess, 5)
    int y  = year(timenow, kzTzInput)
    int mo = month(timenow, kzTzInput)
    int d  = dayofmonth(timenow, kzTzInput)
    int st = timestamp(kzTzInput, y, mo, d, sh, sm)
    int en = timestamp(kzTzInput, y, mo, d, eh, em)
    if en <= st
        en += 86400000
    int state = 0
    float ms = 0.0
    if timenow >= st and timenow < en
        state := 1
        ms := en - timenow
    else if timenow < st
        ms := st - timenow
    else
        ms := st + 86400000 - timenow
    [state, ms]

var table dashTable = na

dashPos = switch dashPosStr
    "Top Left"     => position.top_left
    "Top Right"    => position.top_right
    "Bottom Left"  => position.bottom_left
    "Bottom Right" => position.bottom_right
    "Middle Right" => position.middle_right
    =>                position.top_right

if showDashInput and barstate.islast
    bool isPC  = deviceInput == "PC"
    bool isMob = deviceInput == "Mobile"
    fsz = isPC ? sizeFromString(dashFontInput) : isMob ? size.tiny : size.small

    // ── bias + MTF
    int    bias    = trendBull ? 1 : trendBear ? -1 : 0
    string biasTx  = bias == 1 ? "BULLISH" : bias == -1 ? "BEARISH" : "NEUTRAL"
    color  biasCol = bias == 1 ? P_BULL : bias == -1 ? P_BEAR : P_YELLOW
    int    sc      = bias == -1 ? math.round(bearScore) : math.round(bullScore)
    string mtfTx   = tfName(mtfTF3Input) + stateArrow(mtf3State, mtf3Valid) + " " + tfName(mtfTF2Input) + stateArrow(mtf2State, mtf2Valid) + " " + tfName(mtfTF1Input) + stateArrow(mtf1State, mtf1Valid) + "   " + str.tostring(sc) + "%"

    // ── nearest zones
    float nDT = na
    float nDB = na
    int   nDS = 0
    float nST = na
    float nSB = na
    int   nSS = 0
    if array.size(zBox) > 0
        for i = 0 to array.size(zBox) - 1
            float zt = array.get(zTop, i)
            float zb = array.get(zBot, i)
            if array.get(zDir, i) == 1 and zb <= close
                if na(nDT) or zt > nDT
                    nDT := zt
                    nDB := zb
                    nDS := array.get(zStar, i)
            if array.get(zDir, i) == -1 and zt >= close
                if na(nSB) or zb < nSB
                    nST := zt
                    nSB := zb
                    nSS := array.get(zStar, i)
    string supTx = na(nSB) ? "S —" : "S " + str.repeat("★", nSS) + str.repeat("☆", 5 - nSS) + (close >= nSB ? " IN" : " ↑" + str.tostring(nSB - close, "0.0"))
    string demTx = na(nDT) ? "D —" : "D " + str.repeat("★", nDS) + str.repeat("☆", 5 - nDS) + (close <= nDT ? " IN" : " ↓" + str.tostring(close - nDT, "0.0"))

    // ── trade
    bool   inTrade = T.dir != 0
    string sideTx  = inTrade ? (T.dir == 1 ? "BUY " : "SELL ") + T.src : "FLAT"
    color  sideBg  = inTrade ? (T.dir == 1 ? P_BULL_BG : P_BEAR_BG) : P_CELL
    color  sideTxC = inTrade ? #FFFFFF : P_MUTED
    string tpDots  = (T.tp1Hit ? "●" : "○") + (T.tp2Hit ? "●" : "○") + "🏁"
    float  nextTP  = not inTrade ? na : not T.tp1Hit ? T.tp1 : not T.tp2Hit ? T.tp2 : T.tp3
    float  liveR   = inTrade and T.risk > 0 ? T.rAcc + T.rem * (close - T.entry) * T.dir / T.risk : S.lastR
    float  floatP  = inTrade ? T.realized + T.rem * (close - T.entry) * T.dir * contractInput * T.lot - tradeCost(T.lot) : 0.0
    float  tp1Rate = S.closed > 0 ? 100.0 * S.tp1Cnt / S.closed : 0.0
    float  avgR    = S.closed > 0 ? S.rSum / S.closed : 0.0
    string sigAgo  = lastSignal == "None" ? "—" : lastSignal + " (" + str.tostring(bar_index - lastSignalBar) + ")"

    // ── status message (Thai, YY_SMC_PRO style)
    string msg = ""
    color  msgBg = P_CELL
    color  msgTx = P_MUTED
    if inTrade
        msg := (T.dir == 1 ? "🟢 ถือ BUY" : "🔴 ถือ SELL") + (T.tp2Hit ? " · TP2 ✓ ปล่อยวิ่งหา TP3" : T.tp1Hit ? " · TP1 ✓" + (T.be ? " SL→BE ไม่ต้องกังวล" : "") : " · รอ TP1 " + fmtPrice(T.tp1))
        msgBg := T.dir == 1 ? P_BULL_DK : P_BEAR_DK
        msgTx := T.dir == 1 ? P_BULL : P_BEAR
    else if S.lastExit == "SL"
        msg := "👉 โดน SL " + fmtR(S.lastR) + " · อย่ารีบเอาคืน รอสัญญาณใหม่"
        msgBg := P_BEAR_DK
        msgTx := P_BEAR
    else if S.lastExit == "BE"
        msg := "🛡️ ออกที่ BE " + fmtR(S.lastR) + " · ทุนปลอดภัย รอสัญญาณใหม่"
        msgBg := P_INFO_DK
        msgTx := P_E_TX
    else if S.lastExit == "TP3"
        msg := "🏆 ปิดครบ TP3 " + fmtR(S.lastR) + " · เยี่ยม! พักก่อนได้"
        msgBg := P_BULL_DK
        msgTx := P_BULL
    else
        msg := not adxOk and eADX ? "⏳ ADX " + str.tostring(adx, "0.0") + " < " + str.tostring(adxThr, "0") + " · ตลาดยังไม่มีแรง รอก่อน" : "⏳ รอ EMA " + str.tostring(emaFastInput) + "/" + str.tostring(emaSlowInput) + " ตัด"
        msgTx := P_MUTED

    // ── kill zones
    [aSt, aMs] = kzInfo(asiaKzInput)
    [lSt, lMs] = kzInfo(londonKzInput)
    [nSt, nMs] = kzInfo(nyKzInput)
    string kzTx = ""
    if aSt == 1
        kzTx := "◷ IN ASIA KZ · ends " + fmtDur(aMs)
    else if lSt == 1
        kzTx := "◷ IN LONDON KZ · ends " + fmtDur(lMs)
    else if nSt == 1
        kzTx := "◷ IN NEW YORK KZ · ends " + fmtDur(nMs)
    else
        float best = math.min(aMs, math.min(lMs, nMs))
        string nm = best == aMs ? "ASIA" : best == lMs ? "LONDON" : "NEW YORK"
        kzTx := "◷ " + nm + " KZ in " + fmtDur(best)
    string barTx = barstate.isrealtime ? " · bar " + fmtDur(time_close - timenow) : ""
    bool   inKz  = aSt == 1 or lSt == 1 or nSt == 1

    // ── row count
    int rows = 8
    rows += isPC ? 2 : 0
    rows += moneyOnInput ? (isPC ? 2 : 1) : 0
    rows += showKzInput ? 1 : 0

    if not na(dashTable)
        table.delete(dashTable)
    dashTable := table.new(dashPos, 3, rows, bgcolor = P_BG, border_color = P_BORDER, border_width = 1, frame_color = P_BORDER, frame_width = 1)
    int r = 0

    // header
    table.cell(dashTable, 0, r, "◆ YOUNGYUU EMA·ADX" + modeTag, text_color = P_GOLD_TX, bgcolor = P_GOLD_BG, text_size = fsz, text_halign = text.align_left)
    table.merge_cells(dashTable, 0, r, 1, r)
    table.cell(dashTable, 2, r, barstate.isrealtime ? "● LIVE" : "◌ HIST", text_color = barstate.isrealtime ? P_LIVE_TX : P_HIST_TX, bgcolor = barstate.isrealtime ? P_LIVE_BG : P_HIST_BG, text_size = fsz)
    r += 1
    // status
    table.cell(dashTable, 0, r, msg, text_color = msgTx, bgcolor = msgBg, text_size = fsz, text_halign = text.align_left)
    table.merge_cells(dashTable, 0, r, 2, r)
    r += 1
    // bias + MTF
    table.cell(dashTable, 0, r, biasTx, text_color = biasCol, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
    table.cell(dashTable, 1, r, mtfTx, text_color = P_TEXT, bgcolor = P_BG, text_size = fsz)
    table.merge_cells(dashTable, 1, r, 2, r)
    r += 1
    // zones
    table.cell(dashTable, 0, r, supTx, text_color = supplyColorInput, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
    table.cell(dashTable, 1, r, demTx, text_color = demandColorInput, bgcolor = P_BG, text_size = fsz, text_halign = text.align_left)
    table.merge_cells(dashTable, 1, r, 2, r)
    r += 1
    // side / entry / SL
    table.cell(dashTable, 0, r, sideTx, text_color = sideTxC, bgcolor = sideBg, text_size = fsz)
    if inTrade
        table.cell(dashTable, 1, r, "E " + fmtPrice(T.entry), text_color = P_E_TX, bgcolor = P_INFO_DK, text_size = fsz)
        table.cell(dashTable, 2, r, (T.be ? "BE " : "SL ") + fmtPrice(T.sl), text_color = T.be ? BE_COLOR : P_BEAR, bgcolor = P_BEAR_DK, text_size = fsz)
    else
        table.cell(dashTable, 1, r, "last " + sigAgo, text_color = P_MUTED, bgcolor = P_BG, text_size = fsz)
        table.merge_cells(dashTable, 1, r, 2, r)
    r += 1
    // TP progress
    table.cell(dashTable, 0, r, "TP " + (inTrade ? tpDots : "—"), text_color = TP_LBL_COLOR, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
    table.cell(dashTable, 1, r, inTrade ? "next " + fmtPrice(nextTP) + (moneyOnInput ? "  " + fmtUsdS(floatP) : "") : "—", text_color = P_TEXT, bgcolor = P_BG, text_size = fsz, text_halign = text.align_left)
    table.merge_cells(dashTable, 1, r, 2, r)
    r += 1
    // R + WR
    table.cell(dashTable, 0, r, fmtR(liveR), text_color = liveR >= 0 ? P_BULL : P_BEAR, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
    table.cell(dashTable, 1, r, "WR " + str.tostring(math.round(tp1Rate)) + "% · " + fmtR(avgR) + " · n" + str.tostring(S.closed), text_color = P_YELLOW, bgcolor = P_BG, text_size = fsz, text_halign = text.align_right)
    table.merge_cells(dashTable, 1, r, 2, r)
    r += 1
    // form strip
    table.cell(dashTable, 0, r, "Form", text_color = P_MUTED, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
    table.cell(dashTable, 1, r, S.form == "" ? "—" : S.form, text_color = FORM_COLOR, bgcolor = P_BG, text_size = fsz, text_halign = text.align_right)
    table.merge_cells(dashTable, 1, r, 2, r)
    r += 1
    // PC extras: ADX/regime + last block
    if isPC
        table.cell(dashTable, 0, r, "ADX " + str.tostring(adx, "0.0"), text_color = adxOk ? P_BULL : P_BEAR, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
        table.cell(dashTable, 1, r, "thr " + str.tostring(adxThr, "0") + " · DI+ " + str.tostring(diPlus, "0") + "/" + str.tostring(diMinus, "0") + " · " + regimeStr, text_color = regimeCol, bgcolor = P_BG, text_size = fsz, text_halign = text.align_left)
        table.merge_cells(dashTable, 1, r, 2, r)
        r += 1
        table.cell(dashTable, 0, r, "Block", text_color = P_MUTED, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
        table.cell(dashTable, 1, r, lastBlock == "" ? "—" : lastBlock, text_color = P_MUTED, bgcolor = P_BG, text_size = fsz, text_halign = text.align_left)
        table.merge_cells(dashTable, 1, r, 2, r)
        r += 1
    // money
    if moneyOnInput
        float netAll = M.equity - capitalInput
        float netPct = capitalInput > 0 ? netAll / capitalInput * 100.0 : 0.0
        table.cell(dashTable, 0, r, "💰 " + fmtUsd(capitalInput), text_color = P_YELLOW, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
        table.cell(dashTable, 1, r, "→ " + fmtUsd(M.equity) + " (" + fmtPctS(netPct) + ")" + (M.bust ? " 💥" : ""), text_color = netAll >= 0 ? P_BULL : P_BEAR, bgcolor = P_BG, text_size = fsz, text_halign = text.align_right)
        table.merge_cells(dashTable, 1, r, 2, r)
        r += 1
        if isPC
            int mTot = M.wins + M.losses
            table.cell(dashTable, 0, r, "W/L " + str.tostring(M.wins) + "/" + str.tostring(M.losses), text_color = P_TEXT, bgcolor = P_CELL, text_size = fsz, text_halign = text.align_left)
            table.cell(dashTable, 1, r, "DD -" + str.tostring(M.maxDD, "0.0") + "% · last " + (mTot > 0 ? fmtUsdS(M.lastPnl) : "—") + " · ⚠ จำลอง", text_color = P_MUTED, bgcolor = P_BG, text_size = fsz, text_halign = text.align_right)
            table.merge_cells(dashTable, 1, r, 2, r)
            r += 1
    // kill zone countdown
    if showKzInput
        table.cell(dashTable, 0, r, kzTx + barTx, text_color = inKz ? P_YELLOW : P_MUTED, bgcolor = P_BG, text_size = fsz, text_halign = text.align_left)
        table.merge_cells(dashTable, 0, r, 2, r)
else if not showDashInput and barstate.islast and not na(dashTable)
    table.delete(dashTable)
    dashTable := na

// ══════════════════════════════════════
// ALERTS
// ══════════════════════════════════════
string tickerStr = syminfo.tickerid
string tfStr     = timeframe.period

if evBuyEntry or evSellEntry
    string side  = evBuyEntry ? "buy" : "sell"
    string pStr  = str.tostring(T.entry, format.mintick)
    string scStr = str.tostring(math.round(evBuyEntry ? bullScore : bearScore))
    string slS   = str.tostring(T.sl, format.mintick)
    string t1S   = str.tostring(T.tp1, format.mintick)
    string t2S   = str.tostring(T.tp2, format.mintick)
    string t3S   = str.tostring(T.tp3, format.mintick)
    string lotS  = str.tostring(T.lot, "0.00")
    string js = '{"action":"' + side + '","source":"' + T.src + '","ticker":"' + tickerStr + '","price":' + pStr + ',"tf":"' + tfStr + '","score":' + scStr + ',"sl":' + slS + ',"tp1":' + t1S + ',"tp2":' + t2S + ',"tp3":' + t3S + ',"lot":' + lotS + '}'
    string tx = (evBuyEntry ? "🟢 BUY " : "🔴 SELL ") + T.src + " | " + tickerStr + " " + tfStr + " | " + pStr + " | Score " + scStr + "% | SL " + slS + " | TP1 " + t1S + " | TP2 " + t2S + " | TP3 " + t3S + (moneyOnInput ? " | Lot " + lotS : "")
    alert(webhookInput ? js : tx, alert.freq_once_per_bar_close)

if evBE
    alert("🛡️ SL → BREAK-EVEN | " + tickerStr + " | " + str.tostring(T.entry, format.mintick), alert.freq_once_per_bar_close)
if evTP1
    alert("🎯 TP1 HIT | " + tickerStr + " | " + str.tostring(T.tp1, format.mintick), alert.freq_once_per_bar_close)
if evTP2
    alert("🎯 TP2 HIT | " + tickerStr + " | " + str.tostring(T.tp2, format.mintick), alert.freq_once_per_bar_close)
if evTP3
    alert("🏁 TP3 HIT — TRADE CLOSED | " + tickerStr + " | " + fmtR(nz(evR)) + (moneyOnInput ? " | " + fmtUsdS(nz(evNet)) : ""), alert.freq_once_per_bar_close)
if evSL
    alert("🛑 " + S.lastExit + " HIT | " + tickerStr + " | " + fmtR(nz(evR)) + (moneyOnInput ? " | " + fmtUsdS(nz(evNet)) : ""), alert.freq_once_per_bar_close)

useBodyInput  = input.bool(true, "Solid Body", group = GRP_FILT, tooltip = "Body / ATR ≥ 0.05 (≤M5) · 0.08 (≤M15) · 0.12 (higher).")
useMomInput   = input.bool(true, "Momentum", group = GRP_FILT, tooltip = "≤M5: close > close[1]. Higher TF: 2 rising closes.")

keepClosedInput = input.int(0, "Keep Closed Trade Lines (bars)", minval = 0, maxval = 200, group = GRP_TPSL)
showResultInput = input.bool(true, "Show Result Mark on Close", group = GRP_TPSL)
showPctInput    = input.bool(false, "Show % Distance on Labels", group = GRP_TPSL)

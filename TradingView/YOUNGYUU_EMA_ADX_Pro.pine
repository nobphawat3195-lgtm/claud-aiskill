// ── Supply / Demand
showZonesInput  = input.bool(true, "Show Supply/Demand Zones", group = GRP_ZONE)
impMultInput    = input.float(1.5, "Impulse Body (x ATR)", minval = 0.8, maxval = 4.0, step = 0.1, group = GRP_ZONE)

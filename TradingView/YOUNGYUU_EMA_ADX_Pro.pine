//@version=6
// ══════════════════════════════════════════════════════════════
// YOUNGYUU EMA·ADX PRO — Gold Edition · v1.0
// ──────────────────────────────────────────────────────────────
// Trigger : EMA 9 / EMA 21 cross (closed bar, non-repainting)
// Filter  : ADX ≥ threshold (Auto by timeframe, YOUNGYUU v4 table)
//           + DI direction, Supertrend direction, RSI OB/OS,
//           candle body, momentum, optional HTF / session
// Regime  : YOUNGYUU v4 — ADX + BBW + Trend Strength (TSF)
//           STRONG / WEAK / SIDEWAYS (+ optional sideways scalp)
// SL / TP : YOUNGYUU v4 — Swing / ATR / Fixed SL, TP in ATR with
//           R:R floor and TP1 < TP2 < TP3 ladder, min / max SL
// Extras  : SMC Supply/Demand zones (1-5 ★), Money Simulator,
//           YY_SMC_PRO panel (PC / iPad / Mobile), TP/SL record cleanup
// ══════════════════════════════════════════════════════════════
indicator(title = "YOUNGYUU EMA·ADX Pro", shorttitle = "YY_EMA_ADX", overlay = true, max_labels_count = 500, max_lines_count = 500, max_boxes_count = 200, max_bars_back = 5000)

// ══════════════════════════════════════
// CONSTANTS
// ══════════════════════════════════════
GRP_EMA   = "📈 EMA Cross"
GRP_ADX   = "💪 ADX Filter"
GRP_FILT  = "✅ Confirmations (v4)"
GRP_SCALP = "📊 Sideways Scalp (v4)"
GRP_SIG   = "📍 Signals"
GRP_TPSL  = "🎯 SL / TP (v4)"
GRP_ZONE  = "🧱 Supply / Demand"
GRP_MTF   = "🔄 Multi-Timeframe"
GRP_DASH  = "📊 Dashboard"
GRP_MONEY = "💰 Money Simulator"
GRP_COL   = "🎨 Colors"
GRP_ALERT = "🔔 Alerts"

VERSION   = "v1.0"
LINE_FWD  = 15
LINE_UPD  = 5
LBL_OFF   = 1
LBL_STAG  = 8
FORM_LEN  = 10
BE_DIM    = 70
WARMUP    = 120

// ══════════════════════════════════════
// INPUTS
// ══════════════════════════════════════
// ── EMA Cross
signalModeInput = input.string("Filtered", "Signal Mode", options = ["Filtered", "ADX Only", "Pure EMA Cross"], group = GRP_EMA, tooltip = "Filtered: EMA cross + ADX + all v4 confirmations you enabled.\nADX Only: EMA cross + ADX ≥ threshold (other filters ignored).\nPure EMA Cross: every EMA cross is a BUY / SELL (no filters, no max-SL skip, no scalp mode).")
emaFastInput  = input.int(9, "EMA Fast", minval = 2, maxval = 100, group = GRP_EMA)
emaSlowInput  = input.int(21, "EMA Slow", minval = 3, maxval = 300, group = GRP_EMA)
showEmaInput  = input.bool(true, "Show EMA Lines", group = GRP_EMA)

// ── ADX Filter
useADXInput     = input.bool(true, "ADX Filter", group = GRP_ADX, tooltip = "Cross is valid only when ADX ≥ threshold.")
adxLenInput     = input.int(13, "ADX / DI Length", minval = 2, maxval = 50, group = GRP_ADX)
autoSensInput   = input.bool(true, "Auto Threshold by Timeframe (v4)", group = GRP_ADX, tooltip = "M1 13 · M3 14 · M5 15 · M15 17 · M30 19 · H1 21 · H4 23 · D 25\nBBW: 0.2% → 1.2% on the same steps.")
adxManualInput  = input.int(18, "Manual ADX Threshold", minval = 5, maxval = 60, group = GRP_ADX)
bbwManualInput  = input.float(0.004, "Manual BBW Threshold", minval = 0.0005, step = 0.0005, group = GRP_ADX)
useDIInput      = input.bool(true, "DI Direction (DI+ > DI- for Buy)", group = GRP_ADX)
useRisingInput  = input.bool(false, "ADX Rising", group = GRP_ADX, tooltip = "ADX higher than the previous bar.")
useTSFInput     = input.bool(true, "Trend Strength Filter (TSF, v4)", group = GRP_ADX, tooltip = "ADX / SMA(ADX) ≥ TSF Min — used for the STRONG / WEAK regime.")
tsfLookInput    = input.int(50, "TSF Lookback", minval = 5, maxval = 200, group = GRP_ADX)
tsfMinInput     = input.float(1.05, "TSF Min", minval = 0.5, maxval = 3.0, step = 0.05, group = GRP_ADX)

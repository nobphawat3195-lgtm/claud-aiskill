maxSlAtrInput   = input.float(4.0, "Max SL Distance (x ATR, 0=off)", minval = 0.0, maxval = 20.0, step = 0.5, group = GRP_TPSL, tooltip = "Signal is skipped when the stop would be wider than this.")
tp1AtrInput     = input.float(1.5, "TP1 (x ATR)", minval = 0.3, maxval = 10.0, step = 0.1, group = GRP_TPSL)
tp2AtrInput     = input.float(3.0, "TP2 (x ATR)", minval = 0.5, maxval = 20.0, step = 0.1, group = GRP_TPSL)

//@version=6
indicator("Momentum Confluence Engine · YY Pro", shorttitle = "MCE YY", overlay = false, precision = 2, max_labels_count = 500)

// ── INPUTS ──────────────────────────────────────────────────────
const string GRP_CORE  = "⚙️ Core"
const string GRP_FILT  = "🕯️ Filters"
const string GRP_COMP  = "🌊 Components"
const string GRP_TRADE = "📐 Trade Tools"
const string GRP_VIS   = "🎨 Visuals"
const string GRP_DASH  = "📊 Dashboard"
const string GRP_WH    = "🔔 Alerts"
const string GRP_COL   = "🌈 Colors"

i_src       = input.source(close, "Source", group = GRP_CORE, tooltip = "Price series read by RSI, Stoch, CCI, MACD and ROC. MFI always reads the bar's high-low-close average.")
i_smooth    = input.int(3,     "Smooth",   minval = 1,    maxval = 50,   group = GRP_CORE, tooltip = "EMA length that smooths the blended score. Higher is slower with fewer crossovers.")
i_sigLen    = input.int(9,     "Signal Len", minval = 1,  maxval = 100,  group = GRP_CORE, tooltip = "EMA length of the signal line, taken from the smoothed score. A score crossing this line raises a raw signal.")
i_thrBull   = input.int(20,    "Bull Thr", minval = 0,    maxval = 100,  group = GRP_CORE, tooltip = "Score at or above this level reads BULL on the Bias row of the dashboard.")
i_thrBear   = input.int(-20,   "Bear Thr", minval = -100, maxval = 0,    group = GRP_CORE, tooltip = "Score at or below this level reads BEAR on the Bias row of the dashboard.")
i_ob        = input.int(60,    "OB Lvl",   minval = 0,    maxval = 100,  group = GRP_CORE, tooltip = "Score at or above this level is overbought: it opens the upper zone and reads OVERBOUGHT on the Zone row.")
i_os        = input.int(-60,   "OS Lvl",   minval = -100, maxval = 0,    group = GRP_CORE, tooltip = "Score at or below this level is oversold: it opens the lower zone and reads OVERSOLD on the Zone row.")
i_normLen   = input.int(100,   "Norm Len", minval = 20,   maxval = 500,  group = GRP_CORE, tooltip = "Bars used to turn the MACD histogram and ROC into z-scores. Those two components give no reading until this window and their own lengths have filled.")
i_satZ      = input.float(2.5, "Z Sat",    minval = 1.0,  maxval = 5.0, step = 0.1, group = GRP_CORE, tooltip = "Z-score at which a normalised component reaches 100 or -100. Lower saturates sooner.")

i_minAgree  = input.int(60,   "Min Agree %", minval = 0, maxval = 100, group = GRP_FILT, tooltip = "Minimum share of the total component weight that must point the same way as the signal side (score above its signal line is the bull side, below it the bear side) for a signal to pass.")
i_reqSlope  = input.bool(true, "Slope Align", group = GRP_FILT, tooltip = "A bull signal also needs the score rising, and a bear signal falling, over Slope Len bars.")
i_slopeLen  = input.int(3, "Slope Len", minval = 1, maxval = 50, group = GRP_FILT, tooltip = "Bars over which the change in the score is measured for Slope Align and the Slope row.")
i_htfOn     = input.bool(false, "Higher TF Confirm", group = GRP_FILT, tooltip = "A bull signal also needs the higher timeframe's Bias state to be BULL and a bear signal BEAR; NEUTRAL blocks both. The state is this indicator's own score against Bull Thr and Bear Thr, with the same settings, read on the last confirmed higher-timeframe bar. It reads once the higher timeframe's own score has a reading, with the same warm-up as the Score row on that timeframe, plus one confirmed higher-timeframe bar; until then every signal is blocked.")
i_htfTf     = input.timeframe("D", "Higher TF", group = GRP_FILT, tooltip = "Timeframe whose Bias state confirms signals. A timeframe equal to the chart's is valid and reads the chart's own state. A timeframe lower than the chart's is skipped and passes every signal.")
i_adxOn     = input.bool(false, "Strength Filter", group = GRP_FILT, tooltip = "A signal also needs ADX at or above ADX Threshold, read on the signal bar and acted on at its confirmed close.")
i_adxThr    = input.float(20.0, "ADX Threshold", minval = 0.0, maxval = 100.0, group = GRP_FILT, tooltip = "Minimum ADX a signal needs while Strength Filter is on.")
i_adxLen    = input.int(14, "ADX Length", minval = 1, group = GRP_FILT, tooltip = "Length of the directional movement and of the ADX average, in bars.")
i_smMode    = input.string("None", "Smoothing", options = ["None", "SMA", "EMA", "RMA", "WMA", "HMA"], group = GRP_FILT, tooltip = "Method that smooths the blended score before the Smooth EMA and before any signal is derived from it. None leaves the score as it is.")
i_smLen     = input.int(20, "Smoothing Length", minval = 1, group = GRP_FILT, tooltip = "Length of the Smoothing method in bars. The score has no reading until the method has filled this many bars after the first component reading. Not used while Smoothing is None.")

i_useRsi    = input.bool(true,  "RSI",   inline = "R", group = GRP_COMP, tooltip = "Include RSI in the weighted blend.")
i_rsiLen    = input.int(14,     "",   inline = "R", minval = 2, maxval = 500, group = GRP_COMP, tooltip = "RSI length in bars.")
i_wRsi      = input.float(1.0,  "",     inline = "R", minval = 0.0, maxval = 10.0, step = 0.1, group = GRP_COMP, tooltip = "RSI row. The first box includes RSI in the weighted blend, Len is its length in bars and W its weight. RSI leaves the score when it is switched off, W is 0, the chart is not a standard chart, or until the RSI length has filled.")
i_useSto    = input.bool(true,  "Stoch", inline = "S", group = GRP_COMP, tooltip = "Include the smoothed stochastic in the weighted blend.")
i_stoLen    = input.int(14,     "",   inline = "S", minval = 2, maxval = 500, group = GRP_COMP, tooltip = "Stochastic lookback length in bars.")
i_stoSm     = input.int(3,      "",    inline = "S", minval = 1, maxval = 50, group = GRP_COMP, tooltip = "SMA length that smooths the raw stochastic.")
i_wSto      = input.float(1.0,  "",     inline = "S", minval = 0.0, maxval = 10.0, step = 0.1, group = GRP_COMP, tooltip = "Stoch row. The first box includes the smoothed stochastic in the weighted blend, Len is its lookback in bars, Sm the SMA length that smooths the raw stochastic and W its weight. The stochastic leaves the score when it is switched off, W is 0, the chart is not a standard chart, or until Len and then Sm have filled.")
i_useCci    = input.bool(true,  "CCI",   inline = "C", group = GRP_COMP, tooltip = "Include CCI in the weighted blend.")
i_cciLen    = input.int(20,     "",   inline = "C", minval = 2, maxval = 500, group = GRP_COMP, tooltip = "CCI length in bars.")
i_cciSat    = input.float(200., "",   inline = "C", minval = 50.0, maxval = 500.0, step = 10.0, group = GRP_COMP, tooltip = "CCI value that maps to 100 or -100. Readings beyond it are clamped.")
i_wCci      = input.float(1.0,  "",     inline = "C", minval = 0.0, maxval = 10.0, step = 0.1, group = GRP_COMP, tooltip = "CCI row. The first box includes CCI in the weighted blend, Len is its length in bars, Sat the CCI value that maps to 100 or -100 (readings beyond it are clamped) and W its weight. CCI leaves the score when it is switched off, W is 0, the chart is not a standard chart, or until the CCI length has filled.")
i_useMacd   = input.bool(true,  "MACD",  inline = "M", group = GRP_COMP, tooltip = "Include the MACD histogram, normalised to a z-score over Norm Len bars, in the weighted blend.")
i_wMacd     = input.float(1.0,  "",     inline = "M", minval = 0.0, maxval = 10.0, step = 0.1, group = GRP_COMP, tooltip = "MACD row. The first box includes the MACD histogram, normalised to a z-score over Norm Len bars, in the weighted blend and W is its weight. MACD leaves the score when it is switched off, W is 0, the chart is not a standard chart, its window is flat, or until the MACD lengths and then Norm Len bars have filled.")
i_macdFast  = input.int(12,     "Fast",  inline = "N", minval = 1, maxval = 500, group = GRP_COMP, tooltip = "MACD fast EMA length. If it is above Slow, the two are swapped.")
i_macdSlow  = input.int(26,     "",  inline = "N", minval = 2, maxval = 500, group = GRP_COMP, tooltip = "MACD slow EMA length.")
i_macdSig   = input.int(9,      "",   inline = "N", minval = 1, maxval = 500, group = GRP_COMP, tooltip = "MACD lengths. Fast and Slow are the fast and slow EMA lengths (if Fast is above Slow, the two are swapped) and Sig is the signal EMA length. MACD leaves the score until these lengths and then Norm Len bars have filled, or while its window is flat.")
i_useRoc    = input.bool(true,  "ROC",   inline = "O", group = GRP_COMP, tooltip = "Include rate of change, normalised to a z-score over Norm Len bars, in the weighted blend.")
i_rocLen    = input.int(14,     "",   inline = "O", minval = 1, maxval = 500, group = GRP_COMP, tooltip = "ROC lookback in bars.")
i_wRoc      = input.float(1.0,  "",     inline = "O", minval = 0.0, maxval = 10.0, step = 0.1, group = GRP_COMP, tooltip = "ROC row. The first box includes rate of change, normalised to a z-score over Norm Len bars, in the weighted blend, Len is its lookback in bars and W its weight. ROC leaves the score when it is switched off, W is 0, the chart is not a standard chart, its window is flat, or until the ROC length and then Norm Len bars have filled.")
i_useMfi    = input.bool(true,  "MFI",   inline = "F", group = GRP_COMP, tooltip = "Include MFI in the weighted blend. MFI is volume-based.")
i_mfiLen    = input.int(14,     "",   inline = "F", minval = 2, maxval = 500, group = GRP_COMP, tooltip = "MFI length in bars.")
i_wMfi      = input.float(1.0,  "",     inline = "F", minval = 0.0, maxval = 10.0, step = 0.1, group = GRP_COMP, tooltip = "MFI row. The first box includes MFI in the weighted blend, Len is its length in bars and W its weight. MFI is volume-based. MFI leaves the score when it is switched off, W is 0, the chart is not a standard chart, or until the MFI length has filled.")

i_lockSignal = input.bool(false, "Lock Signal", group = GRP_TRADE, tooltip = "Freeze current signal · block new ones")
i_atrLen    = input.int(14,    "ATR Length", minval = 1,   maxval = 500, group = GRP_TRADE, tooltip = "Bars in the ATR that sets the stop distance. No trade is armed until the ATR has a value.")
i_slMult    = input.float(1.5, "SL ATR x",   minval = 0.1, step = 0.1,   group = GRP_TRADE, tooltip = "Stop distance in ATR from the entry, which is the close of the signal bar.")
i_tp1R      = input.float(1.0, "TP1 R",      minval = 0.1, step = 0.1,   group = GRP_TRADE, tooltip = "Target distance as a multiple of the stop distance. Targets set out of order are sorted nearest to farthest.")
i_tp2R      = input.float(2.0, "TP2 R",      minval = 0.1, step = 0.1,   group = GRP_TRADE, tooltip = "Second target distance as a multiple of the stop distance.")
i_tp3R      = input.float(3.0, "TP3 R",      minval = 0.1, step = 0.1,   group = GRP_TRADE, tooltip = "Third and final target distance as a multiple of the stop distance. Reaching it closes the trade.")

i_showMark  = input.bool(true,  "Markers",      group = GRP_VIS, tooltip = "Draw BULL and BEAR markers on confirmed signals, in the pane and on the price chart.")
i_showLevels = input.bool(true, "Trade Levels", group = GRP_VIS, tooltip = "Draws the stop, entry and target lines and labels for the current trade. Hit tracking and alerts run with it off.")
i_showCdl   = input.bool(true,  "Candle Color", group = GRP_VIS, tooltip = "Colour the price candles by the score gradient.")
i_showZone  = input.bool(true,  "OB/OS Zones", group = GRP_VIS, tooltip = "Fill the overbought and oversold zones.")
i_showComp  = input.bool(false, "Components",  group = GRP_VIS, tooltip = "Plot the score of each component that has a reading as its own line.")

i_showDash  = input.bool(true, "Show Dash", group = GRP_DASH, tooltip = "Show the dashboard table.")
i_dashPos   = input.string("Top Right", "Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group = GRP_DASH, tooltip = "Corner the dashboard sits in.")
i_dashOnPrice = input.bool(true, "Show on Price Chart", group = GRP_DASH, tooltip = "On: the dashboard is drawn on the price chart. Off: it stays in this indicator's pane.")

i_actionLong       = input.string("long",             "↑ Long Action",              group = GRP_WH, tooltip = "Action word sent in the alert payload when a long entry is signalled. Quotation marks and backslashes are escaped.")
i_actionShort      = input.string("short",            "↓ Short Action",             group = GRP_WH, tooltip = "Action word sent in the alert payload when a short entry is signalled. Quotation marks and backslashes are escaped.")
i_actionCloseLong  = input.string("closelong",        "✕ Close Long Action",        group = GRP_WH, tooltip = "Action word sent when a long trade closes: final target, stop, or replacement by a new signal. Quotation marks and backslashes are escaped.")
i_actionCloseShort = input.string("closeshort",       "✕ Close Short Action",       group = GRP_WH, tooltip = "Action word sent when a short trade closes: final target, stop, or replacement by a new signal. Quotation marks and backslashes are escaped.")
i_actionPartLong   = input.string("partialcloselong", "✕ Partial Close Long Action", group = GRP_WH, tooltip = "Action word sent when a long trade reaches TP1 or TP2, which leaves the trade open. Quotation marks and backslashes are escaped.")
i_actionPartShort  = input.string("partialcloseshort","✕ Partial Close Short Action",group = GRP_WH, tooltip = "Action word sent when a short trade reaches TP1 or TP2, which leaves the trade open. Quotation marks and backslashes are escaped.")

C_SUP      = input.color(#26a69a, "Bull",        group = GRP_COL, tooltip = "Bullish colour: top of the score gradient, BULL markers and bullish dashboard states.")
C_RES      = input.color(#ef5350, "Bear",        group = GRP_COL, tooltip = "Bearish colour: bottom of the score gradient, BEAR markers and bearish dashboard states.")
C_NEU      = input.color(#f9a825, "Neutral",     group = GRP_COL, tooltip = "Neutral colour: middle of the score gradient.")
C_SIG      = input.color(#b388ff, "Signal Line", group = GRP_COL, tooltip = "Colour of the signal line.")
C_MRK_TXT  = input.color(#ffffff, "Marker Txt",  group = GRP_COL, tooltip = "Text colour of the BULL and BEAR markers.")
C_MID      = input.color(color.new(#787b86, 40), "Mid Line",    group = GRP_COL, tooltip = "Colour of the zero line.")
C_LVL      = input.color(color.new(#787b86, 65), "Level Lines", group = GRP_COL, tooltip = "Colour of the overbought, oversold, threshold and maximum lines.")
C_ZONE     = input.color(color.new(#787b86, 88), "Zone Fill",   group = GRP_COL, tooltip = "Fill colour of the overbought and oversold zones.")
C_RSI      = input.color(#42a5f5, "RSI Line",   group = GRP_COL, tooltip = "Colour of the RSI component line.")
C_STO      = input.color(#ab47bc, "Stoch Line", group = GRP_COL, tooltip = "Colour of the stochastic component line.")
C_CCI      = input.color(#ffa726, "CCI Line",   group = GRP_COL, tooltip = "Colour of the CCI component line.")
C_MACD     = input.color(#26c6da, "MACD Line",  group = GRP_COL, tooltip = "Colour of the MACD component line.")
C_ROC      = input.color(#9ccc65, "ROC Line",   group = GRP_COL, tooltip = "Colour of the ROC component line.")
C_MFI      = input.color(#ec407a, "MFI Line",   group = GRP_COL, tooltip = "Colour of the MFI component line.")
C_DASH_HDR = input.color(color.new(#3a2a6d, 55), "Dash Hdr", group = GRP_COL, tooltip = "Fill colour of the dashboard header row.")
C_DASH_BG  = input.color(color.new(#0a0f1a, 10), "Dash BG",  group = GRP_COL, tooltip = "Dashboard background. Alternate rows use a faded copy of it, at 40 transparency.")
C_DASH_TXT = input.color(#ffffff, "Dash Txt", group = GRP_COL, tooltip = "Dashboard text colour. Label cells use a faded copy of it, at 25 transparency.")
C_WARN     = input.color(color.new(#f9a825, 80), "Warn Fill", group = GRP_COL, tooltip = "Fill of dashboard rows that warn, such as a skipped setting. A row takes it only while it warns.")
C_SL       = input.color(#ef5350, "SL",         group = GRP_COL, tooltip = "Stop line. The stop label uses the same colour at full opacity.")
C_ENTRY    = input.color(#2196f3, "Entry",      group = GRP_COL, tooltip = "Entry line. The entry label uses the same colour at full opacity.")
C_TP1      = input.color(color.new(#26a69a, 40), "TP1", group = GRP_COL, tooltip = "TP1 line. The TP1 label uses the same colour at full opacity.")
C_TP2      = input.color(color.new(#26a69a, 20), "TP2", group = GRP_COL, tooltip = "TP2 line. The TP2 label uses the same colour at full opacity.")
C_TP3      = input.color(color.new(#26a69a, 0),  "TP3", group = GRP_COL, tooltip = "TP3 line. The TP3 label uses the same colour at full opacity.")
C_LBL_TXT  = input.color(#ffffff, "Label Text", group = GRP_COL, tooltip = "Text colour of the trade level labels.")
// ── CORE LOGIC ──────────────────────────────────────────────────
f_clamp(float v, float lim) =>
    math.max(-lim, math.min(lim, v))

f_bounded(float v) =>
    (v - 50.0) * 2.0

f_zScore(float v, int len, float sat) =>
    float _m  = ta.sma(v, len)
    float _sd = ta.stdev(v, len)
    float _z  = na(v) or na(_sd) ? na : _sd > 0.0 ? (v - _m) / _sd : na
    f_clamp(_z / sat * 100.0, 100.0)

f_dir(float v) =>
    v > 0.0 ? 1 : v < 0.0 ? -1 : 0

f_agr(float s, float w, int d) =>
    f_dir(s) == d ? w : 0.0

float _rsiRaw  = ta.rsi(i_src, i_rsiLen)
float _stoRaw  = ta.sma(ta.stoch(i_src, high, low, i_stoLen), i_stoSm)
float _cciRaw  = ta.cci(i_src, i_cciLen)
int _macdF = math.min(i_macdFast, i_macdSlow)
int _macdS = math.max(i_macdFast, i_macdSlow)
[_, _, _macdH] = ta.macd(i_src, _macdF, _macdS, i_macdSig)
float _rocRaw  = ta.roc(i_src, i_rocLen)
float _mfiRaw  = ta.mfi(hlc3, i_mfiLen)
[_, _, _adx] = ta.dmi(i_adxLen, i_adxLen)

float _sRsi  = f_clamp(f_bounded(_rsiRaw), 100.0)
float _sSto  = f_clamp(f_bounded(_stoRaw), 100.0)
float _sCci  = f_clamp(_cciRaw / i_cciSat * 100.0, 100.0)
float _sMacd = f_zScore(_macdH, i_normLen, i_satZ)
float _sRoc  = f_zScore(_rocRaw, i_normLen, i_satZ)
float _sMfi  = f_clamp(f_bounded(_mfiRaw), 100.0)

bool _std = chart.is_standard

bool _okRsi  = _std and i_useRsi  and not na(_sRsi)
bool _okSto  = _std and i_useSto  and not na(_sSto)
bool _okCci  = _std and i_useCci  and not na(_sCci)
bool _okMacd = _std and i_useMacd and not na(_sMacd)
bool _okRoc  = _std and i_useRoc  and not na(_sRoc)
bool _okMfi  = _std and i_useMfi  and not na(_sMfi)

float nRsi  = _okRsi  ? _sRsi  : 0.0
float nSto  = _okSto  ? _sSto  : 0.0
float nCci  = _okCci  ? _sCci  : 0.0
float nMacd = _okMacd ? _sMacd : 0.0
float nRoc  = _okRoc  ? _sRoc  : 0.0
float nMfi  = _okMfi  ? _sMfi  : 0.0

float wRsi  = _okRsi  ? i_wRsi  : 0.0
float wSto  = _okSto  ? i_wSto  : 0.0
float wCci  = _okCci  ? i_wCci  : 0.0
float wMacd = _okMacd ? i_wMacd : 0.0
float wRoc  = _okRoc  ? i_wRoc  : 0.0
float wMfi  = _okMfi  ? i_wMfi  : 0.0

float _wSum = wRsi + wSto + wCci + wMacd + wRoc + wMfi
float _sSum = wRsi * nRsi + wSto * nSto + wCci * nCci + wMacd * nMacd + wRoc * nRoc + wMfi * nMfi
float _raw  = _wSum > 0.0 ? _sSum / _wSum : na
float _smSma = ta.sma(_raw, i_smLen)
float _smEma = ta.ema(_raw, i_smLen)
float _smRma = ta.rma(_raw, i_smLen)
float _smWma = ta.wma(_raw, i_smLen)
float _smHma = ta.hma(_raw, i_smLen)
float _blend = na(_raw) ? na : i_smMode == "SMA" ? _smSma : i_smMode == "EMA" ? _smEma : i_smMode == "RMA" ? _smRma : i_smMode == "WMA" ? _smWma : i_smMode == "HMA" ? _smHma : _raw
float _scoreEma = ta.ema(_blend, i_smooth)
float score = na(_blend) ? na : _scoreEma
float _sigEma = ta.ema(score, i_sigLen)
float signalLine = na(score) ? na : _sigEma

int   _dir   = na(score) or na(signalLine) ? na : score > signalLine ? 1 : score < signalLine ? -1 : 0
float _agrW  = f_agr(nRsi, wRsi, _dir) + f_agr(nSto, wSto, _dir) + f_agr(nCci, wCci, _dir) + f_agr(nMacd, wMacd, _dir) + f_agr(nRoc, wRoc, _dir) + f_agr(nMfi, wMfi, _dir)
float agree  = na(_dir) or _wSum <= 0.0 ? na : _dir != 0 ? _agrW / _wSum * 100.0 : 0.0
int   _active = (_okRsi ? 1 : 0) + (_okSto ? 1 : 0) + (_okCci ? 1 : 0) + (_okMacd ? 1 : 0) + (_okRoc ? 1 : 0) + (_okMfi ? 1 : 0)

float _slopeRaw = ta.change(score, i_slopeLen)
float _slope = nz(_slopeRaw)

bool _agrOk     = not na(agree) and agree >= i_minAgree
bool _xUp       = ta.crossover(score, signalLine)
bool _xDn       = ta.crossunder(score, signalLine)
bool _defNow    = not na(score) and not na(signalLine)
bool _defPrev   = not na(score[1]) and not na(signalLine[1])
bool _rawBull   = _xUp and _defNow and _defPrev
bool _rawBear   = _xDn and _defNow and _defPrev
int  _biasS     = na(score) ? na : score >= i_thrBull ? 1 : score <= i_thrBear ? -1 : 0
int  _htfSec    = timeframe.in_seconds(i_htfTf)
int  _chartSec  = timeframe.in_seconds()
bool _htfSame   = _htfSec == _chartSec
bool _htfSkip   = i_htfOn and _htfSec < _chartSec
int  _htfReq    = i_htfOn and _std and not _htfSame and not _htfSkip ? request.security(syminfo.tickerid, i_htfTf, _biasS[1], lookahead = barmerge.lookahead_on) : na
int  _htfSt     = _htfSame ? _biasS : _htfReq
bool _htfBullOk = not i_htfOn or _htfSkip or _htfSt == 1
bool _htfBearOk = not i_htfOn or _htfSkip or _htfSt == -1
bool _adxOk     = not i_adxOn or (not na(_adx) and _adx >= i_adxThr)
bool bullSignal = _std and _rawBull and _agrOk and (not i_reqSlope or _slope > 0.0) and _htfBullOk and _adxOk
bool bearSignal = _std and _rawBear and _agrOk and (not i_reqSlope or _slope < 0.0) and _htfBearOk and _adxOk

bool _fireBull = bullSignal and barstate.isconfirmed
bool _fireBear = bearSignal and barstate.isconfirmed

float _atr      = ta.atr(i_atrLen)
float _rLo      = math.min(i_tp1R, math.min(i_tp2R, i_tp3R))
float _rHi      = math.max(i_tp1R, math.max(i_tp2R, i_tp3R))
float _rMid     = math.max(math.min(i_tp1R, i_tp2R), math.min(math.max(i_tp1R, i_tp2R), i_tp3R))
bool  _tpReord  = not (i_tp1R <= i_tp2R and i_tp2R <= i_tp3R)
float _entryPx  = close
float _riskDist = _atr * i_slMult
float _slL      = _entryPx - _riskDist
float _tp1L     = _entryPx + _riskDist * _rLo
float _tp2L     = _entryPx + _riskDist * _rMid
float _tp3L     = _entryPx + _riskDist * _rHi
float _slS      = _entryPx + _riskDist
float _tp1S     = _entryPx - _riskDist * _rLo
float _tp2S     = _entryPx - _riskDist * _rMid
float _tp3S     = _entryPx - _riskDist * _rHi
bool  _okL      = _riskDist > syminfo.mintick and _slL > 0.0
bool  _okS      = _riskDist > syminfo.mintick and _tp3S > 0.0
bool  _regBull  = _fireBull and _okL
bool  _regBear  = _fireBear and _okS

var int    tradeDir = 0
var float  tEntry   = na
var float  tSl      = na
var float  tTp1     = na
var float  tTp2     = na
var float  tTp3     = na
var int    sigBar   = int(na)
var int    closeBar = int(na)
var bool   tp1Hit   = false
var bool   tp2Hit   = false
var bool   tp3Hit   = false
var bool   slHit    = false
var int    ld1      = 1
var int    ld2      = 2
var int    ld3      = 3
var string namesE   = "Entry"
var string names1   = "TP1"
var string names2   = "TP2"
var string names3   = "TP3"
var line   slLine    = na
var line   entryLine = na
var line   tp1Line   = na
var line   tp2Line   = na
var line   tp3Line   = na
var label  slLbl     = na
var label  entryLbl  = na
var label  tp1Lbl    = na
var label  tp2Lbl    = na
var label  tp3Lbl    = na

f_pctTxt(float lvl, float entry, bool isLong) =>
    float _p = (isLong ? lvl - entry : entry - lvl) / entry * 100.0
    (_p >= 0.0 ? "+" : "") + str.tostring(_p, "0.00") + "%"

f_deleteLevels() =>
    line.delete(slLine)
    line.delete(entryLine)
    line.delete(tp1Line)
    line.delete(tp2Line)
    line.delete(tp3Line)
    label.delete(slLbl)
    label.delete(entryLbl)
    label.delete(tp1Lbl)
    label.delete(tp2Lbl)
    label.delete(tp3Lbl)

f_ldLbl(int ld) =>
    ld == 0 ? entryLbl : ld == 1 ? tp1Lbl : ld == 2 ? tp2Lbl : tp3Lbl

f_ldNames(int ld) =>
    ld == 0 ? namesE : ld == 1 ? names1 : ld == 2 ? names2 : names3

bool _isLongT  = tradeDir == 1
bool _liveT    = tradeDir != 0 and bar_index > sigBar
bool _tp1Cross = _liveT and (_isLongT ? high >= tTp1 : low <= tTp1)
bool _tp2Cross = _liveT and (_isLongT ? high >= tTp2 : low <= tTp2)
bool _tp3Cross = _liveT and (_isLongT ? high >= tTp3 : low <= tTp3)
bool _slCross  = _liveT and barstate.isconfirmed and (_isLongT ? close < tSl : close > tSl)
bool tp1New = false
bool tp2New = false
bool tp3New = false
bool slNew  = false
if _tp1Cross and not tp1Hit and not slHit
    tp1Hit := true
    tp1New := true
if _tp2Cross and not tp2Hit and not slHit
    tp2Hit := true
    tp2New := true
if _tp3Cross and not tp3Hit and not slHit
    tp3Hit := true
    tp3New := true
if _slCross and not slHit and not tp3Hit
    slHit := true
    slNew := true
if tp1New and not na(f_ldLbl(ld1))
    label.set_text(f_ldLbl(ld1), f_ldNames(ld1) + " ✓ HIT " + f_pctTxt(tTp1, tEntry, _isLongT))
if tp2New and not na(f_ldLbl(ld2))
    label.set_text(f_ldLbl(ld2), f_ldNames(ld2) + " ✓ HIT " + f_pctTxt(tTp2, tEntry, _isLongT))
if tp3New and not na(f_ldLbl(ld3))
    label.set_text(f_ldLbl(ld3), f_ldNames(ld3) + " ✓ HIT " + f_pctTxt(tTp3, tEntry, _isLongT))
if slNew and not na(slLbl)
    label.set_text(slLbl, "SL ✓ HIT " + f_pctTxt(close, tEntry, _isLongT))

int   pDir = tradeDir
float pSl  = tSl
float pTp1 = tTp1
float pTp2 = tTp2
float pTp3 = tTp3
bool _locked = i_lockSignal and barstate.islast
bool _blkBull = (slNew or tp3New) and pDir == 1
bool _blkBear = (slNew or tp3New) and pDir == -1
bool evBull  = _regBull and not _blkBull and not _locked
bool evBear  = _regBear and not _blkBear and not _locked
bool evNew   = evBull or evBear
bool openNow = tradeDir != 0 and not slHit and not tp3Hit
bool closeOld = evNew and openNow
bool sameDir  = (evBull and tradeDir == 1) or (evBear and tradeDir == -1)
if evNew
    f_deleteLevels()
    slLine    := na
    entryLine := na
    tp1Line   := na
    tp2Line   := na
    tp3Line   := na
    slLbl     := na
    entryLbl  := na
    tp1Lbl    := na
    tp2Lbl    := na
    tp3Lbl    := na
    tradeDir := evBull ? 1 : -1
    tEntry   := _entryPx
    tSl      := evBull ? _slL : _slS
    tTp1     := evBull ? _tp1L : _tp1S
    tTp2     := evBull ? _tp2L : _tp2S
    tTp3     := evBull ? _tp3L : _tp3S
    sigBar   := bar_index
    closeBar := int(na)
    tp1Hit   := false
    tp2Hit   := false
    tp3Hit   := false
    slHit    := false
    string kE  = str.tostring(_entryPx, format.mintick)
    string kT1 = str.tostring(tTp1, format.mintick)
    string kT2 = str.tostring(tTp2, format.mintick)
    string kT3 = str.tostring(tTp3, format.mintick)
    bool m1  = kT1 == kE
    bool m2e = kT2 == kE
    bool m2a = not m2e and kT2 == kT1
    bool m3e = kT3 == kE
    bool m3a = not m3e and kT3 == kT1
    bool m3b = not m3e and not m3a and kT3 == kT2
    ld1 := m1 ? 0 : 1
    ld2 := m2e ? 0 : m2a ? 1 : 2
    ld3 := m3e ? 0 : m3a ? 1 : m3b ? 2 : 3
    namesE := "Entry" + (m1 ? " / TP1" : "") + (m2e ? " / TP2" : "") + (m3e ? " / TP3" : "")
    names1 := "TP1" + (m2a ? " / TP2" : "") + (m3a ? " / TP3" : "")
    names2 := "TP2" + (m3b ? " / TP3" : "")
    names3 := "TP3"
    if i_showLevels
        slLine    := line.new(bar_index, tSl,     bar_index, tSl,     color = C_SL,    style = line.style_solid,  width = 2, force_overlay = true)
        entryLine := line.new(bar_index, _entryPx, bar_index, _entryPx, color = C_ENTRY, style = line.style_dashed, width = 1, force_overlay = true)
        tp1Line   := line.new(bar_index, tTp1,    bar_index, tTp1,    color = C_TP1,   style = line.style_dashed, width = 1, force_overlay = true)
        tp2Line   := line.new(bar_index, tTp2,    bar_index, tTp2,    color = C_TP2,   style = line.style_dashed, width = 1, force_overlay = true)
        tp3Line   := line.new(bar_index, tTp3,    bar_index, tTp3,    color = C_TP3,   style = line.style_dashed, width = 1, force_overlay = true)
        slLbl     := label.new(bar_index, tSl, "✕ SL " + str.tostring(tSl, format.mintick), style = label.style_label_left, color = color.new(C_SL, 0), textcolor = C_LBL_TXT, size = size.small, force_overlay = true)
        entryLbl  := label.new(bar_index, _entryPx, "▶ " + namesE + " " + kE, style = label.style_label_left, color = color.new(C_ENTRY, 0), textcolor = C_LBL_TXT, size = size.small, force_overlay = true)
        if not m1
            tp1Lbl := label.new(bar_index, tTp1, "◆ " + names1 + " " + kT1, style = label.style_label_left, color = color.new(C_TP1, 0), textcolor = C_LBL_TXT, size = size.small, force_overlay = true)
        if not m2e and not m2a
            tp2Lbl := label.new(bar_index, tTp2, "✦ " + names2 + " " + kT2, style = label.style_label_left, color = color.new(C_TP2, 0), textcolor = C_LBL_TXT, size = size.small, force_overlay = true)
        if not m3e and not m3a and not m3b
            tp3Lbl := label.new(bar_index, tTp3, "◆ " + names3 + " " + kT3, style = label.style_label_left, color = color.new(C_TP3, 0), textcolor = C_LBL_TXT, size = size.small, force_overlay = true)

bool _tradeClosed = slHit or tp3Hit
if tradeDir != 0 and _tradeClosed and na(closeBar)
    closeBar := bar_index
bool _extUpdate = _tradeClosed ? closeBar == bar_index : barstate.islast
if not na(slLine) and _extUpdate
    int _extX = _tradeClosed ? closeBar + 10 : last_bar_index + 10
    line.set_x2(slLine, _extX)
    line.set_x2(entryLine, _extX)
    line.set_x2(tp1Line, _extX)
    line.set_x2(tp2Line, _extX)
    line.set_x2(tp3Line, _extX)
    label.set_x(slLbl, _extX)
    label.set_x(entryLbl, _extX)
    if not na(tp1Lbl)
        label.set_x(tp1Lbl, _extX)
    if not na(tp2Lbl)
        label.set_x(tp2Lbl, _extX)
    if not na(tp3Lbl)
        label.set_x(tp3Lbl, _extX)

var int _lastDir = 0
if evBull
    _lastDir := 1
if evBear
    _lastDir := -1

// ── ALERTS ──────────────────────────────────────────────────────
f_esc(string s) =>
    str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\"")

f_ctx() =>
    string _sc = na(score) ? "null" : str.format('"{0}"', str.tostring(score, "#.00"))
    string _ag = na(agree) ? "null" : str.format('"{0}"', str.tostring(agree, "#.0"))
    str.format('"score":{0},"agreement":{1},"components":"{2}"', _sc, _ag, str.tostring(_active))

f_entryPayload(string act, string dir, float sl, float t1, float t2, float t3) =>
    string _tm = na(time_close) ? "null" : str.format('"{0}"', str.tostring(time_close))
    string _in = str.format('"action":"{0}","ticker":"{1}","tf":"{2}","direction":"{3}","entry":"{4}","sl":"{5}","tp1":"{6}","tp2":"{7}","tp3":"{8}","time":{9},{10}', f_esc(act), f_esc(syminfo.tickerid), f_esc(timeframe.period), dir, str.tostring(close, format.mintick), str.tostring(sl, format.mintick), str.tostring(t1, format.mintick), str.tostring(t2, format.mintick), str.tostring(t3, format.mintick), _tm, f_ctx())
    "{" + _in + "}"

f_partialPayload(string act, string dir, int n, float px, float sl) =>
    string _in = str.format('"action":"{0}","ticker":"{1}","tf":"{2}","direction":"{3}","tp":"{4}","price":"{5}","sl":"{6}"', f_esc(act), f_esc(syminfo.tickerid), f_esc(timeframe.period), dir, str.tostring(n), str.tostring(px, format.mintick), str.tostring(sl, format.mintick))
    "{" + _in + "}"

f_closePayload(string act, string dir, string reason, float px) =>
    string _in = str.format('"action":"{0}","ticker":"{1}","tf":"{2}","direction":"{3}","reason":"{4}","price":"{5}"', f_esc(act), f_esc(syminfo.tickerid), f_esc(timeframe.period), dir, reason, str.tostring(px, format.mintick))
    "{" + _in + "}"

string pSide  = pDir == 1 ? "long" : "short"
string pClose = pDir == 1 ? i_actionCloseLong : i_actionCloseShort
string pPart  = pDir == 1 ? i_actionPartLong : i_actionPartShort
bool evPartLong   = pDir == 1 and (tp1New or tp2New)
bool evPartShort  = pDir == -1 and (tp1New or tp2New)
bool evCloseLong  = pDir == 1 and (closeOld or tp3New or slNew)
bool evCloseShort = pDir == -1 and (closeOld or tp3New or slNew)

if tp1New
    alert(f_partialPayload(pPart, pSide, 1, pTp1, pSl), alert.freq_once_per_bar)
if tp2New
    alert(f_partialPayload(pPart, pSide, 2, pTp2, pSl), alert.freq_once_per_bar)
if tp3New
    alert(f_closePayload(pClose, pSide, "target", pTp3), alert.freq_once_per_bar)
if slNew and barstate.isconfirmed
    alert(f_closePayload(pClose, pSide, "stop", close), alert.freq_once_per_bar_close)
if closeOld and barstate.isconfirmed
    alert(f_closePayload(pClose, pSide, sameDir ? "replaced" : "reverse", close), alert.freq_once_per_bar_close)
if evBull and barstate.isconfirmed
    alert(f_entryPayload(i_actionLong, "long", _slL, _tp1L, _tp2L, _tp3L), alert.freq_once_per_bar_close)
if evBear and barstate.isconfirmed
    alert(f_entryPayload(i_actionShort, "short", _slS, _tp1S, _tp2S, _tp3S), alert.freq_once_per_bar_close)

alertcondition(evBull and barstate.isconfirmed, "BUY Signal", "MarkitTick — BUY Signal Fired")
alertcondition(evBear and barstate.isconfirmed, "SELL Signal", "MarkitTick — SELL Signal Fired")
alertcondition(evCloseLong, "Close Long Signal", "MarkitTick — Close Long")
alertcondition(evCloseShort, "Close Short Signal", "MarkitTick — Close Short")
alertcondition(evPartLong, "Partial Close Long", "MarkitTick — Partial Close Long")
alertcondition(evPartShort, "Partial Close Short", "MarkitTick — Partial Close Short")
alertcondition(slNew, "SL Hit", "MarkitTick — SL Hit")
alertcondition(tp1New, "TP1 Hit", "MarkitTick — TP1 Hit")
alertcondition(tp2New, "TP2 Hit", "MarkitTick — TP2 Hit")
alertcondition(tp3New, "TP3 Hit", "MarkitTick — TP3 Hit")

// ── VISUALS ─────────────────────────────────────────────────────
color _scoreCol = na(score) ? na : score >= 0 ? color.from_gradient(score, 0, math.max(i_ob, 1), C_NEU, C_SUP) : color.from_gradient(score, math.min(i_os, -1), 0, C_RES, C_NEU)

pOb   = plot(_std ? float(i_ob) : na, "OB Lvl",   color = C_LVL, linewidth = 1, linestyle = plot.linestyle_dotted)
pOs   = plot(_std ? float(i_os) : na, "OS Lvl",   color = C_LVL, linewidth = 1, linestyle = plot.linestyle_dotted)
pTop  = plot(_std ? 100.0 : na,       "Max",      color = C_LVL, linewidth = 1, linestyle = plot.linestyle_solid)
pBot  = plot(_std ? -100.0 : na,      "Min",      color = C_LVL, linewidth = 1, linestyle = plot.linestyle_solid)
plot(_std ? float(i_thrBull) : na,    "Bull Thr", color = C_LVL, linewidth = 1, linestyle = plot.linestyle_dashed)
plot(_std ? float(i_thrBear) : na,    "Bear Thr", color = C_LVL, linewidth = 1, linestyle = plot.linestyle_dashed)
plot(_std ? 0.0 : na,                 "Zero",     color = C_MID, linewidth = 1, linestyle = plot.linestyle_dotted)

fill(pOb, pTop, color = C_ZONE, title = "OB Zone", display = i_showZone ? display.all : display.none)
fill(pOs, pBot, color = C_ZONE, title = "OS Zone", display = i_showZone ? display.all : display.none)

plot(_std ? score : na, "Momentum Score", color = _scoreCol, linewidth = 2)
plot(_std ? signalLine : na, "Signal Line", color = C_SIG, linewidth = 1)
plot(_okRsi  ? nRsi  : na, "RSI Comp",   color = C_RSI,  display = i_showComp ? display.all : display.none)
plot(_okSto  ? nSto  : na, "Stoch Comp", color = C_STO,  display = i_showComp ? display.all : display.none)
plot(_okCci  ? nCci  : na, "CCI Comp",   color = C_CCI,  display = i_showComp ? display.all : display.none)
plot(_okMacd ? nMacd : na, "MACD Comp",  color = C_MACD, display = i_showComp ? display.all : display.none)
plot(_okRoc  ? nRoc  : na, "ROC Comp",   color = C_ROC,  display = i_showComp ? display.all : display.none)
plot(_okMfi  ? nMfi  : na, "MFI Comp",   color = C_MFI,  display = i_showComp ? display.all : display.none)

if i_showMark and evBull
    label.new(bar_index, score, "BULL", style = label.style_label_up, color = C_SUP, textcolor = C_MRK_TXT, size = size.small)
    label.new(bar_index, low, "BULL", yloc = yloc.belowbar, style = label.style_label_up, color = C_SUP, textcolor = C_MRK_TXT, size = size.small, force_overlay = true)
if i_showMark and evBear
    label.new(bar_index, score, "BEAR", style = label.style_label_down, color = C_RES, textcolor = C_MRK_TXT, size = size.small)
    label.new(bar_index, high, "BEAR", yloc = yloc.abovebar, style = label.style_label_down, color = C_RES, textcolor = C_MRK_TXT, size = size.small, force_overlay = true)

color bodyColor   = _std and i_showCdl ? _scoreCol : na
color borderColor = bodyColor

plotcandle(open, high, low, close, title = "Heatmap Candles", color = bodyColor, wickcolor = borderColor, bordercolor = borderColor, force_overlay = true)


// ── DASHBOARD ───────────────────────────────────────────────────
f_tf() =>
    int _m = timeframe.multiplier
    string _r = timeframe.period
    if timeframe.isseconds
        _r := str.tostring(_m) + "s"
    else if timeframe.isticks
        _r := str.tostring(_m) + "t"
    else if timeframe.isminutes
        _r := _m % 60 == 0 ? str.tostring(int(_m / 60)) + "H" : str.tostring(_m) + "m"
    else if timeframe.isdaily
        _r := str.tostring(_m) + "D"
    else if timeframe.isweekly
        _r := str.tostring(_m) + "W"
    else if timeframe.ismonthly
        _r := str.tostring(_m) + "M"
    _r

f_sgn(float v) =>
    int _n = math.round(v)
    (_n > 0 ? "+" : "") + str.tostring(_n)

f_sgnColor(float v) =>
    int _n = math.round(v)
    _n > 0 ? C_SUP : _n < 0 ? C_RES : C_DASH_TXT

f_tip(string base, string add) =>
    add == "" ? base : base == "" ? add : base + " " + add

f_row(table t, int r, string lbl, string val, color vcol, color bg, string tip) =>
    table.cell(t, 0, r, "  " + lbl, text_color = color.new(C_DASH_TXT, 25), text_halign = text.align_left,  text_size = size.small, bgcolor = bg, tooltip = tip)
    table.cell(t, 1, r, val + "  ", text_color = vcol,                      text_halign = text.align_right, text_size = size.small, bgcolor = bg, tooltip = tip)

_dashPos = i_dashPos == "Top Left" ? position.top_left : i_dashPos == "Bottom Right" ? position.bottom_right : i_dashPos == "Bottom Left" ? position.bottom_left : position.top_right

var table stdNote = table.new(position.middle_center, 1, 2, force_overlay = true)


if barstate.islast and not _std
    table.cell(stdNote, 0, 0, "This indicator runs only on standard charts.", text_color = #FF0000, text_size = size.large, bgcolor = #2A2E39, text_formatting = text.format_bold)
    table.cell(stdNote, 0, 1, "Heikin Ashi, Renko, Kagi, Point & Figure, Range and Line Break\nshow synthetic prices. Switch to Candles.", text_color = #FF0000, text_size = size.normal, bgcolor = #2A2E39, text_formatting = text.format_bold)

// ════════════════════════════════════════════════════════════════
// YOUNGYUU ADD-ON — trade simulator, money simulator, YY dashboard
// (signals, SL / TP and hit rules above are the original MCE engine)
// ════════════════════════════════════════════════════════════════
const string GRP_YYD = "🖥️ YY Dashboard"
const string GRP_YYM = "💰 Money Simulator"
i_device      = input.string("PC", "Layout", options = ["PC", "iPad", "Mobile"], group = GRP_YYD, tooltip = "PC: full panel · iPad: small font · Mobile: core rows, tiny font")
i_dashFont    = input.string("Small", "PC Font Size", options = ["Tiny", "Small", "Normal", "Large"], group = GRP_YYD)
i_yyPos       = input.string("Top Right", "YY Panel Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Middle Right"], group = GRP_YYD)
moneyOnInput  = input.bool(true, "เปิดโหมดจำลองเงินทุน", group = GRP_YYM, tooltip = "เล่นตามทุกสัญญาณบนประวัติกราฟที่โหลดอยู่ · ปิด 1/3 ที่ TP1/TP2/TP3 · ⚠ จำลอง ไม่ใช่ผลจริง")
capitalInput  = input.float(300.0, "เงินทุน (USD)", minval = 1.0, step = 10.0, group = GRP_YYM)
sizeModeInput = input.string("Risk %", "ขนาดไม้", options = ["Risk %", "Fixed Lot"], group = GRP_YYM)
riskPctInput  = input.float(1.0, "Risk % ต่อไม้", minval = 0.1, maxval = 20.0, step = 0.1, group = GRP_YYM)
fixLotInput   = input.float(0.01, "Fixed Lot", minval = 0.01, step = 0.01, group = GRP_YYM)
compoundInput = input.bool(true, "ทบต้น", group = GRP_YYM)
contractInput = input.float(100.0, "Contract Size (oz / lot)", minval = 1.0, group = GRP_YYM)
minLotInput   = input.float(0.01, "Min Lot", minval = 0.001, step = 0.01, group = GRP_YYM)
lotStepInput  = input.float(0.01, "Lot Step", minval = 0.001, step = 0.01, group = GRP_YYM)
commLotInput  = input.float(7.0, "ค่าคอม $/lot (ไป-กลับ)", minval = 0.0, step = 0.5, group = GRP_YYM)
spreadPxInput = input.float(0.20, "Spread (ราคา $)", minval = 0.0, step = 0.05, group = GRP_YYM)

const int FORM_LEN = 10
const string YY_VERSION = "v1.0"

// ── palette (dark)
TEXT_COLOR   = #E6E9F2
TEXT_MUTED   = #8A93B2
TABLE_BG     = #0B0F1C
ROW_ALT      = #121829
TABLE_BORDER = #232B45
HEADER_BULL  = #0F6E56
HEADER_BEAR  = #A32D2D
HEADER_NEU   = #2F3654
HEADER_TEXT  = #FFFFFF
BULL_TEXT    = #00E58F
BEAR_TEXT    = #FF4D6D
NEU_TEXT     = #FFC107
SL_COLOR     = #E57373
TP_LBL_COLOR = #66BB6A
TP_HIT_COLOR = #4DB6AC
FORM_COLOR   = #5C8AAE

fmtR(float r) =>
    (r >= 0 ? "+" : "") + str.tostring(r, "0.00") + "R"

fmtUsdS(float v) =>
    (v >= 0 ? "+$" : "-$") + str.tostring(math.abs(v), "0.00")

fmtUsd(float v) =>
    (v < 0 ? "-$" : "$") + str.tostring(math.abs(v), "0.00")

fmtPctS(float v) =>
    (v >= 0 ? "+" : "") + str.tostring(v, "0.0") + "%"

sizeFromString(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Normal" ? size.normal : s == "Large" ? size.large : size.small

sizeDown(string s) =>
    s == "Large" ? size.normal : s == "Normal" ? size.small : size.tiny

type Trade
    int    dir      = 0
    float  entry    = na
    float  sl       = na
    float  tp1      = na
    float  tp2      = na
    float  tp3      = na
    float  risk     = na
    int    entryBar = na
    int    closeBar = na
    bool   tp1Hit   = false
    bool   tp2Hit   = false
    bool   tp3Hit   = false
    bool   be       = false
    string src      = ""
    float  lot      = 0.0
    float  realized = 0.0
    float  rAcc     = 0.0
    float  rem      = 1.0

type Stats
    int    closed   = 0
    int    replaced = 0
    int    tp1Cnt   = 0
    int    tp2Cnt   = 0
    int    tp3Cnt   = 0
    int    slCnt    = 0
    float  rSum     = 0.0
    string form     = ""
    string lastExit = ""
    int    wins     = 0
    int    losses   = 0
    int    bes      = 0
    float  lastR    = 0.0

type Money
    float equity  = 0.0
    float peak    = 0.0
    float maxDD   = 0.0
    int   wins    = 0
    int   losses  = 0
    float lastPnl = 0.0
    float best    = 0.0
    float worst   = 0.0
    bool  bust    = false

realize(Trade t, float frac, float px) =>
    float f = math.min(frac, t.rem)
    if f > 0 and not na(t.risk) and t.risk > 0
        t.rAcc     := t.rAcc + f * (px - t.entry) * t.dir / t.risk
        t.realized := t.realized + f * (px - t.entry) * t.dir * contractInput * t.lot
        t.rem      := t.rem - f
    f

tradeCost(float lot) =>
    (commLotInput + spreadPxInput * contractInput) * lot

pushForm(Stats s, bool ok) =>
    s.form := s.form + (ok ? "▰" : "▱")
    if str.length(s.form) > FORM_LEN
        s.form := str.substring(s.form, str.length(s.form) - FORM_LEN)

finalizeTrade(Trade t, Stats s, Money m, string how) =>
    s.closed := s.closed + 1
    s.tp1Cnt := s.tp1Cnt + (t.tp1Hit ? 1 : 0)
    s.tp2Cnt := s.tp2Cnt + (t.tp2Hit ? 1 : 0)
    if how == "TP3"
        s.tp3Cnt := s.tp3Cnt + 1
    if how == "SL" or how == "BE"
        s.slCnt := s.slCnt + 1
    if how == "REPL"
        s.replaced := s.replaced + 1
    s.rSum     := s.rSum + t.rAcc
    s.lastR    := t.rAcc
    s.lastExit := how
    if t.rAcc > 0.0001
        s.wins := s.wins + 1
    else if t.rAcc < -0.0001
        s.losses := s.losses + 1
    else
        s.bes := s.bes + 1
    pushForm(s, t.tp1Hit)
    float net = t.realized - tradeCost(t.lot)
    if not m.bust
        m.equity  := m.equity + net
        m.lastPnl := net
        if net >= 0
            m.wins := m.wins + 1
        else
            m.losses := m.losses + 1
        m.best  := math.max(m.best, net)
        m.worst := math.min(m.worst, net)
        m.peak  := math.max(m.peak, m.equity)
        float dd = m.peak > 0 ? (m.peak - m.equity) / m.peak * 100.0 : 0.0
        m.maxDD := math.max(m.maxDD, dd)
        if m.equity <= 0
            m.bust := true
    t.dir      := 0
    t.closeBar := bar_index
    net

calcLot(float riskPx, float eq) =>
    float raw = sizeModeInput == "Fixed Lot" ? fixLotInput : (eq * riskPctInput / 100.0) / math.max(riskPx * contractInput, 1e-10)
    float stepped = math.floor(raw / lotStepInput) * lotStepInput
    math.max(minLotInput, stepped)

openTrade(Trade t, int d, float px, float sl, float rd, float tp1, float tp2, float tp3, float lot, string src) =>
    t.dir      := d
    t.entry    := px
    t.sl       := sl
    t.risk     := rd
    t.tp1      := tp1
    t.tp2      := tp2
    t.tp3      := tp3
    t.entryBar := bar_index
    t.closeBar := na
    t.tp1Hit   := false
    t.tp2Hit   := false
    t.tp3Hit   := false
    t.be       := false
    t.src      := src
    t.lot      := lot
    t.realized := 0.0
    t.rAcc     := 0.0
    t.rem      := 1.0

var Trade T = Trade.new()
var Stats S = Stats.new()
var Money M = Money.new(equity = capitalInput, peak = capitalInput)
var int   firstTradeTime = na
var float riskActSum  = 0.0
var int   riskActN    = 0
var float riskActLast = 0.0

// ── book the running trade with MCE's own hit events (TP on touch, SL on close)
if T.dir != 0
    if tp1New and not T.tp1Hit
        T.tp1Hit := true
        realize(T, 1.0 / 3.0, pTp1)
    if tp2New and not T.tp2Hit
        T.tp2Hit := true
        realize(T, 1.0 / 3.0, pTp2)
    if tp3New
        T.tp3Hit := true
        realize(T, T.rem, pTp3)
        finalizeTrade(T, S, M, "TP3")
    else if slNew
        realize(T, T.rem, close)
        finalizeTrade(T, S, M, "SL")
    else if closeOld
        realize(T, T.rem, close)
        finalizeTrade(T, S, M, "REPL")

// ── open a simulated trade on every MCE entry
if evNew
    if T.dir != 0
        realize(T, T.rem, close)
        finalizeTrade(T, S, M, "REPL")
    float eqB  = compoundInput ? M.equity : capitalInput
    float lot0 = M.bust ? 0.0 : calcLot(_riskDist, eqB)
    openTrade(T, tradeDir, tEntry, tSl, _riskDist, tTp1, tTp2, tTp3, lot0, "MCE")
    if lot0 > 0 and M.equity > 0
        riskActLast := (_riskDist * contractInput * lot0 + tradeCost(lot0)) / M.equity * 100.0
        riskActSum  += riskActLast
        riskActN    += 1
    if na(firstTradeTime)
        firstTradeTime := time

// ── row buffers: 0 key/value · 1 section · 2 full-width text · 3 header
var string[] dK  = array.new_string()
var string[] dV  = array.new_string()
var color[]  dKC = array.new_color()
var color[]  dVC = array.new_color()
var color[]  dBG = array.new_color()
var int[]    dT  = array.new_int()

rowKV(string k, string v, color vc) =>
    array.push(dK, k)
    array.push(dV, v)
    array.push(dKC, TEXT_MUTED)
    array.push(dVC, vc)
    array.push(dBG, TABLE_BG)
    array.push(dT, 0)

rowSec(string t) =>
    array.push(dK, t)
    array.push(dV, "")
    array.push(dKC, TEXT_MUTED)
    array.push(dVC, TEXT_MUTED)
    array.push(dBG, ROW_ALT)
    array.push(dT, 1)

rowFull(string t, color c, color bg) =>
    array.push(dK, t)
    array.push(dV, "")
    array.push(dKC, c)
    array.push(dVC, c)
    array.push(dBG, bg)
    array.push(dT, 2)

rowHead(string t, color bg) =>
    array.push(dK, t)
    array.push(dV, "")
    array.push(dKC, HEADER_TEXT)
    array.push(dVC, HEADER_TEXT)
    array.push(dBG, bg)
    array.push(dT, 3)

gauge(float pct, int width) =>
    int filled = math.round(math.max(0.0, math.min(100.0, pct)) / 100.0 * width)
    str.repeat("■", filled) + str.repeat("□", width - filled)

sgnCol(float v) =>
    v > 0 ? BULL_TEXT : v < 0 ? BEAR_TEXT : TEXT_COLOR

var table yyDash = na

yyPos = switch i_yyPos
    "Top Left"     => position.top_left
    "Bottom Right" => position.bottom_right
    "Bottom Left"  => position.bottom_left
    "Middle Right" => position.middle_right
    =>                position.top_right

if barstate.islast and i_showDash and _std
    array.clear(dK)
    array.clear(dV)
    array.clear(dKC)
    array.clear(dVC)
    array.clear(dBG)
    array.clear(dT)
    bool isPC  = i_device == "PC"
    bool isMob = i_device == "Mobile"
    string fStr = isPC ? i_dashFont : isMob ? "Tiny" : "Small"
    fsz    = sizeFromString(fStr)
    fszSub = sizeDown(fStr)

    // ── values
    bool   inTrade  = T.dir != 0
    int    bias     = nz(_biasS)
    string headTx   = "◆ MCE · " + (inTrade ? (T.dir == 1 ? "Long" : "Short") : "Flat") + (i_lockSignal ? " · LOCK" : "")
    color  headBg   = inTrade ? (T.dir == 1 ? HEADER_BULL : HEADER_BEAR) : HEADER_NEU
    float  liveR    = inTrade and T.risk > 0 ? T.rAcc + T.rem * (close - T.entry) * T.dir / T.risk : S.lastR
    float  slPct    = inTrade and T.entry != 0 and T.risk > 0 ? T.risk / T.entry * 100.0 : 0.0
    float  floatP   = inTrade ? T.realized + T.rem * (close - T.entry) * T.dir * contractInput * T.lot - tradeCost(T.lot) : 0.0
    float  riskUsd  = inTrade ? T.risk * contractInput * T.lot + tradeCost(T.lot) : 0.0
    float  fullUsd  = inTrade ? ((T.tp1 - T.entry) + (T.tp2 - T.entry) + (T.tp3 - T.entry)) * T.dir / 3.0 * contractInput * T.lot - tradeCost(T.lot) : 0.0
    int    decided  = S.wins + S.losses
    float  wrPct    = decided > 0 ? 100.0 * S.wins / decided : 0.0
    float  avgR     = S.closed > 0 ? S.rSum / S.closed : 0.0
    float  calDays  = na(firstTradeTime) ? 0.0 : (time - firstTradeTime) / 86400000.0
    float  trDays   = math.max(1.0, calDays * 5.0 / 7.0)
    string periodTx = na(firstTradeTime) ? "—" : str.format_time(firstTradeTime, "dd MMM", syminfo.timezone) + " → " + str.format_time(time, "dd MMM", syminfo.timezone) + " · " + str.tostring(trDays, "0") + " วันเทรด"
    float  netAll   = M.equity - capitalInput
    float  netPct   = capitalInput > 0 ? netAll / capitalInput * 100.0 : 0.0
    float  perDay   = netAll / trDays
    float  perMonth = perDay * 21.0
    bool   isOb     = not na(score) and score >= i_ob
    bool   isOs     = not na(score) and score <= i_os

    // status message (Thai)
    string msg = ""
    color  msgCol = TEXT_MUTED
    if inTrade
        msg := T.tp2Hit ? "TP2 ✓ ปล่อยวิ่งหา TP3" : T.tp1Hit ? "TP1 ✓ ล็อกกำไรบางส่วนแล้ว" : "รอ TP1 " + str.tostring(T.tp1, format.mintick)
        msgCol := T.dir == 1 ? BULL_TEXT : BEAR_TEXT
    else if S.lastExit == "SL"
        msg := "โดน SL " + fmtR(S.lastR) + " · อย่ารีบเอาคืน รอสัญญาณใหม่"
        msgCol := BEAR_TEXT
    else if S.lastExit == "TP3"
        msg := "ปิดครบ TP3 " + fmtR(S.lastR) + " · พักก่อนได้"
        msgCol := BULL_TEXT
    else
        msg := isOb ? "Score อยู่โซน Overbought · ระวังกลับตัว" : isOs ? "Score อยู่โซน Oversold · ระวังกลับตัว" : "รอสัญญาณ"
        msgCol := isOb or isOs ? NEU_TEXT : TEXT_MUTED

    // ── build rows
    rowHead(headTx, headBg)
    rowFull(msg, msgCol, TABLE_BG)

    rowSec("— Market —")
    rowKV("Bias", bias > 0 ? "BULL" : bias < 0 ? "BEAR" : "NEUTRAL", bias > 0 ? BULL_TEXT : bias < 0 ? BEAR_TEXT : NEU_TEXT)
    rowKV("Score", na(score) ? "—" : f_sgn(score) + (isOb ? " · OB" : isOs ? " · OS" : ""), na(score) ? TEXT_COLOR : sgnCol(score))
    if not isMob
        rowKV("Agreement", na(agree) ? "—" : str.tostring(math.round(agree)) + "%" + (_agrOk ? " ✓" : " ✕"), na(agree) ? TEXT_COLOR : _agrOk ? BULL_TEXT : BEAR_TEXT)
        rowKV("Slope", na(_slopeRaw) ? "—" : _slopeRaw > 0.0 ? "RISING" : _slopeRaw < 0.0 ? "FALLING" : "FLAT", na(_slopeRaw) ? TEXT_COLOR : sgnCol(_slopeRaw))
        if i_htfOn
            rowKV("Higher TF", _htfSkip ? "SKIPPED" : na(_htfSt) ? "—" : _htfSt > 0 ? "BULL" : _htfSt < 0 ? "BEAR" : "NEUTRAL", _htfSkip or na(_htfSt) ? TEXT_COLOR : sgnCol(_htfSt))
        if i_adxOn
            rowKV("ADX", na(_adx) ? "—" : str.tostring(_adx, "0.0") + " / " + str.tostring(i_adxThr, "0"), na(_adx) ? TEXT_COLOR : _adx >= i_adxThr ? BULL_TEXT : BEAR_TEXT)
    if isPC
        rowKV("RSI · Sto · CCI", (_okRsi ? f_sgn(nRsi) : "—") + " · " + (_okSto ? f_sgn(nSto) : "—") + " · " + (_okCci ? f_sgn(nCci) : "—"), TEXT_COLOR)
        rowKV("MACD · ROC · MFI", (_okMacd ? f_sgn(nMacd) : "—") + " · " + (_okRoc ? f_sgn(nRoc) : "—") + " · " + (_okMfi ? f_sgn(nMfi) : "—"), TEXT_COLOR)

    rowSec("— Trade —")
    if inTrade
        rowKV("Entry", (T.dir == 1 ? "Long @ " : "Short @ ") + str.tostring(T.entry, format.mintick), T.dir == 1 ? BULL_TEXT : BEAR_TEXT)
        rowKV("SL", str.tostring(T.sl, format.mintick), SL_COLOR)
        rowKV("TP1", (T.tp1Hit ? "✓ " : "") + str.tostring(T.tp1, format.mintick), T.tp1Hit ? TP_HIT_COLOR : TP_LBL_COLOR)
        rowKV("TP2", (T.tp2Hit ? "✓ " : "") + str.tostring(T.tp2, format.mintick), T.tp2Hit ? TP_HIT_COLOR : TP_LBL_COLOR)
        rowKV("TP3", str.tostring(T.tp3, format.mintick), TP_LBL_COLOR)
        rowKV("R:R", fmtR(liveR), liveR >= 0 ? BULL_TEXT : BEAR_TEXT)
        if not isMob
            rowKV("SL Dist", str.tostring(slPct, "0.00") + "% · ATR " + str.tostring(_atr, format.mintick), slPct > 1.0 ? NEU_TEXT : TEXT_COLOR)
    else
        rowKV("Status", "Flat · last " + (_lastDir > 0 ? "LONG" : _lastDir < 0 ? "SHORT" : "—"), TEXT_MUTED)

    rowSec("— Stats · All-Time —")
    if isMob
        rowKV("W / L", str.tostring(S.wins) + " / " + str.tostring(S.losses) + "  (" + str.tostring(math.round(wrPct)) + "%)", wrPct >= 50 ? BULL_TEXT : BEAR_TEXT)
    else
        rowKV("ช่วงเวลา", periodTx, TEXT_COLOR)
        rowKV("Trades", str.tostring(S.closed) + "  (" + str.tostring(S.closed / trDays, "0.0") + " ไม้/วัน)", TEXT_COLOR)
        rowKV("Wins", str.tostring(S.wins), BULL_TEXT)
        rowKV("Losses", str.tostring(S.losses) + (S.bes > 0 ? "  (BE " + str.tostring(S.bes) + ")" : ""), BEAR_TEXT)
        rowKV("Win rate", str.tostring(math.round(wrPct)) + "%  " + gauge(wrPct, 8), wrPct >= 55 ? BULL_TEXT : wrPct >= 45 ? NEU_TEXT : BEAR_TEXT)
        rowKV("Avg R", fmtR(avgR), avgR >= 0 ? BULL_TEXT : BEAR_TEXT)
        rowKV("Form", S.form == "" ? "—" : S.form, FORM_COLOR)

    if moneyOnInput
        rowSec("— 💰 ทุน " + fmtUsd(capitalInput) + " · " + (sizeModeInput == "Fixed Lot" ? str.tostring(fixLotInput, "0.00") + " lot" : str.tostring(riskPctInput, "0.0") + "% risk") + " —")
        rowKV("ยอดเงิน", fmtUsd(M.equity) + (M.bust ? " 💥" : ""), netAll >= 0 ? BULL_TEXT : BEAR_TEXT)
        rowKV("กำไรสุทธิ", fmtUsdS(netAll) + " (" + fmtPctS(netPct) + ")", netAll >= 0 ? BULL_TEXT : BEAR_TEXT)
        if not isMob
            float riskAvg = riskActN > 0 ? riskActSum / riskActN : 0.0
            bool  riskHot = riskAvg > riskPctInput * 2.0 and sizeModeInput == "Risk %"
            rowKV("ความเสี่ยงจริง/ไม้", "เฉลี่ย " + str.tostring(riskAvg, "0.0") + "% · ล่าสุด " + str.tostring(riskActLast, "0.0") + "%", riskHot ? BEAR_TEXT : riskAvg > riskPctInput * 1.3 ? NEU_TEXT : BULL_TEXT)
            if riskHot
                rowFull("⚠ ทุนน้อยเกิน lot ขั้นต่ำ — เสี่ยงจริงเกินที่ตั้ง " + str.tostring(riskAvg / riskPctInput, "0.0") + " เท่า", BEAR_TEXT, TABLE_BG)
            rowKV("เฉลี่ย / วัน", fmtUsdS(perDay) + " (" + fmtPctS(capitalInput > 0 ? perDay / capitalInput * 100.0 : 0.0) + ")", perDay >= 0 ? BULL_TEXT : BEAR_TEXT)
            rowKV("ประมาณ / เดือน", fmtUsdS(perMonth) + " (" + fmtPctS(capitalInput > 0 ? perMonth / capitalInput * 100.0 : 0.0) + ")", perMonth >= 0 ? BULL_TEXT : BEAR_TEXT)
            rowKV("Max DD", "-" + str.tostring(M.maxDD, "0.0") + "%", M.maxDD >= 20 ? BEAR_TEXT : M.maxDD >= 10 ? NEU_TEXT : BULL_TEXT)
            rowKV("ไม้ล่าสุด", (M.wins + M.losses) > 0 ? fmtUsdS(M.lastPnl) : "—", M.lastPnl >= 0 ? BULL_TEXT : BEAR_TEXT)
        if inTrade
            rowKV("ไม้นี้ · ลอย", str.tostring(T.lot, "0.00") + " lot · " + fmtUsdS(floatP), floatP >= 0 ? BULL_TEXT : BEAR_TEXT)
            if not isMob
                rowKV("ถ้า SL / TP3", "-" + fmtUsd(riskUsd) + " / " + fmtUsdS(fullUsd), TEXT_COLOR)

    if not isMob
        rowFull("MCE engine © FXProSystems (MPL-2.0) · YY dashboard " + YY_VERSION, TEXT_MUTED, TABLE_BG)

    // ── render
    int nRows = array.size(dK)
    if not na(yyDash)
        table.delete(yyDash)
    yyDash := i_dashOnPrice ? table.new(yyPos, 2, nRows, bgcolor = TABLE_BG, border_color = TABLE_BORDER, border_width = 1, frame_color = TABLE_BORDER, frame_width = 1, force_overlay = true) : table.new(yyPos, 2, nRows, bgcolor = TABLE_BG, border_color = TABLE_BORDER, border_width = 1, frame_color = TABLE_BORDER, frame_width = 1)
    for i = 0 to nRows - 1
        int tp = array.get(dT, i)
        if tp == 0
            table.cell(yyDash, 0, i, array.get(dK, i), text_color = array.get(dKC, i), bgcolor = TABLE_BG, text_size = fsz, text_halign = text.align_left)
            table.cell(yyDash, 1, i, array.get(dV, i), text_color = array.get(dVC, i), bgcolor = TABLE_BG, text_size = fsz, text_halign = text.align_right)
        else
            table.cell(yyDash, 0, i, array.get(dK, i), text_color = array.get(dKC, i), bgcolor = array.get(dBG, i), text_size = tp == 3 ? fsz : fszSub, text_halign = text.align_center)
            table.merge_cells(yyDash, 0, i, 1, i)
else if barstate.islast and not i_showDash and not na(yyDash)
    table.delete(yyDash)
    yyDash := na

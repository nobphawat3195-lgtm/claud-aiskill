// ── Pulse Cross
signalModeInput = input.string("Chop Shield", "Signal Mode", options = ["Chop Shield", "Filtered", "ADX Only", "Pure Cross"], group = GRP_Pulse, tooltip = "Chop Shield: Pulse signal + sideways filter only (recommended).\nFiltered: Pulse signal + ADX + every confirmation you enabled (+ Chop Shield if ticked).\nADX Only: Pulse signal + ADX ≥ threshold.\nPure Cross: every Pulse signal is a BUY / SELL (no filters, no max-SL skip, no scalp mode).", display = display.none)
emaFastInput  = input.int(9, "Fast Length", minval = 2, maxval = 100, group = GRP_Pulse, display = display.none)
emaSlowInput  = input.int(21, "Slow Length", minval = 3, maxval = 300, group = GRP_Pulse, display = display.none)
